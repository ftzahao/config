; 全局提交身份信息
[user]
	name =
	email =
	useConfigOnly = true

; 在公司仓库目录下额外加载配置
[includeIf "gitdir:~/Developer/company/"]
	path = ~/Developer/company/.gitconfig

; 核心行为与索引性能优化
[core]
	ignorecase = false
	preloadindex = true
	untrackedcache = true
	excludesfile = ~/.gitignore_global
	quotepath = false
	longpaths = true
	autocrlf = input
	trustctime = false
	attributesfile = ~/.attributes_global

; 新仓库默认主分支名
[init]
	defaultBranch = main

; 远端分支或标签删除后自动清理本地引用
[fetch]
	prune = true
	pruneTags = true

; 仅允许快进拉取，避免意外产生 merge commit
[pull]
	ff = only
	rebase = true

; 推送体验优化：自动建立上游、默认当前分支、携带注解标签
[push]
	autoSetupRemote = true
	default = current
	followTags = true

; Rebase 使用体验优化
[rebase]
	autoStash = true
	updateRefs = true
	backend = merge

; 复用历史冲突解决记录
[rerere]
	enabled = true
	autoupdate = true

; 让差异对比更易读、更准确
[diff]
	algorithm = histogram
	colorMoved = default

; 优化仓库维护元数据
[gc]
	writeCommitGraph = true

; 支持时自动启用分列显示
[column]
	ui = auto
[http]
	postBuffer = 655360000
[diff "text"]
	textconv = cat
[mergetool]
	keepBackup = false
[lfs]
	concurrenttransfers = 32
	fetchrecentrefsdays = 0
	pruneoffsetdays = 0
	dialtimeout = 3
	tlstimeout = 3
[lfs "transfer"]
	maxretries = 1
	maxretrydelay = 2
[merge "lfs-text"]
	driver = git lfs merge-driver --ancestor %O --current %A --other %B --marker-size %L --output %A --program 'git merge-file --stdout --marker-size=%%L %%A %%O %%B >%%D'
[safe]
	directory = *
