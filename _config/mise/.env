# ==== Xiaomi MIMO ====
MIMO_MESSAGE_BASE_URL="https://api.xiaomimimo.com/anthropic"
MIMO_CHAT_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_RESPONSE_BASE_URL="https://api.xiaomimimo.com/v1"
MIMO_BASE_URL="${MIMO_CHAT_BASE_URL}"
# MIMO_API_KEY=""

# ==== Nous Portal ====
NOUS_CHAT_BASE_URL="https://inference-api.nousresearch.com/v1"
NOUS_BASE_URL="$NOUS_CHAT_BASE_URL"
# NOUS_API_KEY=""

# ==== Claude Code ====
CLAUDE_CONFIG_DIR="${HOME}/.local/share/claude"
ANTHROPIC_BASE_URL="http://127.0.0.1:1337"
ANTHROPIC_AUTH_TOKEN="000"
# CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY="1"
API_TIMEOUT_MS="600000"
BASH_DEFAULT_TIMEOUT_MS="600000"
BASH_MAX_TIMEOUT_MS="600000"
CLAUDE_API_TIMEOUT="600000"
CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="95"
DISABLE_TELEMETRY="1"
MCP_TIMEOUT="30000"
MCP_TOOL_TIMEOUT="600000"
CLAUDE_CODE_ENABLE_TELEMETRY="0"
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
CLAUDE_CODE_ATTRIBUTION_HEADER="0"
ANTHROPIC_DEFAULT_MODEL="nous/xiaomi/mimo-v2.6-flash[1m]"
ANTHROPIC_DEFAULT_FABLE_MODEL="${ANTHROPIC_DEFAULT_MODEL}"
ANTHROPIC_DEFAULT_OPUS_MODEL="${ANTHROPIC_DEFAULT_MODEL}"
ANTHROPIC_DEFAULT_SONNET_MODEL="${ANTHROPIC_DEFAULT_MODEL}"
ANTHROPIC_DEFAULT_HAIKU_MODEL="${ANTHROPIC_DEFAULT_MODEL}"