# ==== rust ====
RUSTUP_HOME="${HOME}/.local/share/rustup"
CARGO_HOME="${HOME}/.local/share/cargo"

# ==== k9s ====
K9SCONFIG="${HOME}/.config/k9s"

# ==== github ====
# GITHUB_TOKEN=""

# ==== mise ====
MISE_GITHUB_TOKEN="${GITHUB_TOKEN}"
MISE_RUSTUP_HOME="${RUSTUP_HOME}"
MISE_CARGO_HOME="${CARGO_HOME}"

# ==== Homebrew ====
HOMEBREW_GITHUB_API_TOKEN="${GITHUB_TOKEN}"

# ==== deepseek ====
DSH_HOME="${HOME}/.local/share/dsh"

# ==== Copilot ====
COPILOT_HOME="${HOME}/.local/share/copilot"

