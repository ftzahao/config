name "MLX 评估"
bin "mlx_lm.evaluate"
about "使用 lm-evaluation-harness 评估 MLX 模型。"
version "0.31.3"

flag "-h --help" help="显示此帮助信息并退出"

flag "--model <MODEL>" required help="要评估的模型"

flag "--tasks <TASKS>..." required

flag "--output-dir <OUTPUT_DIR>" help="结果文件的输出目录。" default="."

flag "--batch-size <BATCH_SIZE>" help="批大小" default="16"

flag "--num-shots <NUM_SHOTS>" help="示例（few-shot）数量"

flag "--max-tokens <MAX_TOKENS>" help="生成的最大 token 数。设置后优先于任务自身的默认值。"

flag "--limit <LIMIT>" help="限制每个任务的样例数量。"

flag "--seed <SEED>" help="随机种子。" default="123"

flag "--fewshot-as-multiturn" help="是否将 few-shot 示例作为多轮对话而非单条用户消息提供。"

flag "--apply-chat-template" help="是否对提示词应用聊天模板。若模型自带聊天模板则默认为 True，否则为 False。"

flag "--no-apply-chat-template" help="是否对提示词应用聊天模板。若模型自带聊天模板则默认为 True，否则为 False。"

flag "--chat-template-args <CHAT_TEMPLATE_ARGS>" help="分词器 apply_chat_template 的参数 JSON 字符串，例如 '{\"enable_thinking\":false}'" default="{}"

flag "--confirm-run-unsafe-code" help="确认要运行包含不受信任代码的任务。"

flag "--trust-remote-code" help="允许信任分词器的远程代码"

flag "--temp <TEMP>" help="采样温度" default="0.0"

flag "--top-p <TOP_P>" help="采样 top-p" default="1.0"

flag "--top-k <TOP_K>" help="采样 top-k" default="0"
