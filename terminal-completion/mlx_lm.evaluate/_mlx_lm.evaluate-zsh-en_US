#compdef mlx_lm.evaluate
# @generated by usage-cli from mlx_lm.evaluate/usage.kdl
local curcontext="$curcontext"

_mlx_lm_evaluate() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.evaluate." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_evaluate.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX Evaluate"
bin mlx_lm.evaluate
version "0.31.3"
about "Evaluate an MLX model using lm-evaluation-harness."
flag "-h --help" help="show this help message and exit"
flag --model help="Model to evaluate" {
    arg <MODEL>
}
flag --tasks {
    arg <TASKS>… var=#true
}
flag --output-dir help="Output directory for result files." default=. {
    arg <OUTPUT_DIR>
}
flag --batch-size help="Batch size" default="16" {
    arg <BATCH_SIZE>
}
flag --num-shots help="Number of shots" {
    arg <NUM_SHOTS>
}
flag --max-tokens help="Maximum number of tokens to generate. When set, this value takes precedence over task specific defaults." {
    arg <MAX_TOKENS>
}
flag --limit help="Limit the number of examples per task." {
    arg <LIMIT>
}
flag --seed help="Random seed." default="123" {
    arg <SEED>
}
flag --fewshot-as-multiturn help="Whether to provide the fewshot examples as a multiturn conversation or a single user turn."
flag --apply-chat-template help="Specifies whether to apply a chat template to the prompt. If the model has a chat template, this defaults to `True`, otherwise `False`."
flag --no-apply-chat-template help="Specifies whether to apply a chat template to the prompt. If the model has a chat template, this defaults to `True`, otherwise `False`."
flag --chat-template-args help="A JSON formatted string of arguments for the tokenizer's apply_chat_template, e.g. '{\"enable_thinking\":false}'" default="{}" {
    arg <CHAT_TEMPLATE_ARGS>
}
flag --confirm-run-unsafe-code help="Confirm that you want to run tasks that execute untrusted code."
flag --trust-remote-code help="Enable trusting remote code for tokenizer"
flag --temp help="Sampling temperature" default="0.0" {
    arg <TEMP>
}
flag --top-p help="Sampling top-p" default="1.0" {
    arg <TOP_P>
}
flag --top-k help="Sampling top-k" default="0" {
    arg <TOP_K>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_evaluate" ]; then
    _mlx_lm_evaluate "$@"
else
    compdef _mlx_lm_evaluate mlx_lm.evaluate
fi

