#compdef mlx_lm.evaluate
# @generated by usage-cli from mlx_lm.evaluate/zh-CN.usage.kdl
local curcontext="$curcontext"

_mlx_lm_evaluate() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.evaluate." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_evaluate.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX 评估"
bin mlx_lm.evaluate
version "0.31.3"
about "使用 lm-evaluation-harness 评估 MLX 模型。"
flag "-h --help" help=显示此帮助信息并退出
flag --model help=要评估的模型 {
    arg <MODEL>
}
flag --tasks {
    arg <TASKS>… var=#true
}
flag --output-dir help=结果文件的输出目录。 default=. {
    arg <OUTPUT_DIR>
}
flag --batch-size help=批大小 default="16" {
    arg <BATCH_SIZE>
}
flag --num-shots help=示例（few-shot）数量 {
    arg <NUM_SHOTS>
}
flag --max-tokens help="生成的最大 token 数。设置后优先于任务自身的默认值。" {
    arg <MAX_TOKENS>
}
flag --limit help=限制每个任务的样例数量。 {
    arg <LIMIT>
}
flag --seed help=随机种子。 default="123" {
    arg <SEED>
}
flag --fewshot-as-multiturn help="是否将 few-shot 示例作为多轮对话而非单条用户消息提供。"
flag --apply-chat-template help="是否对提示词应用聊天模板。若模型自带聊天模板则默认为 True，否则为 False。"
flag --no-apply-chat-template help="是否对提示词应用聊天模板。若模型自带聊天模板则默认为 True，否则为 False。"
flag --chat-template-args help="分词器 apply_chat_template 的参数 JSON 字符串，例如 '{\"enable_thinking\":false}'" default="{}" {
    arg <CHAT_TEMPLATE_ARGS>
}
flag --confirm-run-unsafe-code help=确认要运行包含不受信任代码的任务。
flag --trust-remote-code help=允许信任分词器的远程代码
flag --temp help=采样温度 default="0.0" {
    arg <TEMP>
}
flag --top-p help="采样 top-p" default="1.0" {
    arg <TOP_P>
}
flag --top-k help="采样 top-k" default="0" {
    arg <TOP_K>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_evaluate" ]; then
    _mlx_lm_evaluate "$@"
else
    compdef _mlx_lm_evaluate mlx_lm.evaluate
fi

