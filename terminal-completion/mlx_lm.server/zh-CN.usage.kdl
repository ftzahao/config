name "MLX HTTP 服务器"
bin "mlx_lm.server"
about "MLX HTTP 服务器。"
version "0.31.3"

flag "-h --help" help="显示此帮助信息并退出"

flag "--model <MODEL>" help="MLX 模型权重、分词器和配置的路径"

flag "--adapter-path <ADAPTER_PATH>" help="已训练适配器权重和配置的可选路径。"

flag "--host <HOST>" help="HTTP 服务器的主机（默认：127.0.0.1）" default="127.0.0.1"

flag "--port <PORT>" help="HTTP 服务器的端口（默认：8080）" default="8080"

flag "--allowed-origins <ALLOWED_ORIGINS>" help="允许的来源（默认：*）" default="*"

flag "--draft-model <DRAFT_MODEL>" help="用于投机解码的模型。"

flag "--num-draft-tokens <NUM_DRAFT_TOKENS>" help="使用投机解码时要预生成的 token 数量。" default="3"

flag "--trust-remote-code" help="允许信任分词器的远程代码"

flag "--log-level <LOG_LEVEL>" help="设置日志级别（默认：INFO）" default="INFO" {
    choices "DEBUG" "INFO" "WARNING" "ERROR" "CRITICAL"
}

flag "--chat-template <CHAT_TEMPLATE>" help="为分词器指定聊天模板"

flag "--use-default-chat-template" help="使用默认聊天模板"

flag "--temp <TEMP>" help="默认采样温度（默认：0.0）" default="0.0"

flag "--top-p <TOP_P>" help="默认核采样 top-p（默认：1.0）" default="1.0"

flag "--top-k <TOP_K>" help="默认 top-k 采样（默认：0，禁用 top-k）" default="0"

flag "--min-p <MIN_P>" help="默认 min-p 采样（默认：0.0，禁用 min-p）" default="0.0"

flag "--max-tokens <MAX_TOKENS>" help="默认生成的最大 token 数（默认：512）" default="512"

flag "--chat-template-args <CHAT_TEMPLATE_ARGS>" help="分词器 apply_chat_template 的参数 JSON 字符串，例如 '{\"enable_thinking\":false}'" default="{}"

flag "--decode-concurrency <DECODE_CONCURRENCY>" help="当请求可批处理时，并行解码的请求数量" default="32"

flag "--prompt-concurrency <PROMPT_CONCURRENCY>" help="当请求可批处理时，并行处理的提示词数量" default="8"

flag "--prefill-step-size <PREFILL_STEP_SIZE>" help="预填充处理的步长（默认：2048）" default="2048"

flag "--prompt-cache-size <PROMPT_CACHE_SIZE>" help="提示词缓存中可保存的不同 KV 缓存的最大数量" default="10"

flag "--prompt-cache-bytes <PROMPT_CACHE_BYTES>" help="KV 缓存的最大字节数"

flag "--pipeline" help="使用流水线而非张量并行"