name "Text Completion (中文)"
bin "llama-completion"
about "文本补全 / 交互式对话工具"
version "0.4.0-dev"

flag "-h --help --usage" help="打印用法并退出"
flag "--version" help="显示版本和构建信息"
flag "--cache-list" help="列出缓存中的模型"
flag "--completion-bash" help="输出可 source 的 bash 补全脚本"
flag "-t --threads <N>" help="线程数（默认：10）"
flag "--threads-batch <N>" help="批处理和提示词处理的线程数（默认：与 --threads 相同）"
flag "-C --cpu-mask <M>" help="CPU 亲和性掩码（默认：0x0）"
flag "--cpu-range <LO-HI>" help="CPU 亲和性范围。与 --cpu-mask 互补"
flag "--cpu-strict <0_1>" help="使用严格的 CPU 放置（默认：0）"
flag "--prio <N>" help="进程/线程优先级（默认：0）"
flag "--poll <0_100>" help="使用轮询级别等待工作（默认：50）"
flag "--cpu-mask-batch <M>" help="批处理 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
flag "--cpu-range-batch <LO-HI>" help="批处理 CPU 亲和性范围。与 --cpu-mask-batch 互补"
flag "--cpu-strict-batch <0_1>" help="使用严格的 CPU 放置（默认：与 --cpu-strict 相同）"
flag "--prio-batch <N>" help="设置进程/线程优先级：0-normal, 1-medium, 2-high, 3-realtime（默认：0）"
flag "--poll-batch <0_1>" help="使用轮询等待工作（默认：与 --poll 相同）"
flag "-c --ctx-size <N>" help="提示词上下文大小（默认：0，0 = 从模型加载）"
flag "-n --predict --n-predict <N>" help="预测的 token 数量（默认：-1，-1 = 无限）"
flag "-b --batch-size <N>" help="逻辑最大批处理大小（默认：2048）"
flag "--ubatch-size <N>" help="物理最大批处理大小（默认：512）"
flag "--keep <N>" help="从初始提示词中保留的 token 数（默认：0，-1 = 全部）"
flag "--swa-full" help="使用完整大小的 SWA 缓存（默认：false）"
flag "--flash-attn <ON_OFF_AUTO>" help="闪存注意力（默认：auto）"
flag "-p --prompt <PROMPT>" help="起始生成的提示词；系统消息请用 -sys"
flag "--perf --no-perf" help="是否启用内部 libllama 性能计时（默认：false）"
flag "-f --file <FNAME>" help="包含提示词的文件（默认：无）"
flag "--binary-file <FNAME>" help="包含提示词的二进制文件（默认：无）"
flag "-e --escape --no-escape" help="是否处理转义序列（\\n, \\r, \\t, \\', \\\", \\\\)（默认：true）"
flag "--rope-scaling <NONE_LINEAR_YARN>" help="RoPE 频率缩放方法（默认：linear）"
flag "--rope-scale <N>" help="RoPE 上下文缩放因子"
flag "--rope-freq-base <N>" help="RoPE 基础频率（默认：从模型加载）"
flag "--rope-freq-scale <N>" help="RoPE 频率缩放因子"
flag "--yarn-orig-ctx <N>" help="YaRN：模型原始上下文大小（默认：0 = 模型训练上下文大小）"
flag "--yarn-ext-factor <N>" help="YaRN：外推混合因子（默认：-1.00）"
flag "--yarn-attn-factor <N>" help="YaRN：缩放 sqrt(t) 或注意力幅度（默认：-1.00）"
flag "--yarn-beta-slow <N>" help="YaRN：高修正维度或 alpha（默认：-1.00）"
flag "--yarn-beta-fast <N>" help="YaRN：低修正维度或 beta（默认：-1.00）"
flag "--kv-offload --no-kv-offload" help="是否启用 KV 缓存卸载（默认：启用）"
flag "--repack --no-repack" help="是否启用权重重打包（默认：启用）"
flag "--no-host" help="不使用主机（默认：0）"
flag "--cache-type-k <TYPE>" help="KV 缓存 K 的数据类型（默认：f16）"
flag "--cache-type-v <TYPE>" help="KV 缓存 V 的数据类型（默认：f16）"
flag "--defrag-thold <N>" help="KV 缓存碎片整理阈值（已弃用）"
flag "--parallel <N>" help="并行解码的序列数（默认：1）"
flag "--rpc <SERVERS>" help="注册 RPC 设备（逗号分隔）"
flag "--mlock" help="已弃用，请使用 `--load-mode`：强制系统将模型保留在内存中，而不是交换或压缩"
flag "--mmap --no-mmap" help="已弃用，请使用 `--load-mode`：是否将模型映射到内存（如果禁用 mmap，加载较慢，但如果未使用 mlock，可能会减少页面换出）"
flag "--direct-io --no-direct-io" help="已弃用，请使用 `--load-mode`：如果可用，使用 DirectIO"
flag "--load-mode <MODE>" help="模型加载模式（默认：auto）"
flag "--lazy-mode <MODE>" help="延迟加载模式（默认：auto）"
flag "--numa <TYPE>" help="NUMA 模式（默认：禁用）"
flag "--device <DEV1_DEV2_>" help="设备（默认：auto）"
flag "--list-devices" help="列出可用设备并退出"
flag "--override-tensor <TENSOR_NAME_PATTERN>=<BUFFER_TYPE>_>" help="覆盖张量缓冲区类型（默认：disabled）"
flag "--cpu-moe" help="将所有 MoE 权重保留在 CPU 中"
flag "--n-cpu-moe <N>" help="将前 N 层的 MoE 权重保留在 CPU 中（默认：0）"
flag "--n-cpu-ffn <N>" help="将前 N 层的密集 FFN 权重保留在 CPU 中"
flag "--gpu-layers --n-gpu-layers <N>" help="存储在显存中的最大层数，精确数字、'auto' 或 'all'（默认：auto）"
flag "--split-mode <NONE_LAYER_ROW_TENSOR>" help="分割模式（默认：layer）"
flag "--tensor-split <N0_N1_N2_>" help="张量分割比例（默认：0）"
flag "--main-gpu <INDEX>" help="主 GPU 索引（默认：0）"
flag "--fit <ON_OFF>" help="是否自动调整参数以适应显存（默认：on）"
flag "--fit-target <MIB0_MIB1_MIB2_>" help="适配设备内存的余量（MiB，默认：关闭）"
flag "--fit-ctx <N>" help="--fit-target 的最小上下文大小（默认：4096）"
flag "--check-tensors" help="检查模型张量数据中的无效值（默认：false）"
flag "--override-kv <KEY=TYPE:VALUE_>" help="按键覆盖模型元数据的高级选项"
flag "--op-offload --no-op-offload" help="是否将主机张量操作卸载到设备（默认：true）"
flag "--lora <FNAME>" help="LoRA 适配器路径（逗号分隔可加载多个）"
flag "--lora-scaled <FNAME:SCALE_>" help="带缩放系数的 LoRA 适配器路径（格式：FNAME:SCALE,...）"
flag "--control-vector <FNAME>" help="添加控制向量（逗号分隔可添加多个）"
flag "--control-vector-scaled <FNAME:SCALE_>" help="添加带缩放的控制向量（格式：FNAME:SCALE,...）"
flag "--control-vector-layer-range <START_END>" help="应用控制向量的层范围（含首尾）"
flag "-m --model <FNAME>" help="模型文件路径（默认：models/7B/ggml-model-q4_0.gguf）"
flag "--model-url <MODEL_URL>" help="模型下载 URL（默认：未使用）"
flag "--docker-repo <REPO>_]<MODEL>[:QUANT>" help="Docker Hub 模型仓库。repo 可选，默认为 ai/。quant 可选，默认为 :latest。示例：gemma3（默认：未使用）"
flag "--hf-file <FILE>" help="Hugging Face 模型文件。如果指定，将覆盖 --hf-repo 中的 quant（默认：未使用）"
flag "--hf-token <TOKEN>" help="Hugging Face 访问令牌（默认：HF_TOKEN 环境变量的值）"
flag "--log-disable" help="禁用日志"
flag "--log-file <FNAME>" help="日志输出到文件"
flag "--log-jsonl --no-log-jsonl" help="以 JSONL 格式记录日志（默认：禁用）"
flag "--log-colors <ON_OFF_AUTO>" help="设置彩色日志（默认：auto）"
flag "-v --verbose --log-verbose" help="设置最大详细级别（用于调试）"
flag "--offline" help="离线模式：强制使用缓存，禁止网络访问（默认：禁用）"
flag "--verbosity --log-verbosity <N>" help="详细级别阈值（默认：1，0=通用输出, 1=错误, 2=警告, 3=信息, 4=跟踪, 5=调试）"
flag "--log-prefix --no-log-prefix" help="在日志消息中启用前缀"
flag "--log-timestamps --no-log-timestamps" help="在日志消息中启用时间戳"
flag "--spec-draft-type-k --cache-type-k-draft <TYPE>" help="草稿模型 K 的 KV 缓存数据类型（默认：f16）"
flag "--spec-draft-type-v --cache-type-v-draft <TYPE>" help="草稿模型 V 的 KV 缓存数据类型（默认：f16）"
flag "--samplers <SAMPLERS>" help="按顺序使用的采样器，用分号分隔"
flag "-s --seed <SEED>" help="随机数种子（默认：-1，-1 为随机）"
flag "--sampler-seq --sampling-seq <SEQUENCE>" help="采样器的简化序列（默认：edskypmxt）"
flag "--ignore-eos" help="忽略流结束 token 并继续生成"
flag "--temp --temperature <N>" help="温度（默认：0.80）"
flag "--top-k <N>" help="top-k 采样（默认：40，0 = 禁用）"
flag "--top-p <N>" help="top-p 采样（默认：0.95，1.0 = 禁用）"
flag "--min-p <N>" help="min-p 采样（默认：0.05，0.0 = 禁用）"
flag "--top-nsigma --top-n-sigma <N>" help="top-n-sigma 采样（默认：-1.00，禁用）"
flag "--xtc-probability <N>" help="XTC 概率（默认：0.00，禁用）"
flag "--xtc-threshold <N>" help="XTC 阈值（默认：0.10，禁用）"
flag "--typical --typical-p <N>" help="局部典型采样（默认：1.00，禁用）"
flag "--repeat-last-n <N>" help="考虑惩罚的最近 token 数（默认：64，禁用）"
flag "--repeat-penalty <N>" help="重复 token 惩罚（默认：1.00，禁用）"
flag "--presence-penalty <N>" help="重复存在惩罚（默认：0.00，禁用）"
flag "--frequency-penalty <N>" help="重复频率惩罚（默认：0.00，禁用）"
flag "--dry-multiplier <N>" help="DRY 采样乘数（默认：0.00，禁用）"
flag "--dry-base <N>" help="DRY 采样基础值（默认：1.75）"
flag "--dry-allowed-length <N>" help="DRY 采样允许长度（默认：2）"
flag "--dry-penalty-last-n <N>" help="最近 n 个 token 的 DRY 惩罚（默认：64，禁用）"
flag "--dry-sequence-breaker <STRING>" help="添加 DRY 采样的序列中断器"
flag "--adaptive-target <N>" help="adaptive-p：选择接近此概率的令牌（有效范围 0.0 到 1.0；负数 = 禁用）（默认：-1.00）"
flag "--adaptive-decay <N>" help="adaptive-p：目标适应的衰减率。值越低反应越快，值越高越稳定。（有效范围 0.0 到 0.99）（默认：0.90）"
flag "--dynatemp-range <N>" help="动态温度范围（默认：0.00，禁用）"
flag "--dynatemp-exp <N>" help="动态温度指数（默认：1.00）"
flag "--mirostat <N>" help="使用 Mirostat 采样（默认：0，禁用）"
flag "--mirostat-lr <N>" help="Mirostat 学习率（默认：0.10）"
flag "--mirostat-ent <N>" help="Mirostat 目标熵（默认：5.00）"
flag "-l --logit-bias <TOKEN_ID(+_-)BIAS>" help="修改令牌在完成中出现的可能性，例如 `--logit-bias 15043+1` 增加令牌 ' Hello' 的可能性，或 `--logit-bias 15043-1` 降低令牌 ' Hello' 的可能性"
flag "--grammar <GRAMMAR>" help="用于约束生成的 BNF 风格语法"
flag "--grammar-file <FNAME>" help="语法文件路径"
flag "-j --json-schema <SCHEMA>" help="用于约束生成的 JSON Schema"
flag "--json-schema-file <FILE>" help="包含 JSON Schema 的文件"
flag "--backend-sampling" help="启用后端采样（实验性，默认：禁用）"
flag "--verbose-prompt" help="在生成前打印详细提示词（默认：false）"
flag "--display-prompt --no-display-prompt" help="是否在生成时打印提示词（默认：true）"
flag "--color <ON_OFF_AUTO>" help="为输出着色以区分提示词和用户输入与生成内容（'on'、'off' 或 'auto'，默认：'auto'）。当输出到终端时，'auto' 启用颜色"
flag "--context-shift --no-context-shift" help="是否在无限文本生成时使用上下文移位（默认：禁用）"
flag "--system-prompt <PROMPT>" help="用于模型的系统提示词"
flag "--system-prompt-file <FNAME>" help="包含系统提示词的文件（默认：无）"
flag "--print-token-count <N>" help="每 N 个 token 打印一次计数（默认：-1）"
flag "--prompt-cache <FNAME>" help="缓存提示词状态以加快启动的文件（默认：none）"
flag "--prompt-cache-all" help="如指定，用户输入和生成内容也会保存到缓存"
flag "--prompt-cache-ro" help="如指定，使用提示词缓存但不更新它"
flag "-r --reverse-prompt <PROMPT>" help="在 PROMPT 处停止生成，交互模式下返回控制权"
flag "--special" help="启用特殊 token 输出（默认：false）"
flag "--conversation --no-conversation" help="是否以对话模式运行：不打印特殊 token 和后缀/前缀；交互模式也会启用（默认：聊天模板可用时自动启用）"
flag "--single-turn" help="仅运行单轮对话（默认：false）"
flag "-i --interactive" help="以交互模式运行（默认：false）"
flag "--interactive-first" help="以交互模式运行并立即等待输入（默认：false）"
flag "--multiline-input" help="允许您编写或粘贴多行，而无需每行以 '\\\\' 结尾"
flag "--in-prefix-bos" help="在用户输入前添加 BOS，位于 `--in-prefix` 字符串之前"
flag "--in-prefix <STRING>" help="用户输入的前缀字符串（默认：空）"
flag "--in-suffix <STRING>" help="用户输入的后缀字符串（默认：空）"
flag "--warmup --no-warmup" help="是否用空运行进行预热（默认：启用）"
flag "--grp-attn-n <N>" help="组注意力因子（默认：1）"
flag "--grp-attn-w <N>" help="组注意力宽度（默认：512）"
flag "--jinja --no-jinja" help="是否使用 Jinja 模板引擎（默认：启用）"
flag "--reasoning-format <FORMAT>" help="控制是否允许从响应中提取思考标签，以及以哪种格式返回；选项之一：- none：将思考保留在 `message.content` 中未解析 - deepseek：将思考放在 `message.reasoning_content` 中 - deepseek-legacy：在 `message.content` 中保留 `<think>` 标签，同时填充 `message.reasoning_content`（默认：auto）"
flag "--reasoning <ON_OFF_AUTO>" help="在对话中使用推理/思考（默认：auto）"
flag "--reasoning-effort <LEVEL>" help="推理努力级别（默认：default）"
flag "--reasoning-budget <N>" help="思考的 token 预算（默认：-1，无限制）"
flag "--reasoning-budget-message <MESSAGE>" help="推理预算耗尽时注入的消息（默认：无）"
flag "--reasoning-preserve --no-reasoning-preserve" help="在完整历史中保留推理轨迹，而不仅仅是最后一条助手消息（默认：启用）"
flag "--chat-template <JINJA_TEMPLATE>" help="设置自定义 Jinja 聊天模板（默认：从模型元数据获取的模板）。如果指定了 suffix/prefix，模板将被禁用。仅接受常用模板（除非在此标志之前设置了 --jinja）：内置模板列表：bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
flag "--chat-template-file <JINJA_TEMPLATE_FILE>" help="设置自定义 Jinja 聊天模板文件（默认：从模型元数据获取的模板）。如果指定了 suffix/prefix，模板将被禁用。仅接受常用模板（除非在此标志之前设置了 --jinja）：内置模板列表：bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
flag "--skip-chat-parsing --no-skip-chat-parsing" help="强制使用纯内容解析器，即使指定了 Jinja 模板；模型将在内容部分输出所有内容，包括任何推理和/或工具调用（默认：禁用）"
flag "--simple-io" help="使用基本 I/O 以获得更好的兼容性"
