  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_generate.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX Generate"
bin mlx_lm.generate
version "0.31.3"
about "LLM inference script"
flag "-h --help" help="show this help message and exit"
flag --model help="The path to the local model directory or Hugging Face repo. If no model is specified, then mlx-community/Llama-3.2-3B-Instruct-4bit is used." {
    arg <MODEL>
}
flag --trust-remote-code help="Enable trusting remote code for tokenizer"
flag --adapter-path help="Optional path for the trained adapter weights and config." {
    arg <ADAPTER_PATH>
}
flag --extra-eos-token help="Add tokens in the list of eos tokens that stop generation." {
    arg <EXTRA_EOS_TOKEN>… var=#true
}
flag --system-prompt help="System prompt to be used for the chat template" {
    arg <SYSTEM_PROMPT>
}
flag "-p --prompt" help="Message to be processed by the model ('-' reads from stdin)" {
    arg <PROMPT>
}
flag --prefill-response help="Prefill response to be used for the chat template" {
    arg <PREFILL_RESPONSE>
}
flag "-m --max-tokens" help="Maximum number of tokens to generate" {
    arg <MAX_TOKENS>
}
flag --temp help="Sampling temperature" {
    arg <TEMP>
}
