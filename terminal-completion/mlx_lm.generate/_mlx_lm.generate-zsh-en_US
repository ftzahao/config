    arg <TOP_P>
}
flag --min-p help="Sampling min-p" {
    arg <MIN_P>
}
flag --top-k help="Sampling top-k" {
    arg <TOP_K>
}
flag --xtc-probability help="Probability of XTC sampling to happen each next token" {
    arg <XTC_PROBABILITY>
}
flag --xtc-threshold help="Thresold the probs of each next token candidate to be sampled by XTC" {
    arg <XTC_THRESHOLD>
}
flag --min-tokens-to-keep help="Minimum tokens to keep for min-p sampling." {
    arg <MIN_TOKENS_TO_KEEP>
}
flag --seed help="PRNG seed" {
    arg <SEED>
