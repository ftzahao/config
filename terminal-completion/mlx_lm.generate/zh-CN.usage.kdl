name "MLX 生成"
bin "mlx_lm.generate"
about "LLM 推理脚本"
version "0.31.3"

flag "-h --help" help="显示此帮助信息并退出"

flag "--model <MODEL>" help="本地模型目录或 Hugging Face 仓库的路径。若未指定模型，则使用 mlx-community/Llama-3.2-3B-Instruct-4bit。"

flag "--trust-remote-code" help="允许信任分词器的远程代码"

flag "--adapter-path <ADAPTER_PATH>" help="已训练适配器权重和配置的可选路径。"

flag "--extra-eos-token <EXTRA_EOS_TOKEN>..." help="在停止生成的 eos token 列表中添加 token。"

flag "--system-prompt <SYSTEM_PROMPT>" help="用于聊天模板的系统提示词"

flag "--prompt -p <PROMPT>" help="要交给模型处理的消息（'-' 表示从 stdin 读取）"

flag "--prefill-response <PREFILL_RESPONSE>" help="用于聊天模板的预填充响应"

flag "--max-tokens -m <MAX_TOKENS>" help="生成的最大 token 数"

flag "--temp <TEMP>" help="采样温度"

flag "--top-p <TOP_P>" help="采样 top-p"

flag "--min-p <MIN_P>" help="采样 min-p"

flag "--top-k <TOP_K>" help="采样 top-k"

flag "--xtc-probability <XTC_PROBABILITY>" help="每个下一 token 发生 XTC 采样的概率"

flag "--xtc-threshold <XTC_THRESHOLD>" help="每个下一 token 候选被 XTC 采样的概率阈值"

flag "--min-tokens-to-keep <MIN_TOKENS_TO_KEEP>" help="min-p 采样时保留的最少 token 数。"

flag "--seed <SEED>" help="PRNG 随机种子"

flag "--ignore-chat-template" help="使用原始提示词，不应用分词器的聊天模板。"

flag "--use-default-chat-template" help="使用默认聊天模板"

flag "--chat-template-config <CHAT_TEMPLATE_CONFIG>" help="`apply_chat_template` 的附加配置。应为字符串键到值的字典，表示为可 JSON 解析的字符串。"

flag "--verbose <VERBOSE>" help="'True' 或 'T' 时输出详细日志；'False' 或 'F' 时仅打印回复"

flag "--max-kv-size <MAX_KV_SIZE>" help="设置最大键值缓存大小"

flag "--prompt-cache-file <PROMPT_CACHE_FILE>" help="包含已保存 KV 缓存的文件，可避免重新计算"

flag "--quantize-activations" help="使用对应层的量化配置对激活值进行量化。"

flag "--kv-bits <KV_BITS>" help="KV 缓存量化位数。默认不量化。"

flag "--kv-group-size <KV_GROUP_SIZE>" help="KV 缓存分组的组大小。"

flag "--quantized-kv-start <QUANTIZED_KV_START>" help="设置 --kv-bits 后，从此步开始量化 KV 缓存。"

flag "--draft-model <DRAFT_MODEL>" help="用于投机解码的模型。"

flag "--num-draft-tokens <NUM_DRAFT_TOKENS>" help="使用投机解码时要预生成的 token 数量。"
