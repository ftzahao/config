  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX 生成"
bin mlx_lm.generate
version "0.31.3"
about "LLM 推理脚本"
flag "-h --help" help=显示此帮助信息并退出
flag --model help="本地模型目录或 Hugging Face 仓库的路径。若未指定模型，则使用 mlx-community/Llama-3.2-3B-Instruct-4bit。" {
