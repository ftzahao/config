flag --trust-remote-code help=允许信任分词器的远程代码
flag --adapter-path help=已训练适配器权重和配置的可选路径。 {
    arg <ADAPTER_PATH>
}
flag --extra-eos-token help="在停止生成的 eos token 列表中添加 token。" {
    arg <EXTRA_EOS_TOKEN>… var=#true
}
flag --system-prompt help=用于聊天模板的系统提示词 {
    arg <SYSTEM_PROMPT>
}
flag "-p --prompt" help="要交给模型处理的消息（'-' 表示从 stdin 读取）" {
    arg <PROMPT>
}
flag --prefill-response help=用于聊天模板的预填充响应 {
    arg <PREFILL_RESPONSE>
