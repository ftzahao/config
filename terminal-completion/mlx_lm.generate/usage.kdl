name "MLX Generate"
bin "mlx_lm.generate"
about "LLM inference script"
version "0.31.3"

flag "-h --help" help="show this help message and exit"

flag "--model <MODEL>" help="The path to the local model directory or Hugging Face repo. If no model is specified, then mlx-community/Llama-3.2-3B-Instruct-4bit is used."

flag "--trust-remote-code" help="Enable trusting remote code for tokenizer"

flag "--adapter-path <ADAPTER_PATH>" help="Optional path for the trained adapter weights and config."

flag "--extra-eos-token <EXTRA_EOS_TOKEN>..." help="Add tokens in the list of eos tokens that stop generation."

flag "--system-prompt <SYSTEM_PROMPT>" help="System prompt to be used for the chat template"

flag "--prompt -p <PROMPT>" help="Message to be processed by the model ('-' reads from stdin)"

flag "--prefill-response <PREFILL_RESPONSE>" help="Prefill response to be used for the chat template"

flag "--max-tokens -m <MAX_TOKENS>" help="Maximum number of tokens to generate"

flag "--temp <TEMP>" help="Sampling temperature"

flag "--top-p <TOP_P>" help="Sampling top-p"

flag "--min-p <MIN_P>" help="Sampling min-p"

flag "--top-k <TOP_K>" help="Sampling top-k"

flag "--xtc-probability <XTC_PROBABILITY>" help="Probability of XTC sampling to happen each next token"

flag "--xtc-threshold <XTC_THRESHOLD>" help="Thresold the probs of each next token candidate to be sampled by XTC"

flag "--min-tokens-to-keep <MIN_TOKENS_TO_KEEP>" help="Minimum tokens to keep for min-p sampling."

flag "--seed <SEED>" help="PRNG seed"

flag "--ignore-chat-template" help="Use the raw prompt without the tokenizer's chat template."

flag "--use-default-chat-template" help="Use the default chat template"

flag "--chat-template-config <CHAT_TEMPLATE_CONFIG>" help="Additional config for `apply_chat_template`. Should be a dictionary of string keys to values represented as a JSON decodable string."

flag "--verbose <VERBOSE>" help="Log verbose output when 'True' or 'T' or only print the response when 'False' or 'F'"

flag "--max-kv-size <MAX_KV_SIZE>" help="Set the maximum key-value cache size"

flag "--prompt-cache-file <PROMPT_CACHE_FILE>" help="A file containing saved KV caches to avoid recomputing them"

flag "--quantize-activations" help="Quantize activations using the same quantization config as the corresponding layer."

flag "--kv-bits <KV_BITS>" help="Number of bits for KV cache quantization. Defaults to no quantization."

flag "--kv-group-size <KV_GROUP_SIZE>" help="Group size for KV cache quantization."

flag "--quantized-kv-start <QUANTIZED_KV_START>" help="When --kv-bits is set, start quantizing the KV cache from this step onwards."

flag "--draft-model <DRAFT_MODEL>" help="A model to be used for speculative decoding."

flag "--num-draft-tokens <NUM_DRAFT_TOKENS>" help="Number of tokens to draft when using speculative decoding."
