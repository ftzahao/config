name "MLX 基准测试"
bin "mlx_lm.benchmark"
about "LLM 基准测试脚本"
version "0.31.3"

flag "-h --help" help="显示此帮助信息并退出"

flag "--model <MODEL>" help="本地模型目录或 Hugging Face 仓库的路径。若未指定模型，则使用 mlx-community/Llama-3.2-3B-Instruct-4bit。"

flag "--prompt-tokens -p <PROMPT_TOKENS>" help="提示词长度"

flag "--generation-tokens -g <GENERATION_TOKENS>" help="生成内容长度"

flag "--batch-size -b <BATCH_SIZE>" help="批大小"

flag "--num-trials -n <NUM_TRIALS>" help="计时测试次数"

flag "--pipeline" help="使用流水线而非张量并行"

flag "--quantize-activations" help="使用对应层的量化配置对激活值进行量化。"

flag "--prefill-step-size <PREFILL_STEP_SIZE>" help="预填充处理的步长（默认：2048）"

flag "--delay <DELAY>" help="每次测试之间的延迟（秒）（默认：0）" default="0"
