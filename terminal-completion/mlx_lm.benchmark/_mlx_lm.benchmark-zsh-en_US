local curcontext="$curcontext"

_mlx_lm_benchmark() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.benchmark." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_benchmark.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX Benchmark"
bin mlx_lm.benchmark
version "0.31.3"
about "LLM benchmarking script"
flag "-h --help" help="show this help message and exit"
flag --model help="The path to the local model directory or Hugging Face repo. If no model is specified, then mlx-community/Llama-3.2-3B-Instruct-4bit is used." {
    arg <MODEL>
}
flag "-p --prompt-tokens" help="Length of prompt" {
    arg <PROMPT_TOKENS>
}
flag "-g --generation-tokens" help="Length of completion" {
    arg <GENERATION_TOKENS>
}
flag "-b --batch-size" help="Batch size" {
    arg <BATCH_SIZE>
}
flag "-n --num-trials" help="Number of timing trials" {
    arg <NUM_TRIALS>
}
flag --pipeline help="Use pipelining instead of tensor parallelism"
flag --quantize-activations help="Quantize activations using the same quantization config as the corresponding layer."
flag --prefill-step-size help="Step size for prefill processing (default: 2048)" {
    arg <PREFILL_STEP_SIZE>
}
flag --delay help="Delay between each test in seconds (default: 0)" default="0" {
    arg <DELAY>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_benchmark" ]; then
    _mlx_lm_benchmark "$@"
else
