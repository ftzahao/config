flag --train help=执行训练
flag --data help="包含 {train, valid, test}.jsonl 文件的目录，或 Hugging Face 数据集名称（例如 'mlx-community/wikisql'）" {
    arg <DATA>
}
flag --fine-tune-type help="微调类型：lora、dora 或 full。" {
    arg <FINE_TUNE_TYPE> {
        choices lora dora full
    }
}
flag --optimizer help="训练使用的优化器：adam、adamw、sgd 或 adafactor。" {
    arg <OPTIMIZER> {
        choices adam adamw muon sgd adafactor
    }
