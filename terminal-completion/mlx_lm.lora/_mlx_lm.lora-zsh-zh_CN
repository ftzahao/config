name "MLX LoRA"
bin mlx_lm.lora
version "0.31.3"
about "LoRA 或 QLoRA 微调。"
flag "-h --help" help=显示此帮助信息并退出
flag --model help="本地模型目录或 Hugging Face 仓库的路径。" {
    arg <MODEL>
