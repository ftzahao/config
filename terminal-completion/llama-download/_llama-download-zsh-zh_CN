#compdef llama-download
# @generated by usage-cli from llama-download/zh-CN.usage.kdl
local curcontext="$curcontext"

_llama_download() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in llama-download." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_llama_download.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "LLaMA Download"
bin "llama download"
version "0.4.0-dev"
about "llama.cpp 模型下载工具"
flag "-h --help --usage" help=打印用法并退出
flag "-m --model" help=要加载的模型路径 {
    arg <FNAME>
}
flag --model-url help="模型下载 URL（默认：未使用）" {
    arg <MODEL_URL>
}
flag --docker-repo help="Docker Hub 模型仓库（repo 可选，默认 ai/）" {
    arg <REPO>
}
flag --hf-repo help="Hugging Face 模型仓库；quant 可选，默认 Q4_K_M" {
    arg "<user/model:quant>"
}
flag --hf-file help="Hugging Face 模型文件（覆盖 --hf-repo 中的 quant）" {
    arg <FILE>
}
flag --hf-token help="Hugging Face 访问令牌（默认：HF_TOKEN 环境变量）" {
    arg <TOKEN>
}
flag --mtp help="同时下载 MTP 头（如果可用）"
flag --dflash help="同时下载 DFlash sidecar（如果可用）"
flag --eagle3 help="同时下载 Eagle3 sidecar（如果可用）"
flag --no-mmproj help="禁用自动下载 mmproj"
flag --offline help=离线模式：强制使用缓存，禁止网络访问
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_llama_download" ]; then
    _llama_download "$@"
else
    compdef _llama_download llama-download
fi

