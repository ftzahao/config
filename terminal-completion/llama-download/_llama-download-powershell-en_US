# @generated by usage-cli from llama-download/usage.kdl

if (-not (Get-Command 'usage' -ErrorAction SilentlyContinue)) {
    Write-Warning "Error: usage CLI not found. This is required for completions to work in llama-download."
    Write-Warning "See https://usage.jdx.dev for more information."
    return
}

Register-ArgumentCompleter -Native -CommandName 'llama-download' -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)

    $tmpDir = if ($env:TEMP) { $env:TEMP } else { [System.IO.Path]::GetTempPath() }
    $specFile = Join-Path $tmpDir "usage__usage_spec_llama_download.kdl"

    'name "LLaMA Download"
bin "llama download"
version "0.4.0-dev"
about "llama.cpp model download tool"
flag "-h --help --usage" help="print usage and exit"
flag "-m --model" help="model path to load" {
    arg <FNAME>
}
flag --model-url help="model download url (default: unused)" {
    arg <MODEL_URL>
}
flag --docker-repo help="Docker Hub model repository (repo is optional, default to ai/)" {
    arg <REPO>
}
flag --hf-repo help="Hugging Face model repository; quant is optional, default to Q4_K_M" {
    arg "<user/model:quant>"
}
flag --hf-file help="Hugging Face model file (overrides quant in --hf-repo)" {
    arg <FILE>
}
flag --hf-token help="Hugging Face access token (default: HF_TOKEN env var)" {
    arg <TOKEN>
}
flag --mtp help="also download the MTP head, if available"
flag --dflash help="also download the DFlash sidecar, if available"
flag --eagle3 help="also download the Eagle3 sidecar, if available"
flag --no-mmproj help="disable automatic mmproj download"
flag --offline help="Offline mode: forces use of cache, prevents network access"
' | Out-File -FilePath $specFile -Encoding utf8

    $words = $commandAst.CommandElements | ForEach-Object { $_.ToString() }
    if ($words.Count -lt 1) {
        $words = @('llama-download')
    }

    $completions = & 'usage' complete-word --shell powershell -f "$specFile" -- @words $wordToComplete 2>$null

    if ($completions) {
        $completions | ForEach-Object {
            $parts = $_ -split "`t", 2
            $completion = $parts[0]
            $description = if ($parts.Count -gt 1) { $parts[1] } else { '' }

            [System.Management.Automation.CompletionResult]::new(
                $completion,
                $completion,
                'ParameterValue',
                $description
            )
        }
    }
}
