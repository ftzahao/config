# @generated by usage-cli from llama-download/usage.kdl

# if "usage" is not installed show an error
if ! type -P usage &> /dev/null
    echo >&2
    echo "Error: usage CLI not found. This is required for completions to work in llama-download." >&2
    echo "See https://usage.jdx.dev for more information." >&2
    return 1
end

set _usage_spec_llama_download 'name "LLaMA Download"
bin "llama download"
version "0.4.0-dev"
about "llama.cpp model download tool"
flag "-h --help --usage" help="print usage and exit"
flag "-m --model" help="model path to load" {
    arg <FNAME>
}
flag --model-url help="model download url (default: unused)" {
    arg <MODEL_URL>
}
flag --docker-repo help="Docker Hub model repository (repo is optional, default to ai/)" {
    arg <REPO>
}
flag --hf-repo help="Hugging Face model repository; quant is optional, default to Q4_K_M" {
    arg "<user/model:quant>"
}
flag --hf-file help="Hugging Face model file (overrides quant in --hf-repo)" {
    arg <FILE>
}
flag --hf-token help="Hugging Face access token (default: HF_TOKEN env var)" {
    arg <TOKEN>
}
flag --mtp help="also download the MTP head, if available"
flag --dflash help="also download the DFlash sidecar, if available"
flag --eagle3 help="also download the Eagle3 sidecar, if available"
flag --no-mmproj help="disable automatic mmproj download"
flag --offline help="Offline mode: forces use of cache, prevents network access"
'
set -l spec_dir (if set -q XDG_CACHE_HOME; echo $XDG_CACHE_HOME; else; echo $HOME/.cache; end)/usage
test -d "$spec_dir"; or mkdir -p -m 700 "$spec_dir"
set -l spec_file "$spec_dir/usage__usage_spec_llama_download.spec"
echo $_usage_spec_llama_download > "$spec_file"

set -l tokens
if commandline -x >/dev/null 2>&1
    complete -xc llama-download -a "(command usage complete-word --shell fish -f \"$spec_file\" -- (commandline -xpc) (commandline -t))"
else
    complete -xc llama-download -a "(command usage complete-word --shell fish -f \"$spec_file\" -- (commandline -opc) (commandline -t))"
end
