#compdef llama-download
# @generated by usage-cli from llama-download/usage.kdl
local curcontext="$curcontext"

_llama_download() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in llama-download." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_llama_download.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "LLaMA Download"
bin "llama download"
version "0.4.0-dev"
about "llama.cpp model download tool"
flag "-h --help --usage" help="print usage and exit"
flag "-m --model" help="model path to load" {
    arg <FNAME>
}
flag --model-url help="model download url (default: unused)" {
    arg <MODEL_URL>
}
flag --docker-repo help="Docker Hub model repository (repo is optional, default to ai/)" {
    arg <REPO>
}
flag --hf-repo help="Hugging Face model repository; quant is optional, default to Q4_K_M" {
    arg "<user/model:quant>"
}
flag --hf-file help="Hugging Face model file (overrides quant in --hf-repo)" {
    arg <FILE>
}
flag --hf-token help="Hugging Face access token (default: HF_TOKEN env var)" {
    arg <TOKEN>
}
flag --mtp help="also download the MTP head, if available"
flag --dflash help="also download the DFlash sidecar, if available"
flag --eagle3 help="also download the Eagle3 sidecar, if available"
flag --no-mmproj help="disable automatic mmproj download"
flag --offline help="Offline mode: forces use of cache, prevents network access"
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_llama_download" ]; then
    _llama_download "$@"
else
    compdef _llama_download llama-download
fi

