#compdef llama-gguf-split
# @generated by usage-cli from llama-gguf-split/usage.kdl
local curcontext="$curcontext"

_llama_gguf_split() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in llama-gguf-split." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_llama_gguf_split.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "LLaMA GGUF Split (English)"
bin llama-gguf-split
version "0.4.0-dev"
about "GGUF 文件拆分/合并工具"
flag "-h --help" help="show this help message and exit"
flag --version help="show version and build info"
flag --split help="split GGUF to multiple GGUF (enabled by default)"
flag --merge help="merge multiple GGUF to a single GGUF"
flag --split-max-tensors help="max tensors in each split (default: 128)"
flag --dry-run help="only print out a split plan and exit, without writing any new files"
flag --delete-splits help="delete the split files during merge to free up disk space WARNING: this option is unsafe and will leave you in an unrecoverable state if something fails during the merge"
flag --split-max-size help="" {
    arg <N_M_G>
}
flag --no-tensor-first-split help="" {
    arg <DO>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_llama_gguf_split" ]; then
    _llama_gguf_split "$@"
else
    compdef _llama_gguf_split llama-gguf-split
fi

