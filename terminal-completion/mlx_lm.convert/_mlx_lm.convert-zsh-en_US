#compdef mlx_lm.convert
# @generated by usage-cli from mlx_lm.convert/usage.kdl
local curcontext="$curcontext"

_mlx_lm_convert() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.convert." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_convert.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX Convert"
bin mlx_lm.convert
version "0.31.3"
about "Convert Hugging Face model to MLX format"
flag "-h --help" help="show this help message and exit"
flag "--hf-path --model" help="Path to the model. This can be a local path or a Hugging Face Hub model identifier." {
    arg <HF_PATH>
}
flag --mlx-path help="Path to save the MLX model." {
    arg <MLX_PATH>
}
flag "-q --quantize" help="Generate a quantized model."
flag --q-group-size help="Group size for quantization." {
    arg <Q_GROUP_SIZE>
}
flag --q-bits help="Bits per weight for quantization." {
    arg <Q_BITS>
}
flag --q-mode help="The quantization mode." {
    arg <Q_MODE> {
        choices affine mxfp4 nvfp4 mxfp8
    }
}
flag --quant-predicate help="Mixed-bit quantization recipe." {
    arg <QUANT_PREDICATE> {
        choices mixed_2_6 mixed_3_4 mixed_3_6 mixed_4_6
    }
}
flag --dtype help="Type to save the non-quantized parameters. Defaults to config.json's `torch_dtype` or the current model weights dtype." {
    arg <DTYPE> {
        choices float16 bfloat16 float32
    }
}
flag --upload-repo help="The Hugging Face repo to upload the model to." {
    arg <UPLOAD_REPO>
}
flag "-d --dequantize" help="Dequantize a quantized model."
flag --trust-remote-code help="Trust remote code when loading tokenizer."
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_convert" ]; then
    _mlx_lm_convert "$@"
else
    compdef _mlx_lm_convert mlx_lm.convert
fi

