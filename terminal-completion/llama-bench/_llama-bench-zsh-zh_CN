  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_llama_bench.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "LLaMA Bench (中文)"
bin llama-bench
