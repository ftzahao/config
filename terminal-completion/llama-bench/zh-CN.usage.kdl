name "LLaMA Bench (中文)"
bin "llama-bench"
about "模型性能基准测试工具"
version "0.4.0-dev"

flag "--numa <TYPE>" help="NUMA 模式（默认：禁用）"
flag "-r --repetitions <N>" help="每个测试的重复次数（默认：5）"
flag "--prio <N>" help="进程/线程优先级（默认：0）"
flag "--delay <0_N>" help="每次测试间的延迟（默认：0）"
flag "--list-devices" help="列出可用设备并退出"
flag "--hf-repo <USER_MODEL_QUANT>" help="Hugging Face 模型仓库；quant 可选，不区分大小写，默认 Q4_K_M，如果 Q4_K_M 不存在则回退到仓库中的第一个文件。示例：ggml-org/GLM-4.7-Flash-GGUF:Q4_K_M（默认：未使用）"
flag "--hf-file <FILE>" help="Hugging Face 模型文件。如果指定，将覆盖 --hf-repo 中的 quant（默认：未使用）"
flag "--hf-token <TOKEN>" help="Hugging Face 访问令牌（默认：HF_TOKEN 环境变量的值）"
flag "--rpc <RPC_SERVERS>" help="注册 RPC 设备（逗号分隔）"
flag "-o --output <CSV_JSON_JSONL_MD_SQL>" help="stdout 输出格式（默认：md）"
flag "--output-err <CSV_JSON_JSONL_MD_SQL>" help="stderr 输出格式（默认：无）"
flag "-v --verbose" help="详细输出"
flag "--progress" help="打印测试进度指示器"
flag "--no-warmup" help="跳过基准测试前的预热运行"
flag "--fit-target <MIB>" help="适配设备内存的余量（MiB，默认：关闭）"
flag "--fit-ctx <N>" help="--fit-target 的最小上下文大小（默认：4096）"
flag "--offline" help="离线模式：强制使用缓存，禁止网络访问（默认：禁用）"
flag "-h --help" help=""
flag "-m --model <FILENAME>" help="模型文件路径（默认：models/7B/ggml-model-q4_0.gguf）"
flag "-p --n-prompt <N>" help="提示词大小（默认：512）"
flag "-n --n-gen <N>" help="生成的 token 数量（默认：128）"
flag "-d --n-depth <N>" help="递归深度（默认：0）"
flag "-b --batch-size <N>" help="逻辑最大批处理大小（默认：2048）"
flag "--ubatch-size <N>" help="物理最大批处理大小（默认：512）"
flag "--cache-type-k <T>" help="KV 缓存 K 的数据类型（默认：f16）"
flag "--cache-type-v <T>" help="KV 缓存 V 的数据类型（默认：f16）"
flag "-t --threads <N>" help="线程数（默认：10）"
flag "-C --cpu-mask <HEX_HEX>" help="CPU 亲和性掩码（默认：0x0）"
flag "--cpu-strict <N>" help="使用严格的 CPU 放置（默认：0）"
flag "--poll <0_100>" help="使用轮询级别等待工作（默认：50）"
flag "--n-gpu-layers <N>" help="存储在显存中的最大层数（默认：-1）"
flag "--n-cpu-moe <N>" help="将前 N 层的 MoE 权重保留在 CPU 中（默认：0）"
flag "--split-mode <NONE_LAYER_ROW_TENSOR>" help="分割模式（默认：layer）"
flag "--main-gpu <I>" help="主 GPU 索引（默认：0）"
flag "--no-kv-offload <N>" help="不使用 KV 缓存卸载（默认：0）"
flag "--flash-attn <ON_OFF_AUTO>" help="闪存注意力（默认：auto）"
flag "--device <DEV0_DEV1>" help="设备（默认：auto）"
flag "--load-mode <AUTO_NONE_MMAP_MLOCK_MMAP_MLOCK_DIO>" help=""
flag "--lazy-mode <ON_AUTO_OFF>" help="延迟加载模式（默认：auto）"
flag "--mmap <N>" help="已弃用，请使用 --load-mode"
flag "--direct-io <N>" help="已弃用，请使用 --load-mode"
flag "--embeddings <N>" help="是否返回嵌入（默认：0）"
flag "--tensor-split <TS0_TS1>" help="张量分割比例（默认：0）"
flag "--override-tensor <TENSOR>" help="覆盖张量缓冲区类型（默认：disabled）"
flag "--no-op-offload <N>" help="不使用主机张量操作卸载（默认：0）"
flag "--no-host <N>" help="不使用主机（默认：0）"
