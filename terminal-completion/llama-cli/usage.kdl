name "LLaMA CLI (English)"
bin "llama-cli"
about "LLaMA 推理命令行工具"
version "0.4.0-dev"

flag "-h --help --usage" help="print usage and exit"
flag "--version" help="show version and build info"
flag "--cache-list" help="show list of models in cache"
flag "--completion-bash" help="print source-able bash completion script for llama.cpp"
flag "-t --threads <N>" help="number of CPU threads to use during generation (default: -1)"
flag "-C --cpu-mask <M>" help="CPU affinity mask: arbitrarily long hex. Complements cpu-range (default: \"\")"
flag "--cpu-range <LO_HI>" help="range of CPUs for affinity. Complements --cpu-mask"
flag "--cpu-strict <N>" help="use strict CPU placement (default: 0)"
flag "--prio <N>" help="set process/thread priority : low(-1), normal(0), medium(1), high(2), realtime(3) (default: 0)"
flag "--poll <0_100>" help="use polling level to wait for work (0 - no polling, default: 50)"
flag "--cpu-mask-batch <M>" help="CPU affinity mask: arbitrarily long hex. Complements cpu-range-batch (default: same as --cpu-mask)"
flag "--cpu-strict-batch <N>" help="use strict CPU placement (default: same as --cpu-strict)"
flag "--prio-batch <N>" help="set process/thread priority : 0-normal, 1-medium, 2-high, 3-realtime (default: 0)"
flag "--poll-batch <N>" help="use polling to wait for work (default: same as --poll)"
flag "-c --ctx-size <N>" help="size of the prompt context (default: 0, 0 = loaded from model)"
flag "-n --predict --n-predict <N>" help="number of tokens to predict (default: -1, -1 = infinity)"
flag "-b --batch-size <N>" help="logical maximum batch size (default: 2048)"
flag "--ubatch-size <N>" help="physical maximum batch size (default: 512)"
flag "--keep <N>" help="number of tokens to keep from the initial prompt (default: 0, -1 = all)"
flag "--perf --no-perf" help="whether to enable internal libllama performance timings (default: false)"
flag "-e --escape --no-escape" help="whether to process escapes sequences (\\n, \\r, \\t, \\', \\\", \\\\) (default: true)"
flag "--parallel <N>" help="number of parallel sequences to decode (default: 1)"
flag "--override-tensor <TENSOR>" help="override tensor buffer type"
flag "--cpu-moe" help="keep all Mixture of Experts (MoE) weights in the CPU"
flag "--n-cpu-moe <N>" help="keep the Mixture of Experts (MoE) weights of the first N layers in the"
flag "--n-cpu-ffn <N>" help="keep the dense FFN weights of the first N layers in the CPU (dense models; for MoE expert weights use --n-cpu-moe)"
flag "--check-tensors" help="check model tensor data for invalid values (default: false)"
flag "--override-kv <KEY_TYPE_VALUE>" help="advanced option to override model metadata by key. to specify multiple overrides, either use comma-separated values. types: int, float, bool, str. example: --override-kv tokenizer.ggml.add_bos_token=bool:false,tokenizer.ggml.add_eos_token=bool:false"
flag "--op-offload --no-op-offload" help="whether to offload host tensor operations to device (default: true)"
flag "-m --model <FNAME>" help="model path to load"
flag "--model-url <MODEL_URL>" help="model download url (default: unused)"
flag "--hf-file <FILE>" help="Hugging Face model file. If specified, it will override the quant in --hf-repo (default: unused)"
flag "--hf-token <TOKEN>" help="Hugging Face access token (default: value from HF_TOKEN environment variable)"
flag "--spec-draft-override-tensor --override-tensor-draft <TENSOR>" help="override tensor buffer type for draft model"
flag "--gpt-oss-20b-default" help="use gpt-oss-20b (note: can download weights from the internet)"
flag "--gpt-oss-120b-default" help="use gpt-oss-120b (note: can download weights from the internet)"
flag "--vision-gemma-4b-default" help="use Gemma 3 4B QAT (note: can download weights from the internet)"
flag "--vision-gemma-12b-default" help="use Gemma 3 12B QAT (note: can download weights from the internet)"
flag "--spec-default" help="enable default speculative decoding config"
flag "--rope-scaling <NONE_LINEAR_YARN>" help="RoPE frequency scaling method, defaults to linear unless specified by the model"
flag "--rope-scale <N>" help="RoPE context scaling factor, expands context by a factor of N"
flag "--rope-freq-base <N>" help="RoPE base frequency, used by NTK-aware scaling (default: loaded from model)"
flag "--rope-freq-scale <N>" help="RoPE frequency scaling factor, expands context by a factor of 1/N"
flag "--yarn-orig-ctx <N>" help="YaRN: original context size of model (default: 0 = model training context size)"
flag "--yarn-ext-factor <N>" help="YaRN: extrapolation mix factor (default: -1.00, 0.0 = full interpolation)"
flag "--yarn-attn-factor <N>" help="YaRN: scale sqrt(t) or attention magnitude (default: -1.00)"
flag "--yarn-beta-slow <N>" help="YaRN: high correction dim or alpha (default: -1.00)"
flag "--yarn-beta-fast <N>" help="YaRN: low correction dim or beta (default: -1.00)"
flag "--repack --no-repack" help="whether to enable weight repacking (default: enabled)"
flag "--no-host" help="bypass host buffer allowing extra buffers to be used"
flag "--cache-type-k <TYPE>" help="KV cache data type for K allowed values: f32, f16, bf16, q8_0, q4_0, q4_1, iq4_nl, q5_0, q5_1 (default: f16)"
flag "--cache-type-v <TYPE>" help="KV cache data type for V allowed values: f32, f16, bf16, q8_0, q4_0, q4_1, iq4_nl, q5_0, q5_1 (default: f16)"
flag "--defrag-thold <N>" help="KV cache defragmentation threshold (DEPRECATED)"
flag "--cache-ram <N>" help="set the maximum cache size in MiB (default: 8192, -1 - no limit, 0 - disable)"
flag "--swa-full" help="use full-size SWA cache (default: false) info)](https://github.com/ggml-org/llama.cpp/pull/13194#issuecomment-2868343055)"
flag "--rpc <SERVERS>" help="comma-separated list of RPC servers (host:port)"
flag "--mlock" help="DEPRECATED in favor of `--load-mode`: force system to keep model in RAM rather than swapping or compressing"
flag "--mmap --no-mmap" help="DEPRECATED in favor of `--load-mode`: whether to memory-map model. (if mmap disabled, slower load but may reduce pageouts if not using mlock)"
flag "--load-mode <MODE>" help="model loading mode (default: auto) - auto: mmap, unless a device does not support it - none: no special loading mode - mmap: memory-map model (if mmap disabled, slower load but may reduce pageouts if not using mlock) - mlock: force system to keep model in RAM rather than swapping or compressing - mmap+mlock: mmap + force system to keep model in RAM rather than swapping or compressing - dio: use DirectIO if available"
flag "--lazy-mode <MODE>" help="on-demand reading of certain tensors, for example per-layer embeddings (default: auto) - on: read the rows of such tensors from disk on demand instead of keeping them resident (requires mmap) - auto: on, but only for tensors larger than 4 GiB - off: always keep them resident"
flag "--device <DEV1_DEV2>" help="comma-separated list of devices to use for offloading (none = don't offload) use --list-devices to see a list of available devices"
flag "--gpu-layers --n-gpu-layers <N>" help="max. number of layers to store in VRAM, either an exact number, 'auto', or 'all' (default: auto)"
flag "--tensor-split <N0_N1_N2>" help="fraction of the model to offload to each GPU, comma-separated list of proportions, e.g. 3,1"
flag "--main-gpu <INDEX>" help="the GPU to use for the model (with split-mode = none), or for intermediate results and KV (with split-mode = row) (default: 0)"
flag "--fit <ON_OFF>" help="whether to adjust unset arguments to fit in device memory ('on' or 'off', default: 'on')"
flag "--fit-ctx <N>" help="minimum ctx size that can be set by --fit option, default: 4096"
flag "--lora <FNAME>" help="path to LoRA adapter (use comma-separated values to load multiple adapters)"
flag "--lora-scaled <FNAME_SCALE>" help="path to LoRA adapter with user defined scaling (format: FNAME:SCALE,...) note: use comma-separated values"
flag "--control-vector <FNAME>" help="add a control vector note: use comma-separated values to add multiple control vectors"
flag "--control-vector-layer-range <START>" help="layer range to apply the control vector(s) to, start and end inclusive"
flag "--spec-draft-poll --poll-draft <N>" help="Use polling to wait for draft model work (default: same as --poll)"
flag "--spec-draft-n-max <N>" help="number of tokens to draft for speculative decoding (default: 3)"
flag "--spec-draft-n-min <N>" help="minimum number of draft tokens to use for speculative decoding (default: 0)"
flag "--spec-synth-len <L>" help="target mean synthetic acceptance length, including the target token (benchmarking only)"
flag "--spec-synth-rates <P0_P1>" help="comma-separated unconditional per-position synthetic acceptance probabilities (benchmarking only)"
flag "--spec-draft-p-split --draft-p-split <P>" help="speculative decoding split probability (default: 0.10)"
flag "--spec-draft-p-min --draft-p-min <P>" help="minimum speculative decoding probability (greedy) (default: 0.00)"
flag "--spec-draft-backend-sampling --no-spec-draft-backend-sampling" help="offload draft sampling to the backend (default: enabled)"
flag "--spec-type <NONE_DRAFT_SIMPLE_DRAFT_EAGLE3_DRAFT_MTP_DRAFT_DFLASH_DRAFT_DSPARK_NGRAM_SIMPLE_NGRAM_MAP_K_NGRAM_MAP_K4V_NGRAM_MOD_NGRAM_CACHE>" help="comma-separated list of types of speculative decoding to use (default: none)"
flag "--spec-ngram-mod-n-min <N>" help="minimum number of ngram tokens to use for ngram-based speculative decoding (default: 48)"
flag "--spec-ngram-mod-n-max <N>" help="maximum number of ngram tokens to use for ngram-based speculative decoding (default: 64)"
flag "--spec-ngram-mod-n-match <N>" help="ngram-mod lookup length (default: 24)"
flag "--spec-ngram-simple-size-n <N>" help="ngram size N for ngram-simple speculative decoding, length of lookup n-gram (default: 12)"
flag "--spec-ngram-simple-size-m <N>" help="ngram size M for ngram-simple speculative decoding, length of draft m-gram (default: 48)"
flag "--spec-ngram-simple-min-hits <N>" help="minimum hits for ngram-simple speculative decoding (default: 1)"
flag "--spec-ngram-map-k-size-n <N>" help="ngram size N for ngram-map-k speculative decoding, length of lookup n-gram (default: 12)"
flag "--spec-ngram-map-k-size-m <N>" help="ngram size M for ngram-map-k speculative decoding, length of draft m-gram (default: 48)"
flag "--spec-ngram-map-k-min-hits <N>" help="minimum hits for ngram-map-k speculative decoding (default: 1)"
flag "--spec-ngram-map-k4v-size-n <N>" help="ngram size N for ngram-map-k4v speculative decoding, length of lookup n-gram (default: 12)"
flag "--spec-ngram-map-k4v-size-m <N>" help="ngram size M for ngram-map-k4v speculative decoding, length of draft m-gram (default: 48)"
flag "--spec-ngram-map-k4v-min-hits <N>" help="minimum hits for ngram-map-k4v speculative decoding (default: 1)"
flag "--draft --draft-n --draft-max <N>" help="the argument has been removed. use --spec-draft-n-max or --spec-ngram-mod-n-max"
flag "--draft-min --draft-n-min <N>" help="the argument has been removed. use --spec-draft-n-min or --spec-ngram-mod-n-min"
flag "--samplers <SAMPLERS>" help="samplers that will be used for generation in the order, separated by"
flag "-s --seed <SEED>" help="RNG seed (default: -1, use random seed for -1)"
flag "--ignore-eos" help="ignore end of stream token and continue generating (implies --logit-bias EOS-inf)"
flag "--temp --temperature <N>" help="temperature (default: 0.80)"
flag "--top-k <N>" help="top-k sampling (default: 40, 0 = disabled)"
flag "--top-p <N>" help="top-p sampling (default: 0.95, 1.0 = disabled)"
flag "--min-p <N>" help="min-p sampling (default: 0.05, 0.0 = disabled)"
flag "--top-nsigma --top-n-sigma <N>" help="top-n-sigma sampling (default: -1.00, -1.0 = disabled)"
flag "--xtc-probability <N>" help="xtc probability (default: 0.00, 0.0 = disabled)"
flag "--xtc-threshold <N>" help="xtc threshold (default: 0.10, 1.0 = disabled)"
flag "--typical --typical-p <N>" help="locally typical sampling, parameter p (default: 1.00, 1.0 = disabled)"
flag "--repeat-last-n <N>" help="last n tokens to consider for penalize (default: 64, 0 = disabled)"
flag "--repeat-penalty <N>" help="penalize repeat sequence of tokens (default: 1.00, 1.0 = disabled)"
flag "--presence-penalty <N>" help="repeat alpha presence penalty (default: 0.00, 0.0 = disabled)"
flag "--frequency-penalty <N>" help="repeat alpha frequency penalty (default: 0.00, 0.0 = disabled)"
flag "--dry-multiplier <N>" help="set DRY sampling multiplier (default: 0.00, 0.0 = disabled)"
flag "--dry-base <N>" help="set DRY sampling base value (default: 1.75)"
flag "--dry-allowed-length <N>" help="set allowed length for DRY sampling (default: 2)"
flag "--dry-penalty-last-n <N>" help="set DRY penalty for the last n tokens (default: 64, 0 = disable)"
flag "--dry-sequence-breaker <STRING>" help="add sequence breaker for DRY sampling, clearing out default breakers ('\\n', ':', '\"', '*') in the process; use \"none\" to not use any sequence breakers"
flag "--adaptive-target <N>" help="adaptive-p: select tokens near this probability (valid range 0.0 to 1.0; negative = disabled) (default: -1.00)"
flag "--adaptive-decay <N>" help="adaptive-p: decay rate for target adaptation over time. lower values are more reactive, higher values are more stable. (valid range 0.0 to 0.99) (default: 0.90)"
flag "--dynatemp-range <N>" help="dynamic temperature range (default: 0.00, 0.0 = disabled)"
flag "--dynatemp-exp <N>" help="dynamic temperature exponent (default: 1.00)"
flag "--mirostat <N>" help="use Mirostat sampling. Top K, Nucleus and Locally Typical samplers are ignored if used. (default: 0, 0 = disabled, 1 = Mirostat, 2 = Mirostat 2.0)"
flag "--mirostat-lr <N>" help="Mirostat learning rate, parameter eta (default: 0.10)"
flag "--mirostat-ent <N>" help="Mirostat target entropy, parameter tau (default: 5.00)"
flag "-l --logit-bias <TOKEN_ID_BIAS>" help="modifies the likelihood of token appearing in the completion, i.e. `--logit-bias 15043+1` to increase likelihood of token ' Hello', or `--logit-bias 15043-1` to decrease likelihood of token ' Hello'"
flag "--grammar <GRAMMAR>" help="BNF-like grammar to constrain generations (see samples in grammars/ dir)"
flag "--grammar-file <FNAME>" help="file to read grammar from"
flag "-j --json-schema <SCHEMA>" help="JSON schema to constrain generations (https://json-schema.org/), e.g. `{}` for any JSON object For schemas w/ external $refs, use --grammar + example/json_schema_to_grammar.py instead"
flag "--json-schema-file <FILE>" help="File containing a JSON schema to constrain generations (https://json-schema.org/), e.g. `{}` for any JSON object For schemas w/ external $refs, use --grammar + example/json_schema_to_grammar.py instead"
flag "--backend-sampling" help="enable backend sampling (experimental) (default: disabled)"
flag "--mmproj <FILE>" help="path to a multimodal projector file. see tools/mtmd/README.md note: if -hf is used, this argument can be omitted"
flag "--mmproj-url <URL>" help="URL to a multimodal projector file. see tools/mtmd/README.md"
flag "--mmproj-offload --no-mmproj-offload" help="whether to enable GPU offloading for multimodal projector (default: enabled)"
flag "--mmproj-device <DEVICE>" help="device to use for multimodal projector (none = don't offload, default: follows --device) use --list-devices to see a list of available devices"
flag "--image --audio --video <FILE>" help="path to an image, audio, or video file. use with multimodal models, use comma-separated values for multiple files"
flag "--image-min-tokens <N>" help="minimum number of tokens each image can take, only used by vision models with dynamic resolution (default: read from model)"
flag "--image-max-tokens <N>" help="maximum number of tokens each image can take, only used by vision models with dynamic resolution (default: read from model)"
flag "--video-fps <N>" help="target video frame rate (default: 4.0)"
flag "--video-timestamp-interval <N>" help="interval in milliseconds between text timestamps (default: 5000)"
flag "--video-ffmpeg-dir <DIR>" help="path to the directory containing ffmpeg and ffprobe (default: search in PATH)"
flag "--reasoning <ON_OFF_AUTO>" help="Use reasoning/thinking in the chat ('on', 'off', or 'auto', default: 'auto' (detect from template))"
flag "--reasoning-effort <LEVEL>" help="reasoning effort level given to the chat template: 'default' to keep the template default, or a level such as 'minimal', 'low', 'medium', 'high', 'xhigh' or 'max' (default: default)"
flag "--reasoning-budget <N>" help="token budget for thinking: -1 for unrestricted, 0 for immediate end, N>0 for token budget (default: -1)"
flag "--reasoning-budget-message <MESSAGE>" help="message injected before the end-of-thinking tag when reasoning budget is exhausted (default: none)"
flag "--reasoning-preserve --no-reasoning-preserve" help="preserve reasoning trace in the full history, not just the last assistant message (default: enabled) compatible with certain templates having 'supports_preserve_reasoning' capability example: https://docs.z.ai/guides/capabilities/thinking-mode#preserved-thinking"
flag "-p --prompt <PROMPT>" help="prompt to start generation with; for system message, use -sys"
flag "-f --file <FNAME>" help="a file containing the prompt (default: none)"
flag "--binary-file <FNAME>" help="binary file containing the prompt (default: none)"
flag "--server-base <URL>" help="connect to this server instead of starting a new one, example: 'http://localhost:8080' (default: none)"
flag "--verbose-prompt" help="print a verbose prompt before generation (default: false)"
flag "--display-prompt --no-display-prompt" help="whether to print prompt at generation (default: true)"
flag "--color <ON_OFF_AUTO>" help="Colorize output to distinguish prompt and user input from generations ('on', 'off', or 'auto', default: 'auto') 'auto' enables colors when output is to a terminal"
flag "--system-prompt <PROMPT>" help="system prompt to use with model (if applicable, depending on chat template)"
flag "--show-timings --no-show-timings" help="whether to show timing information after each response (default: true)"
flag "-r --reverse-prompt <PROMPT>" help="halt generation at PROMPT, return control in interactive mode"
flag "--special" help="special tokens output enabled (default: false)"
flag "--single-turn" help="run conversation for a single turn only, then exit when done will not be interactive if first turn is predefined with --prompt (default: false)"
flag "--multiline-input" help="allows you to write or paste multiple lines without ending each in '\\'"
flag "--warmup --no-warmup" help="whether to perform warmup with an empty run (default: enabled)"
flag "--chat-template-kwargs <STRING>" help="sets additional params for the json template parser, must be a valid json object string, e.g. '{\"key1\":\"value1\",\"key2\":\"value2\"}'"
flag "--jinja --no-jinja" help="whether to use jinja template engine for chat (default: enabled)"
flag "--log-disable" help="Log disable"
flag "--log-file <FNAME>" help="Log to file"
flag "--log-jsonl --no-log-jsonl" help="Log as JSONL (one JSON object per line) to stdout, this also disables colored logging (default: disabled)"
flag "--log-colors <ON_OFF_AUTO>" help="Set colored logging ('on', 'off', or 'auto', default: 'auto') 'auto' enables colors when output is to a terminal"
flag "-v --verbose --log-verbose" help="Set verbosity level to infinity (i.e. log all messages, useful for debugging)"
flag "--offline" help="Offline mode: forces use of cache, prevents network access"
flag "--verbosity --log-verbosity <N>" help="Set the verbosity threshold. Messages with a higher verbosity will be ignored. Values: - 0: generic output - 1: error - 2: warning - 3: info - 4: trace (more info) - 5: debug (default: 1)"
flag "--log-prefix --no-log-prefix" help="Enable prefix in log messages"
flag "--log-timestamps --no-log-timestamps" help="Enable timestamps in log messages"
flag "--log-prompts-dir <PATH>" help="Log prompts to directory (auto-created if not present; only used for debugging, default: disabled)"
flag "--threads-batch <N>" help="number of threads to use during batch and prompt processing (default: same as --threads)"
flag "--cpu-range-batch <LO_HI>" help="ranges of CPUs for affinity. Complements --cpu-mask-batch"
flag "--flash-attn <ON_OFF_AUTO>" help="set Flash Attention use ('on', 'off', or 'auto', default: 'auto')"
flag "--kv-offload --no-kv-offload" help="whether to enable KV cache offloading (default: enabled)"
flag "--direct-io --no-direct-io" help="DEPRECATED in favor of `--load-mode`: use DirectIO if available"
flag "--numa <TYPE>" help="attempt optimizations that help on some NUMA systems - distribute: spread execution evenly over all nodes - isolate: only spawn threads on CPUs on the node that execution started on - numactl: use the CPU map provided by numactl if run without this previously, it is recommended to drop the system page cache before using this see https://github.com/ggml-org/llama.cpp/issues/1437"
flag "--list-devices" help="print list of available devices and exit"
flag "--split-mode <NONE_LAYER_ROW_TENSOR>" help="how to split the model across multiple GPUs, one of: - none: use one GPU only - layer (default): split layers and KV across GPUs (pipelined) - row: split weight across GPUs by rows (parallelized) - tensor: split weights and KV across GPUs (parallelized, EXPERIMENTAL)"
flag "--fit-target <MIB0_MIB1_MIB2>" help="target margin per device for --fit, comma-separated list of values, single value is broadcast across all devices, default: 1024"
flag "--control-vector-scaled <FNAME_SCALE>" help="add a control vector with user defined scaling SCALE note: use comma-separated values (format: FNAME:SCALE,...)"
flag "--docker-repo <REPO_MODEL_QUANT>" help="Docker Hub model repository. repo is optional, default to ai/. quant is optional, default to :latest. example: gemma3 (default: unused)"
flag "--hf-repo <USER_MODEL_QUANT>" help="Hugging Face model repository; quant is optional, case-insensitive, default to Q4_K_M, or falls back to the first file in the repo if Q4_K_M doesn't exist. mmproj is also downloaded automatically if available. to disable, add --no-mmproj example: ggml-org/GLM-4.7-Flash-GGUF:Q4_K_M (default: unused)"
flag "--spec-draft-type-k --cache-type-k-draft <TYPE>" help="KV cache data type for K for the draft model allowed values: f32, f16, bf16, q8_0, q4_0, q4_1, iq4_nl, q5_0, q5_1 (default: f16)"
flag "--spec-draft-type-v --cache-type-v-draft <TYPE>" help="KV cache data type for V for the draft model allowed values: f32, f16, bf16, q8_0, q4_0, q4_1, iq4_nl, q5_0, q5_1 (default: f16)"
flag "--sampler-seq --sampling-seq <SEQUENCE>" help="simplified sequence for samplers that will be used (default: edskypmxt)"
flag "--spec-draft-hf --hf-repo-draft <USER_MODEL_QUANT>" help="Same as --hf-repo, but for the draft model (default: unused)"
flag "--spec-draft-threads --threads-draft <N>" help="number of threads to use during generation (default: same as --threads)"
flag "--spec-draft-threads-batch --threads-batch-draft <N>" help="number of threads to use during batch and prompt processing (default: same as --threads-draft)"
flag "--spec-draft-cpu-mask --cpu-mask-draft <M>" help="Draft model CPU affinity mask. Complements cpu-range-draft (default: same as --cpu-mask)"
flag "--spec-draft-cpu-range --cpu-range-draft <LO_HI>" help="Ranges of CPUs for affinity. Complements --cpu-mask-draft"
flag "--spec-draft-cpu-strict --cpu-strict-draft <N>" help="Use strict CPU placement for draft model (default: same as --cpu-strict)"
flag "--spec-draft-prio --prio-draft <N>" help="set draft process/thread priority : 0-normal, 1-medium, 2-high, 3-realtime (default: 0)"
flag "--spec-draft-cpu-mask-batch --cpu-mask-batch-draft <M>" help="Draft model CPU affinity mask. Complements cpu-range-draft (default: same as --cpu-mask)"
flag "--spec-draft-cpu-strict-batch --cpu-strict-batch-draft <N>" help="Use strict CPU placement for draft model (default: --cpu-strict-draft)"
flag "--spec-draft-prio-batch --prio-batch-draft <N>" help="set draft process/thread priority : 0-normal, 1-medium, 2-high, 3-realtime (default: 0)"
flag "--spec-draft-poll-batch --poll-batch-draft <N>" help="Use polling to wait for draft model work (default: --poll-draft)"
flag "--spec-draft-cpu-moe --cpu-moe-draft" help="keep all Mixture of Experts (MoE) weights in the CPU for the draft model"
flag "--spec-draft-n-cpu-moe --spec-draft-ncmoe --n-cpu-moe-draft <N>" help="keep the Mixture of Experts (MoE) weights of the first N layers in the CPU for the draft model"
flag "--spec-draft-device --device-draft <DEV1_DEV2>" help="comma-separated list of devices to use for offloading the draft model (none = don't offload, default: follows --device) use --list-devices to see a list of available devices"
flag "--spec-draft-ngl --gpu-layers-draft --n-gpu-layers-draft <N>" help="max. number of draft model layers to store in VRAM, either an exact number, 'auto', or 'all' (default: auto)"
flag "--spec-draft-model --model-draft <FNAME>" help="draft model for speculative decoding (default: unused)"
flag "--ctx-checkpoints --swa-checkpoints <N>" help="max number of context checkpoints to create per slot (default: 32)"
flag "--context-shift --no-context-shift" help="whether to use context shift on infinite text generation (default: disabled)"
flag "--system-prompt-file <FNAME>" help="a file containing the system prompt (default: none)"
flag "--mmproj-auto --no-mmproj --no-mmproj-auto" help="whether to use multimodal projector file (if available), useful when using -hf (default: enabled)"
flag "-o --output --output-file <FNAME>" help="output file (default: '')"
flag "--reasoning-format <FORMAT>" help="controls whether thought tags are allowed and/or extracted from the response, and in which format they're returned; one of: - none: leaves thoughts unparsed in `message.content` - deepseek: puts thoughts in `message.reasoning_content` - deepseek-legacy: keeps `<think>` tags in `message.content` while also populating `message.reasoning_content` (default: auto)"
flag "--chat-template <JINJA_TEMPLATE>" help="set custom jinja chat template (default: template taken from model's metadata) if suffix/prefix are specified, template will be disabled only commonly used templates are accepted (unless --jinja is set before this flag): list of built-in templates: bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
flag "--chat-template-file <JINJA_TEMPLATE_FILE>" help="set custom jinja chat template file (default: template taken from model's metadata) if suffix/prefix are specified, template will be disabled only commonly used templates are accepted (unless --jinja is set before this flag): list of built-in templates: bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
flag "--skip-chat-parsing --no-skip-chat-parsing" help="force a pure content parser, even if a Jinja template is specified; model will output everything in the content section, including any reasoning and/or tool calls (default: disabled)"
flag "--simple-io" help="use basic IO for better compatibility in subprocesses and limited consoles"
