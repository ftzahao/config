name "LLaMA Quantize (English)"
bin "llama-quantize"
about "GGUF 模型量化工具"
version "0.5.0-dev"
flag "--help" help=""

flag "--allow-requantize" help="allow requantizing tensors that have already been quantized WARNING: this can severely reduce quality compared to quantizing from 16bit or 32bit!"
flag "--leave-output-tensor" help="leave output.weight un(re)quantized increases model size but may also increase quality, especially when requantizing"
flag "--pure" help="disable k-quant mixtures and quantize all tensors to the same type"
flag "--imatrix <FILE_NAME>" help="use data in file_name as importance matrix for quant optimizations"
flag "--include-weights <TENSOR_NAME>" help="use importance matrix for this/these tensor(s)"
flag "--exclude-weights <TENSOR_NAME>" help="do not use importance matrix for this/these tensor(s)"
flag "--output-tensor-type <GGML_TYPE>" help="use this ggml_type for the output.weight tensor"
flag "--token-embedding-type <GGML_TYPE>" help="use this ggml_type for the token embeddings tensor"
flag "--tensor-type <TENSOR_NAME_GGML_TYPE>" help="quantize this tensor to this ggml_type this is an advanced option to selectively quantize tensors. may be specified multiple times. example: --tensor-type attn_q=q8_0"
flag "--tensor-type-file <TENSOR_TYPES_TXT>" help="list of tensors to quantize to a specific ggml_type this is an advanced option to selectively quantize a long list of tensors. the file should use the same format as above, separated by spaces or newlines."
flag "--prune-layers <L0_L1_L2>" help="comma-separated list of layer numbers to prune from the model WARNING: this is an advanced option, use with care."
flag "--keep-split" help="generate quantized model in the same shards as input"
flag "--override-kv <KEY_TYPE_VALUE>" help="override model metadata by key in the quantized model. may be specified multiple times. WARNING: this is an advanced option, use with care."
flag "--dry-run" help="calculate and show the final quantization size without performing quantization example: llama-quantize --dry-run model-f32.gguf Q4_K"
flag "--max-buffer-size <MIB>" help="max amount of tensor rows kept in memory while quantizing one tensor (default: 8192) lower it to quantize models with very large tensors on a machine with little RAM"
