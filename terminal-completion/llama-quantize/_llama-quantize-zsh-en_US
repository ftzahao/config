#compdef llama-quantize
# @generated by usage-cli from llama-quantize/usage.kdl
local curcontext="$curcontext"

_llama_quantize() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in llama-quantize." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_llama_quantize.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "LLaMA Quantize (English)"
bin llama-quantize
version "0.5.0-dev"
about "GGUF 模型量化工具"
flag --help help=""
flag --allow-requantize help="allow requantizing tensors that have already been quantized WARNING: this can severely reduce quality compared to quantizing from 16bit or 32bit!"
flag --leave-output-tensor help="leave output.weight un(re)quantized increases model size but may also increase quality, especially when requantizing"
flag --pure help="disable k-quant mixtures and quantize all tensors to the same type"
flag --imatrix help="use data in file_name as importance matrix for quant optimizations" {
    arg <FILE_NAME>
}
flag --include-weights help="use importance matrix for this/these tensor(s)" {
    arg <TENSOR_NAME>
}
flag --exclude-weights help="do not use importance matrix for this/these tensor(s)" {
    arg <TENSOR_NAME>
}
flag --output-tensor-type help="use this ggml_type for the output.weight tensor" {
    arg <GGML_TYPE>
}
flag --token-embedding-type help="use this ggml_type for the token embeddings tensor" {
    arg <GGML_TYPE>
}
flag --tensor-type help="quantize this tensor to this ggml_type this is an advanced option to selectively quantize tensors. may be specified multiple times. example: --tensor-type attn_q=q8_0" {
    arg <TENSOR_NAME_GGML_TYPE>
}
flag --tensor-type-file help="list of tensors to quantize to a specific ggml_type this is an advanced option to selectively quantize a long list of tensors. the file should use the same format as above, separated by spaces or newlines." {
    arg <TENSOR_TYPES_TXT>
}
flag --prune-layers help="comma-separated list of layer numbers to prune from the model WARNING: this is an advanced option, use with care." {
    arg <L0_L1_L2>
}
flag --keep-split help="generate quantized model in the same shards as input"
flag --override-kv help="override model metadata by key in the quantized model. may be specified multiple times. WARNING: this is an advanced option, use with care." {
    arg <KEY_TYPE_VALUE>
}
flag --dry-run help="calculate and show the final quantization size without performing quantization example: llama-quantize --dry-run model-f32.gguf Q4_K"
flag --max-buffer-size help="max amount of tensor rows kept in memory while quantizing one tensor (default: 8192) lower it to quantize models with very large tensors on a machine with little RAM" {
    arg <MIB>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line usage_err=
  while IFS= read -r line; do
    if [[ "$line" == $'\x1f'* ]]; then
      usage_err="${line#?}"
      continue
    fi
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(
    { _usage_err="$(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}" 2>&1 >&3 3>&-)"; } 3>&1
    (( $? )) || _usage_err=
    for _usage_l in "${(@f)_usage_err}"; do
      [[ "$_usage_l" == \[[A-Z]*\]* ]] && continue
      _usage_l="${_usage_l#"${_usage_l%%[![:space:]]*}"}"
      _usage_l="${_usage_l#Error:}"
      _usage_l="${_usage_l#"${_usage_l%%[![:space:]]*}"}"
      _usage_l="${_usage_l#× }"
      [[ -z "$_usage_l" || ( "$_usage_l" == *::* && "$_usage_l" != *' '* ) ]] && continue
      print -r -- $'\x1f'"$_usage_l"
      break
    done
  )
  [[ -n "$usage_err" ]] && _message -r "usage: ${usage_err//\%/%%}"
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_llama_quantize" ]; then
    _llama_quantize "$@"
else
    compdef _llama_quantize llama-quantize
fi

