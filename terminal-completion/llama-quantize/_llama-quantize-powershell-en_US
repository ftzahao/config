flag --include-weights help="use importance matrix for this/these tensor(s)" {
    arg <TENSOR_NAME>
}
flag --exclude-weights help="do not use importance matrix for this/these tensor(s)" {
    arg <TENSOR_NAME>
}
flag --output-tensor-type help="use this ggml_type for the output.weight tensor" {
    arg <GGML_TYPE>
