name "LLaMA Quantize (中文)"
bin "llama-quantize"
about "GGUF 模型量化工具"
version "0.5.0-dev"
flag "--help" help=""

flag "--allow-requantize" help="允许对已量化的张量重新量化 ⚠️ 警告：与从 16bit 或 32bit 量化相比，这可能会严重降低质量"
flag "--leave-output-tensor" help="保持 output.weight 不进行重新量化 会增大模型体积，但可能提升质量（尤其是重新量化时）"
flag "--pure" help="禁用 k-quant 混合，将所有张量量化为同一类型"
flag "--imatrix <FILE_NAME>" help="在量化优化中使用 file_name 文件中的数据作为重要性矩阵"
flag "--include-weights <TENSOR_NAME>" help="对这些张量使用重要性矩阵"
flag "--exclude-weights <TENSOR_NAME>" help="不对这些张量使用重要性矩阵"
flag "--output-tensor-type <GGML_TYPE>" help="对 output.weight 张量使用此 ggml_type"
flag "--token-embedding-type <GGML_TYPE>" help="对 token 嵌入张量使用此 ggml_type"
flag "--tensor-type <TENSOR_NAME_GGML_TYPE>" help="将此张量量化为此 ggml_type 这是选择性量化张量的高级选项，可多次指定。示例：--tensor-type attn_q=q8_0"
flag "--tensor-type-file <TENSOR_TYPES_TXT>" help="要量化到指定 ggml_type 的张量列表 这是选择性量化大量张量的高级选项，文件格式与上述相同，以空格或换行分隔。"
flag "--prune-layers <L0_L1_L2>" help="要从模型中修剪的层号列表（逗号分隔）⚠️ 警告：高级选项，请谨慎使用。"
flag "--keep-split" help="按与输入相同的分片生成量化模型"
flag "--override-kv <KEY_TYPE_VALUE>" help="在量化模型中按 key 覆盖模型元数据，可多次指定 ⚠️ 警告：高级选项，请谨慎使用。"
flag "--dry-run" help="计算并显示最终量化大小而不执行量化 示例：llama-quantize --dry-run model-f32.gguf Q4_K"
flag "--max-buffer-size <MIB>" help="量化单个张量时保留在内存中的最大张量行数（默认：8192）在内存较小的机器上量化含超大张量的模型时可调低此值"
