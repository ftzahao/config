'##
    def llama_server_completer [spans: list<string>] {
        let spec_dir = ($env.XDG_CACHE_HOME? | default ($nu.home-dir? | default $nu.home-path? | path join ".cache") | path join "usage")
        if not ($spec_dir | path exists) {
            mkdir $spec_dir
            if $nu.os-info.family != "windows" { ^chmod 0700 $spec_dir }
        }
        let spec_file = ($spec_dir | path join $"usage__usage_spec_llama_server.spec")
        $_usage_spec_llama_server | save -f $spec_file

        (^usage complete-word -f $spec_file --shell nu -- ...$spans)
        | lines
        | each {|it| $it | split column "\t" | rename value description | into record }
    }

    @complete llama_server_completer
    export extern llama-server []
}


# if "usage" is not installed show an error
if (which usage | is-empty) {
    return (error make {
        msg: "Error: usage CLI not found. This is required for completions to work in llama-server.",
        help: "See https://usage.jdx.dev for more information."
    })
}
