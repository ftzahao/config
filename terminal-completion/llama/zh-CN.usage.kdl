  flag "--binary-file <FNAME>" help="包含提示词的二进制文件（默认：无）"
  flag "-e --escape --no-escape" help="whether to process escapes sequences (\\\\n, \\\\r, \\\\t, \\\\', \\\\\", \\\\\\\\) (default: true)"
