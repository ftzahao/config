  flag "--dry-allowed-length <N>" help="DRY 采样允许长度（默认：2）"
  flag "--dry-penalty-last-n <N>" help="最近 n 个 token 的 DRY 惩罚（默认：64，禁用）"
  flag "--dry-sequence-breaker <STRING>" help="添加 DRY 采样的序列中断器"
  flag "--adaptive-target <N>" help="adaptive-p: select tokens near this probability (valid range 0.0 to 1.0; negative = disabled) (default: -1.00)"
  flag "--adaptive-decay <N>" help="adaptive-p: decay rate for target adaptation over time. lower values are more reactive, higher values are more stable. (valid range 0.0 to 0.99) (default: 0.90)"
  flag "--dynatemp-range <N>" help="动态温度范围（默认：0.00，禁用）"
  flag "--dynatemp-exp <N>" help="动态温度指数（默认：1.00）"
  flag "--mirostat <N>" help="使用 Mirostat 采样（默认：0，禁用）"
  flag "--mirostat-lr <N>" help="Mirostat 学习率（默认：0.10）"
  flag "--mirostat-ent <N>" help="Mirostat 目标熵（默认：5.00）"
  flag "-l --logit-bias <TOKEN_ID(+_-)BIAS>" help="modifies the likelihood of token appearing in the completion, i.e. `--logit-bias 15043+1` to increase likelihood of token ' Hello', or `--logit-bias 15043-1` to decrease likelihood of token ' Hello'"
  flag "--grammar <GRAMMAR>" help="用于约束生成的 BNF 风格语法"
  flag "--grammar-file <FNAME>" help="语法文件路径"
  flag "-j --json-schema <SCHEMA>" help="用于约束生成的 JSON Schema"
  flag "--json-schema-file <FILE>" help="包含 JSON Schema 的文件"
  flag "--backend-sampling" help="启用后端采样（实验性，默认：禁用）"
  flag "--fit-print <ON_OFF>" help="打印预估所需内存（'on' 或 'off'，默认：'off'）"
}

cmd "quantize" help="量化模型" {
  flag "--allow-requantize" help=""
  flag "--leave-output-tensor" help=""
  flag "--pure" help=""
  flag "--imatrix <FILE_NAME>" help=""
  flag "--include-weights <TENSOR_NAME>" help=""
  flag "--exclude-weights <TENSOR_NAME>" help=""
  flag "--output-tensor-type <GGML_TYPE>" help=""
  flag "--token-embedding-type <GGML_TYPE>" help=""
  flag "--tensor-type <TENSOR_NAME_GGML_TYPE>" help=""
  flag "--tensor-type-file <TENSOR_TYPES_TXT>" help=""
  flag "--prune-layers <L0_L1_L2>" help=""
  flag "--keep-split" help=""
  flag "--override-kv <KEY_TYPE_VALUE>" help=""
  flag "--dry-run" help=""
  flag "--max-buffer-size <MIB>" help=""
}

cmd "perplexity" help="计算模型困惑度与 KL 散度" {
  flag "-h --help --usage" help="打印用法并退出"
  flag "--version" help="显示版本和构建信息"
  flag "--cache-list" help="列出缓存中的模型"
  flag "--completion-bash" help="输出可 source 的 bash 补全脚本"
  flag "-t --threads <N>" help="生成时使用的 CPU 线程数（默认：-1）"
  flag "-C --cpu-mask <M>" help="CPU 亲和性掩码：任意长度十六进制。与 cpu-range 互补（默认：\"\")"
  flag "--cpu-range <LO_HI>" help="CPU 亲和性范围。与 --cpu-mask 互补"
  flag "--cpu-strict <N>" help="使用严格的 CPU 放置（默认：0）"
  flag "--prio <N>" help="设置进程/线程优先级：low(-1), normal(0), medium(1), high(2), realtime(3)（默认：0）"
  flag "--poll <0_100>" help="使用轮询级别等待工作（0 - 不轮询，默认：50）"
  flag "--cpu-mask-batch <M>" help="批处理 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--cpu-strict-batch <N>" help="使用严格的 CPU 放置（默认：与 --cpu-strict 相同）"
  flag "--prio-batch <N>" help="设置进程/线程优先级：0-normal, 1-medium, 2-high, 3-realtime（默认：0）"
  flag "--poll-batch <N>" help="使用轮询等待工作（默认：与 --poll 相同）"
  flag "-c --ctx-size <N>" help="提示词上下文大小（默认：512，0 = 从模型加载）"
  flag "-n --predict --n-predict <N>" help="预测的 token 数量（默认：-1，-1 = 无限）"
  flag "-b --batch-size <N>" help="逻辑最大批处理大小（默认：2048）"
  flag "--ubatch-size <N>" help="物理最大批处理大小（默认：512）"
  flag "--keep <N>" help="从初始提示词中保留的 token 数（默认：0，-1 = 全部）"
  flag "--perf --no-perf" help="whether to enable internal libllama performance timings (default: false)"
  flag "-e --escape --no-escape" help="whether to process escapes sequences (\\n, \\r, \\t, \\', \\\", \\\\) (default: false)"
  flag "--parallel <N>" help="并行解码的序列数（默认：1）"
  flag "--override-tensor <TENSOR>" help="覆盖张量缓冲区类型"
  flag "--cpu-moe" help="将所有 MoE 权重保留在 CPU 中"
  flag "--n-cpu-moe <N>" help="将前 N 层的 MoE 权重保留在 CPU 中"
  flag "--n-cpu-ffn <N>" help="将前 N 层的密集 FFN 权重保留在 CPU 中"
  flag "--check-tensors" help="检查模型张量数据中的无效值（默认：false）"
  flag "--override-kv <KEY_TYPE_VALUE>" help="按键覆盖模型元数据的高级选项"
  flag "--op-offload --no-op-offload" help="是否将主机张量操作卸载到设备（默认：true）"
  flag "-m --model <FNAME>" help="要加载的模型路径"
  flag "--model-url <MODEL_URL>" help="模型下载 URL（默认：未使用）"
  flag "--hf-file <FILE>" help="Hugging Face model file. If specified, it will override the quant in --hf-repo (default: unused)"
  flag "--hf-token <TOKEN>" help="Hugging Face access token (default: value from HF_TOKEN environment variable)"
  flag "--rope-scaling <NONE_LINEAR_YARN>" help="RoPE 频率缩放方法（默认：linear）"
  flag "--rope-scale <N>" help="RoPE 上下文缩放因子"
  flag "--rope-freq-base <N>" help="RoPE 基础频率（默认：从模型加载）"
  flag "--rope-freq-scale <N>" help="RoPE 频率缩放因子"
  flag "--yarn-orig-ctx <N>" help="YaRN：模型原始上下文大小（默认：0 = 模型训练上下文大小）"
  flag "--yarn-ext-factor <N>" help="YaRN：外推混合因子（默认：-1.00）"
  flag "--yarn-attn-factor <N>" help="YaRN：缩放 sqrt(t) 或注意力幅度（默认：-1.00）"
  flag "--yarn-beta-slow <N>" help="YaRN：高修正维度或 alpha（默认：-1.00）"
  flag "--yarn-beta-fast <N>" help="YaRN：低修正维度或 beta（默认：-1.00）"
  flag "--repack --no-repack" help="是否启用权重重打包（默认：启用）"
  flag "--no-host" help="绕过主机缓冲区以允许使用额外缓冲区"
  flag "--cache-type-k <TYPE>" help="K 的 KV 缓存数据类型（默认：f16）"
  flag "--cache-type-v <TYPE>" help="V 的 KV 缓存数据类型（默认：f16）"
  flag "--defrag-thold <N>" help="KV 缓存碎片整理阈值（已弃用）"
  flag "--swa-full" help="use full-size SWA cache (default: false) info)](https://github.com/ggml-org/llama.cpp/pull/13194#issuecomment-2868343055)"
  flag "--rpc <SERVERS>" help="RPC 服务器列表，逗号分隔（host:port）"
  flag "--mlock" help="DEPRECATED in favor of `--load-mode`: force system to keep model in RAM rather than swapping or compressing"
  flag "--mmap --no-mmap" help="DEPRECATED in favor of `--load-mode`: whether to memory-map model. (if mmap disabled, slower load but may reduce pageouts if not using mlock)"
  flag "--load-mode <MODE>" help="模型加载模式（默认：auto）"
  flag "--lazy-mode <MODE>" help="按需读取特定张量（默认：auto）"
  flag "--device <DEV1_DEV2>" help="用于卸载的设备列表，逗号分隔（none = 不卸载）"
  flag "--gpu-layers --n-gpu-layers <N>" help="存储在显存中的最大层数，精确数字、'auto' 或 'all'（默认：auto）"
  flag "--tensor-split <N0_N1_N2>" help="各 GPU 卸载比例，逗号分隔，如 3,1"
  flag "--main-gpu <INDEX>" help="用于模型的 GPU（默认：0）"
  flag "--fit <ON_OFF>" help="是否自动调整参数以适应显存（默认：on）"
  flag "--fit-ctx <N>" help="可由 --fit 设置的最小上下文大小（默认：4096）"
  flag "--lora <FNAME>" help="LoRA 适配器路径（逗号分隔可加载多个）"
  flag "--lora-scaled <FNAME_SCALE>" help="带缩放系数的 LoRA 适配器路径（格式：FNAME:SCALE,...）"
  flag "--control-vector <FNAME>" help="添加控制向量（逗号分隔可添加多个）"
  flag "--control-vector-layer-range <START>" help="应用控制向量的层范围（含首尾）"
  flag "--samplers <SAMPLERS>" help="按顺序使用的采样器，用分号分隔"
  flag "-s --seed <SEED>" help="随机数种子（默认：-1，-1 为随机）"
  flag "--ignore-eos" help="忽略流结束 token 并继续生成"
  flag "--temp --temperature <N>" help="温度（默认：0.80）"
  flag "--top-k <N>" help="top-k 采样（默认：40，0 = 禁用）"
  flag "--top-p <N>" help="top-p 采样（默认：0.95，1.0 = 禁用）"
  flag "--min-p <N>" help="min-p 采样（默认：0.05，0.0 = 禁用）"
  flag "--top-nsigma --top-n-sigma <N>" help="top-n-sigma 采样（默认：-1.00，禁用）"
  flag "--xtc-probability <N>" help="XTC 概率（默认：0.00，禁用）"
  flag "--xtc-threshold <N>" help="XTC 阈值（默认：0.10，禁用）"
  flag "--typical --typical-p <N>" help="局部典型采样（默认：1.00，禁用）"
  flag "--repeat-last-n <N>" help="考虑惩罚的最近 token 数（默认：64，禁用）"
  flag "--repeat-penalty <N>" help="重复 token 惩罚（默认：1.00，禁用）"
  flag "--presence-penalty <N>" help="重复存在惩罚（默认：0.00，禁用）"
  flag "--frequency-penalty <N>" help="重复频率惩罚（默认：0.00，禁用）"
  flag "--dry-multiplier <N>" help="DRY 采样乘数（默认：0.00，禁用）"
  flag "--dry-base <N>" help="DRY 采样基础值（默认：1.75）"
  flag "--dry-allowed-length <N>" help="DRY 采样允许长度（默认：2）"
  flag "--dry-penalty-last-n <N>" help="最近 n 个 token 的 DRY 惩罚（默认：64，禁用）"
  flag "--dry-sequence-breaker <STRING>" help="添加 DRY 采样的序列中断器"
  flag "--adaptive-target <N>" help="adaptive-p: select tokens near this probability (valid range 0.0 to 1.0; negative = disabled) (default: -1.00)"
  flag "--adaptive-decay <N>" help="adaptive-p: decay rate for target adaptation over time. lower values are more reactive, higher values are more stable. (valid range 0.0 to 0.99) (default: 0.90)"
  flag "--dynatemp-range <N>" help="动态温度范围（默认：0.00，禁用）"
  flag "--dynatemp-exp <N>" help="动态温度指数（默认：1.00）"
  flag "--mirostat <N>" help="使用 Mirostat 采样（默认：0，禁用）"
  flag "--mirostat-lr <N>" help="Mirostat 学习率（默认：0.10）"
  flag "--mirostat-ent <N>" help="Mirostat 目标熵（默认：5.00）"
  flag "-l --logit-bias <TOKEN_ID_BIAS>" help="modifies the likelihood of token appearing in the completion, i.e. `--logit-bias 15043+1` to increase likelihood of token ' Hello', or `--logit-bias 15043-1` to decrease likelihood of token ' Hello'"
  flag "--grammar <GRAMMAR>" help="用于约束生成的 BNF 风格语法"
  flag "--grammar-file <FNAME>" help="语法文件路径"
  flag "-j --json-schema <SCHEMA>" help="用于约束生成的 JSON Schema"
  flag "--json-schema-file <FILE>" help="包含 JSON Schema 的文件"
  flag "--backend-sampling" help="启用后端采样（实验性，默认：禁用）"
  flag "-p --prompt <PROMPT>" help="起始生成的提示词；系统消息请用 -sys"
  flag "-f --file <FNAME>" help="包含提示词的文件（默认：无）"
  flag "--binary-file <FNAME>" help="包含提示词的二进制文件（默认：无）"
  flag "--warmup --no-warmup" help="是否用空运行进行预热（默认：启用）"
  flag "--chunks <N>" help="处理的最大块数（默认：-1，全部）"
  flag "--hellaswag" help="计算 HellaSwag 分数"
  flag "--hellaswag-tasks <N>" help="计算 HellaSwag 分数的任务数（默认：400）"
  flag "--winogrande" help="计算 Winogrande 分数"
  flag "--winogrande-tasks <N>" help="计算 Winogrande 分数的任务数"
  flag "--multiple-choice" help="计算多选题分数"
  flag "--multiple-choice-tasks <N>" help="计算多选题分数的任务数（默认：0）"
  flag "--kl-divergence" help="计算 KL 散度"
  flag "--ppl-stride <N>" help="困惑度计算步幅（默认：0）"
  flag "--ppl-output-type <N>" help="困惑度计算输出类型（默认：0）"
  flag "--log-disable" help="禁用日志"
  flag "--log-file <FNAME>" help="日志输出到文件"
  flag "--log-jsonl --no-log-jsonl" help="以 JSONL 格式记录日志（默认：禁用）"
  flag "--log-colors <ON_OFF_AUTO>" help="设置彩色日志（默认：auto）"
  flag "-v --verbose --log-verbose" help="设置最大详细级别（用于调试）"
  flag "--offline" help="离线模式：强制使用缓存，禁止网络访问"
  flag "--verbosity --log-verbosity <N>" help="详细级别阈值（默认：3，0=通用输出, 1=错误, 2=警告, 3=信息, 4=跟踪, 5=调试）"
  flag "--log-prefix --no-log-prefix" help="在日志消息中启用前缀"
  flag "--log-timestamps --no-log-timestamps" help="在日志消息中启用时间戳"
  flag "--threads-batch <N>" help="批处理和提示词处理的线程数（默认：与 --threads 相同）"
  flag "--cpu-range-batch <LO_HI>" help="批处理 CPU 亲和性范围。与 --cpu-mask-batch 互补"
  flag "--flash-attn <ON_OFF_AUTO>" help="set Flash Attention use ('on', 'off', or 'auto', default: 'auto')"
  flag "--kv-offload --no-kv-offload" help="是否启用 KV 缓存卸载（默认：启用）"
  flag "--direct-io --no-direct-io" help="DEPRECATED in favor of `--load-mode`: use DirectIO if available"
  flag "--numa <TYPE>" help="attempt optimizations that help on some NUMA systems - distribute: spread execution evenly over all nodes - isolate: only spawn threads on CPUs on the node that execution started on - numactl: use the CPU map provided by numactl if run without this previously, it is recommended to drop the system page cache before using this see https://github.com/ggml-org/llama.cpp/issues/1437"
  flag "--list-devices" help="列出可用设备并退出"
  flag "--split-mode <NONE_LAYER_ROW_TENSOR>" help="多 GPU 模型分割方式（默认：layer）"
  flag "--fit-target <MIB0_MIB1_MIB2>" help="每个设备的目标余量（MiB），默认：1024"
  flag "--control-vector-scaled <FNAME_SCALE>" help="添加带缩放的控制向量（格式：FNAME:SCALE,...）"
  flag "--docker-repo <REPO_MODEL_QUANT>" help="Docker Hub model repository. repo is optional, default to ai/. quant is optional, default to :latest. example: gemma3 (default: unused)"
  flag "--hf-repo <USER_MODEL_QUANT>" help="Hugging Face model repository; quant is optional, case-insensitive, default to Q4_K_M, or falls back to the first file in the repo if Q4_K_M doesn't exist. mmproj is also downloaded automatically if available. to disable, add --no-mmproj example: ggml-org/GLM-4.7-Flash-GGUF:Q4_K_M (default: unused)"
  flag "--spec-draft-type-k --cache-type-k-draft <TYPE>" help="草稿模型 K 的 KV 缓存数据类型（默认：f16）"
  flag "--spec-draft-type-v --cache-type-v-draft <TYPE>" help="草稿模型 V 的 KV 缓存数据类型（默认：f16）"
  flag "--sampler-seq --sampling-seq <SEQUENCE>" help="采样器的简化序列（默认：edskypmxt）"
  flag "--kv-unified --no-kv-unified" help="使用跨所有序列共享的统一 KV 缓冲区"
  flag "--context-shift --no-context-shift" help="whether to use context shift on infinite text generation (default: disabled)"
  flag "--save-all-logits --kl-divergence-base <FNAME>" help="设置 logits 文件"
}

