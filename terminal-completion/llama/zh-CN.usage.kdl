name "llama (中文)"
bin "llama"
version "0.4.0-dev"
about "llama.cpp 多工具启动器"
flag "-h --help --usage" help="打印用法并退出"
flag "--version" help="显示版本与构建信息"

cmd "serve" help="HTTP API 服务器" {
  flag "-h --help --usage" help="打印用法并退出"
  flag "--version" help="显示版本和构建信息"
  flag "--cache-list" help="列出缓存中的模型"
  flag "--completion-bash" help="输出可 source 的 bash 补全脚本"
  flag "-t --threads <N>" help="生成时使用的 CPU 线程数（默认：-1）"
  flag "-C --cpu-mask <M>" help="CPU 亲和性掩码：任意长度十六进制。与 cpu-range 互补（默认：\"\")"
  flag "--cpu-range <LO_HI>" help="CPU 亲和性范围。与 --cpu-mask 互补"
  flag "--cpu-strict <N>" help="使用严格的 CPU 放置（默认：0）"
  flag "--prio <N>" help="设置进程/线程优先级：low(-1), normal(0), medium(1), high(2), realtime(3)（默认：0）"
  flag "--poll <0_100>" help="使用轮询级别等待工作（0 - 不轮询，默认：50）"
  flag "--cpu-mask-batch <M>" help="批处理 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--cpu-strict-batch <N>" help="使用严格的 CPU 放置（默认：与 --cpu-strict 相同）"
  flag "--prio-batch <N>" help="设置进程/线程优先级：0-normal, 1-medium, 2-high, 3-realtime（默认：0）"
  flag "--poll-batch <N>" help="使用轮询等待工作（默认：与 --poll 相同）"
  flag "-c --ctx-size <N>" help="提示词上下文大小（默认：0，0 = 从模型加载）"
  flag "-n --predict --n-predict <N>" help="预测的 token 数量（默认：-1，-1 = 无限）"
  flag "-b --batch-size <N>" help="逻辑最大批处理大小（默认：2048）"
  flag "--ubatch-size <N>" help="物理最大批处理大小（默认：512）"
  flag "--keep <N>" help="从初始提示词中保留的 token 数（默认：0，-1 = 全部）"
  flag "--perf --no-perf" help="whether to enable internal libllama performance timings (default: false)"
  flag "-e --escape --no-escape" help="whether to process escapes sequences (\\n, \\r, \\t, \\', \\\", \\\\) (default: true)"
  flag "--override-tensor <TENSOR>" help="覆盖张量缓冲区类型"
  flag "--cpu-moe" help="将所有 MoE 权重保留在 CPU 中"
  flag "--n-cpu-moe <N>" help="将前 N 层的 MoE 权重保留在 CPU 中"
  flag "--n-cpu-ffn <N>" help="将前 N 层的密集 FFN 权重保留在 CPU 中"
  flag "--check-tensors" help="检查模型张量数据中的无效值（默认：false）"
  flag "--override-kv <KEY_TYPE_VALUE>" help="按键覆盖模型元数据的高级选项"
  flag "--op-offload --no-op-offload" help="是否将主机张量操作卸载到设备（默认：true）"
  flag "-m --model <FNAME>" help="要加载的模型路径"
  flag "--model-url <MODEL_URL>" help="模型下载 URL（默认：未使用）"
  flag "--hf-file <FILE>" help="Hugging Face model file. If specified, it will override the quant in --hf-repo (default: unused)"
  flag "--hf-token <TOKEN>" help="Hugging Face access token (default: value from HF_TOKEN environment variable)"
  flag "--spec-draft-override-tensor --override-tensor-draft <TENSOR>" help="覆盖草稿模型的张量缓冲区类型"
  flag "--embd-gemma-default" help="使用默认 EmbeddingGemma 模型（可能从网络下载权重）"
  flag "--fim-qwen-1.5b-default" help="使用默认 Qwen 2.5 Coder 1.5B（可能从网络下载权重）"
  flag "--fim-qwen-3b-default" help="使用默认 Qwen 2.5 Coder 3B（可能从网络下载权重）"
  flag "--fim-qwen-7b-default" help="使用默认 Qwen 2.5 Coder 7B（可能从网络下载权重）"
  flag "--fim-qwen-7b-spec" help="使用 Qwen 2.5 Coder 7B + 0.5B draft 投机解码（可能从网络下载权重）"
  flag "--fim-qwen-14b-spec" help="使用 Qwen 2.5 Coder 14B + 0.5B draft 投机解码（可能从网络下载权重）"
  flag "--fim-qwen-30b-default" help="使用默认 Qwen 3 Coder 30B A3B Instruct（可能从网络下载权重）"
  flag "--gpt-oss-20b-default" help="使用 gpt-oss-20b（可能从网络下载权重）"
  flag "--gpt-oss-120b-default" help="使用 gpt-oss-120b（可能从网络下载权重）"
  flag "--vision-gemma-4b-default" help="使用 Gemma 3 4B QAT（可能从网络下载权重）"
  flag "--vision-gemma-12b-default" help="使用 Gemma 3 12B QAT（可能从网络下载权重）"
  flag "--spec-default" help="启用默认投机解码配置"
  flag "--rope-scaling <NONE_LINEAR_YARN>" help="RoPE 频率缩放方法（默认：linear）"
  flag "--rope-scale <N>" help="RoPE 上下文缩放因子"
  flag "--rope-freq-base <N>" help="RoPE 基础频率（默认：从模型加载）"
  flag "--rope-freq-scale <N>" help="RoPE 频率缩放因子"
  flag "--yarn-orig-ctx <N>" help="YaRN：模型原始上下文大小（默认：0 = 模型训练上下文大小）"
  flag "--yarn-ext-factor <N>" help="YaRN：外推混合因子（默认：-1.00）"
  flag "--yarn-attn-factor <N>" help="YaRN：缩放 sqrt(t) 或注意力幅度（默认：-1.00）"
  flag "--yarn-beta-slow <N>" help="YaRN：高修正维度或 alpha（默认：-1.00）"
  flag "--yarn-beta-fast <N>" help="YaRN：低修正维度或 beta（默认：-1.00）"
  flag "--repack --no-repack" help="是否启用权重重打包（默认：启用）"
  flag "--no-host" help="绕过主机缓冲区以允许使用额外缓冲区"
  flag "--cache-type-k <TYPE>" help="K 的 KV 缓存数据类型（默认：f16）"
  flag "--cache-type-v <TYPE>" help="V 的 KV 缓存数据类型（默认：f16）"
  flag "--defrag-thold <N>" help="KV 缓存碎片整理阈值（已弃用）"
  flag "--kv-unified-per-slot <N>" help="每个并行槽位的上下文限制"
  flag "--checkpoint-min-step <N>" help="上下文检查点的最小间距（默认：8192）"
  flag "--cache-ram <N>" help="set the maximum cache size in MiB (default: 8192, -1 - no limit, 0 - disable)"
  flag "--cache-prompt --no-cache-prompt" help="是否启用提示词缓存（默认：启用）"
  flag "--cache-reuse <N>" help="min chunk size to attempt reusing from the cache via KV shifting, requires prompt caching to be enabled (default: 0)"
  flag "--swa-full" help="use full-size SWA cache (default: false) info)](https://github.com/ggml-org/llama.cpp/pull/13194#issuecomment-2868343055)"
  flag "--rpc <SERVERS>" help="RPC 服务器列表，逗号分隔（host:port）"
  flag "--mlock" help="DEPRECATED in favor of `--load-mode`: force system to keep model in RAM rather than swapping or compressing"
  flag "--mmap --no-mmap" help="DEPRECATED in favor of `--load-mode`: whether to memory-map model. (if mmap disabled, slower load but may reduce pageouts if not using mlock)"
  flag "--load-mode <MODE>" help="模型加载模式（默认：auto）"
  flag "--lazy-mode <MODE>" help="按需读取特定张量（默认：auto）"
  flag "--device <DEV1_DEV2>" help="用于卸载的设备列表，逗号分隔（none = 不卸载）"
  flag "--gpu-layers --n-gpu-layers <N>" help="存储在显存中的最大层数，精确数字、'auto' 或 'all'（默认：auto）"
  flag "--tensor-split <N0_N1_N2>" help="各 GPU 卸载比例，逗号分隔，如 3,1"
  flag "--main-gpu <INDEX>" help="用于模型的 GPU（默认：0）"
  flag "--fit <ON_OFF>" help="是否自动调整参数以适应显存（默认：on）"
  flag "--fit-ctx <N>" help="可由 --fit 设置的最小上下文大小（默认：4096）"
  flag "--lora <FNAME>" help="LoRA 适配器路径（逗号分隔可加载多个）"
  flag "--lora-scaled <FNAME_SCALE>" help="带缩放系数的 LoRA 适配器路径（格式：FNAME:SCALE,...）"
  flag "--control-vector <FNAME>" help="添加控制向量（逗号分隔可添加多个）"
  flag "--control-vector-layer-range <START>" help="应用控制向量的层范围（含首尾）"
  flag "--lora-init-without-apply" help="load LoRA adapters without applying them (apply later via POST /lora-adapters) (default: disabled)"
  flag "--spec-draft-poll --poll-draft <N>" help="草稿模型轮询等待（默认：与 --poll 相同）"
  flag "--spec-draft-n-max <N>" help="投机解码的草稿 token 数（默认：3）"
  flag "--spec-draft-n-min <N>" help="投机解码的最小草稿 token 数（默认：0）"
  flag "--spec-synth-len <L>" help="target mean synthetic acceptance length, including the target token (benchmarking only)"
  flag "--spec-synth-rates <P0_P1>" help="comma-separated unconditional per-position synthetic acceptance probabilities (benchmarking only)"
  flag "--spec-draft-p-split --draft-p-split <P>" help="投机解码分割概率（默认：0.10）"
  flag "--spec-draft-p-min --draft-p-min <P>" help="投机解码最小概率（贪心，默认：0.00）"
  flag "--spec-draft-backend-sampling --no-spec-draft-backend-sampling" help="将草稿采样卸载到后端（默认：启用）"
  flag "--spec-type <NONE_DRAFT_SIMPLE_DRAFT_EAGLE3_DRAFT_MTP_DRAFT_DFLASH_DRAFT_DSPARK_NGRAM_SIMPLE_NGRAM_MAP_K_NGRAM_MAP_K4V_NGRAM_MOD_NGRAM_CACHE>" help="投机解码类型列表，逗号分隔（默认：none）"
  flag "--spec-ngram-mod-n-min <N>" help="基于 n-gram 投机解码的最小 token 数（默认：48）"
  flag "--spec-ngram-mod-n-max <N>" help="基于 n-gram 投机解码的最大 token 数（默认：64）"
  flag "--spec-ngram-mod-n-match <N>" help="ngram-mod 查找长度（默认：24）"
  flag "--spec-ngram-simple-size-n <N>" help="ngram-simple 查找 n-gram 长度（默认：12）"
  flag "--spec-ngram-simple-size-m <N>" help="ngram-simple 草稿 m-gram 长度（默认：48）"
  flag "--spec-ngram-simple-min-hits <N>" help="ngram-simple 最小命中数（默认：1）"
  flag "--spec-ngram-map-k-size-n <N>" help="ngram-map-k 查找 n-gram 长度（默认：12）"
  flag "--spec-ngram-map-k-size-m <N>" help="ngram-map-k 草稿 m-gram 长度（默认：48）"
  flag "--spec-ngram-map-k-min-hits <N>" help="ngram-map-k 最小命中数（默认：1）"
  flag "--spec-ngram-map-k4v-size-n <N>" help="ngram-map-k4v 查找 n-gram 长度（默认：12）"
  flag "--spec-ngram-map-k4v-size-m <N>" help="ngram-map-k4v 草稿 m-gram 长度（默认：48）"
  flag "--spec-ngram-map-k4v-min-hits <N>" help="ngram-map-k4v 最小命中数（默认：1）"
  flag "--draft --draft-n --draft-max <N>" help="the argument has been removed. use --spec-draft-n-max or --spec-ngram-mod-n-max"
  flag "--draft-min --draft-n-min <N>" help="the argument has been removed. use --spec-draft-n-min or --spec-ngram-mod-n-min"
  flag "--spec-ngram-size-n <N>" help="the argument has been removed. use the respective --spec-ngram-*-size-n or --spec-ngram-mod-n-match"
  flag "--spec-ngram-size-m <N>" help="the argument has been removed. use the respective --spec-ngram-*-size-m"
  flag "--spec-ngram-min-hits <N>" help="the argument has been removed. use the respective --spec-ngram-*-min-hits"
  flag "--samplers <SAMPLERS>" help="按顺序使用的采样器，用分号分隔"
  flag "-s --seed <SEED>" help="随机数种子（默认：-1，-1 为随机）"
  flag "--ignore-eos" help="忽略流结束 token 并继续生成"
  flag "--temp --temperature <N>" help="温度（默认：0.80）"
  flag "--top-k <N>" help="top-k 采样（默认：40，0 = 禁用）"
  flag "--top-p <N>" help="top-p 采样（默认：0.95，1.0 = 禁用）"
  flag "--min-p <N>" help="min-p 采样（默认：0.05，0.0 = 禁用）"
  flag "--top-nsigma --top-n-sigma <N>" help="top-n-sigma 采样（默认：-1.00，禁用）"
  flag "--xtc-probability <N>" help="XTC 概率（默认：0.00，禁用）"
  flag "--xtc-threshold <N>" help="XTC 阈值（默认：0.10，禁用）"
  flag "--typical --typical-p <N>" help="局部典型采样（默认：1.00，禁用）"
  flag "--repeat-last-n <N>" help="考虑惩罚的最近 token 数（默认：64，禁用）"
  flag "--repeat-penalty <N>" help="重复 token 惩罚（默认：1.00，禁用）"
  flag "--presence-penalty <N>" help="重复存在惩罚（默认：0.00，禁用）"
  flag "--frequency-penalty <N>" help="重复频率惩罚（默认：0.00，禁用）"
  flag "--dry-multiplier <N>" help="DRY 采样乘数（默认：0.00，禁用）"
  flag "--dry-base <N>" help="DRY 采样基础值（默认：1.75）"
  flag "--dry-allowed-length <N>" help="DRY 采样允许长度（默认：2）"
  flag "--dry-penalty-last-n <N>" help="最近 n 个 token 的 DRY 惩罚（默认：64，禁用）"
  flag "--dry-sequence-breaker <STRING>" help="添加 DRY 采样的序列中断器"
  flag "--adaptive-target <N>" help="adaptive-p: select tokens near this probability (valid range 0.0 to 1.0; negative = disabled) (default: -1.00)"
  flag "--adaptive-decay <N>" help="adaptive-p: decay rate for target adaptation over time. lower values are more reactive, higher values are more stable. (valid range 0.0 to 0.99) (default: 0.90)"
  flag "--dynatemp-range <N>" help="动态温度范围（默认：0.00，禁用）"
  flag "--dynatemp-exp <N>" help="动态温度指数（默认：1.00）"
  flag "--mirostat <N>" help="使用 Mirostat 采样（默认：0，禁用）"
  flag "--mirostat-lr <N>" help="Mirostat 学习率（默认：0.10）"
  flag "--mirostat-ent <N>" help="Mirostat 目标熵（默认：5.00）"
  flag "-l --logit-bias <TOKEN_ID_BIAS>" help="modifies the likelihood of token appearing in the completion, i.e. `--logit-bias 15043+1` to increase likelihood of token ' Hello', or `--logit-bias 15043-1` to decrease likelihood of token ' Hello'"
  flag "--grammar <GRAMMAR>" help="用于约束生成的 BNF 风格语法"
  flag "--grammar-file <FNAME>" help="语法文件路径"
  flag "-j --json-schema <SCHEMA>" help="用于约束生成的 JSON Schema"
  flag "--json-schema-file <FILE>" help="包含 JSON Schema 的文件"
  flag "--backend-sampling" help="启用后端采样（实验性，默认：禁用）"
  flag "--mmproj <FILE>" help="多模态投影器文件路径"
  flag "--mmproj-url <URL>" help="多模态投影器文件 URL"
  flag "--mmproj-offload --no-mmproj-offload" help="是否为多模态投影器启用 GPU 卸载（默认：启用）"
  flag "--mmproj-device <DEVICE>" help="多模态投影器使用的设备"
  flag "--image-min-tokens <N>" help="每张图像的最小 token 数（仅用于动态分辨率的视觉模型）"
  flag "--image-max-tokens <N>" help="每张图像的最大 token 数（仅用于动态分辨率的视觉模型）"
  flag "--mtmd-batch-max-tokens <N>" help="编码图像时每批最大图像 token 数（默认：1024）"
  flag "--video-fps <N>" help="目标视频帧率（默认：4.0）"
  flag "--video-timestamp-interval <N>" help="文本时间戳之间的间隔（毫秒，默认：5000）"
  flag "--video-ffmpeg-dir <DIR>" help="ffmpeg 和 ffprobe 所在目录路径（默认：在 PATH 中搜索）"
  flag "--reasoning <ON_OFF_AUTO>" help="在对话中使用推理/思考（默认：auto）"
  flag "--reasoning-effort <LEVEL>" help="推理努力级别（默认：default）"
  flag "--reasoning-budget <N>" help="思考的 token 预算（默认：-1，无限制）"
  flag "--reasoning-budget-message <MESSAGE>" help="推理预算耗尽时注入的消息（默认：无）"
  flag "--reasoning-preserve --no-reasoning-preserve" help="preserve reasoning trace in the full history, not just the last assistant message (default: enabled) compatible with certain templates having 'supports_preserve_reasoning' capability example: https://docs.z.ai/guides/capabilities/thinking-mode#preserved-thinking"
  flag "--parallel <N>" help="服务器槽位数（默认：-1，自动）"
  flag "--host <HOST>" help="监听 IP 地址（默认：127.0.0.1）"
  flag "--port <PORT>" help="监听端口（默认：8080）"
  flag "--reuse-port" help="允许多个 socket 绑定到同一端口（默认：禁用）"
  flag "--path <PATH>" help="静态文件服务路径"
  flag "--cors-origins <ORIGINS>" help="CORS 允许的来源列表（默认：*）"
  flag "--cors-methods <METHODS>" help="CORS 允许的方法列表（默认：GET, POST, DELETE, OPTIONS）"
  flag "--cors-headers <HEADERS>" help="CORS 允许的头部列表（默认：*）"
  flag "--api-prefix <PREFIX>" help="服务器提供服务的前缀路径"
  flag "--tools <TOOL1_TOOL2>" help="实验性：为 AI 代理启用内置工具（默认：禁用）"
  flag "--tools-runtime <OPTION>" help="实验性：在独立运行时环境中运行工具（默认：无）"
  flag "--mcp-servers-config <PATH>" help="实验性：MCP 服务器定义 JSON 文件路径（默认：无）"
  flag "--mcp-servers-json <JSON>" help="实验性：内联 MCP 服务器定义 JSON（默认：无）"
  flag "--agent --no-agent" help="是否启用 CORS 代理和所有内置工具（默认：禁用）"
  flag "--ui --webui --no-ui --no-webui" help="是否启用 Web UI（默认：启用）"
  flag "--embedding --embeddings" help="仅支持嵌入用例（默认：禁用）"
  flag "--rerank --reranking" help="启用服务器重排序端点（默认：禁用）"
  flag "--api-key <KEY>" help="用于身份验证的 API 密钥"
  flag "--api-key-file <FNAME>" help="包含 API 密钥的文件路径"
  flag "--ssl-key-file <FNAME>" help="PEM 编码的 SSL 私钥文件路径"
  flag "--ssl-cert-file <FNAME>" help="PEM 编码的 SSL 证书文件路径"
  flag "--timeout <N>" help="服务器读写超时（秒，默认：3600）"
  flag "--sse-ping-interval <N>" help="服务器 SSE 心跳间隔（秒，默认：30）"
  flag "--threads-http <N>" help="处理 HTTP 请求的线程数（默认：-1）"
  flag "--metrics" help="启用 Prometheus 兼容的指标端点（默认：禁用）"
  flag "--props" help="启用通过 POST /props 更改全局属性（默认：禁用）"
  flag "--slots --no-slots" help="暴露槽位监控端点（默认：启用）"
  flag "--slot-save-path <PATH>" help="保存槽位 KV 缓存的路径（默认：禁用）"
  flag "--media-path <PATH>" help="加载本地媒体文件的目录（默认：禁用）"
  flag "--models-dir <PATH>" help="路由器服务器的模型目录（默认：禁用）"
  flag "--models-preset <PATH>" help="路由器服务器模型预设 INI 文件路径（默认：禁用）"
  flag "--models-max <N>" help="路由器服务器同时加载的最大模型数（默认：4，0 = 无限制）"
  flag "--models-autoload --no-models-autoload" help="路由器服务器是否自动加载模型（默认：启用）"
  flag "--sleep-idle-seconds <SECONDS>" help="服务器空闲休眠秒数（默认：-1，禁用）"
  flag "-r --reverse-prompt <PROMPT>" help="在 PROMPT 处停止生成，交互模式下返回控制权"
  flag "--special" help="启用特殊 token 输出（默认：false）"
  flag "--warmup --no-warmup" help="是否用空运行进行预热（默认：启用）"
  flag "--chat-template-kwargs <STRING>" help="设置 JSON 模板解析器的额外参数"
  flag "--jinja --no-jinja" help="是否使用 Jinja 模板引擎（默认：启用）"
  flag "--log-disable" help="禁用日志"
  flag "--log-file <FNAME>" help="日志输出到文件"
  flag "--log-jsonl --no-log-jsonl" help="以 JSONL 格式记录日志（默认：禁用）"
  flag "--log-colors <ON_OFF_AUTO>" help="设置彩色日志（默认：auto）"
  flag "-v --verbose --log-verbose" help="设置最大详细级别（用于调试）"
  flag "--offline" help="离线模式：强制使用缓存，禁止网络访问"
  flag "--verbosity --log-verbosity <N>" help="详细级别阈值（默认：3，0=通用输出, 1=错误, 2=警告, 3=信息, 4=跟踪, 5=调试）"
  flag "--log-prefix --no-log-prefix" help="在日志消息中启用前缀"
  flag "--log-timestamps --no-log-timestamps" help="在日志消息中启用时间戳"
  flag "--log-prompts-dir <PATH>" help="将提示词记录到目录（仅用于调试，默认：禁用）"
  flag "--threads-batch <N>" help="批处理和提示词处理的线程数（默认：与 --threads 相同）"
  flag "--cpu-range-batch <LO_HI>" help="批处理 CPU 亲和性范围。与 --cpu-mask-batch 互补"
  flag "--flash-attn <ON_OFF_AUTO>" help="set Flash Attention use ('on', 'off', or 'auto', default: 'auto')"
  flag "--kv-offload --no-kv-offload" help="是否启用 KV 缓存卸载（默认：启用）"
  flag "--direct-io --no-direct-io" help="DEPRECATED in favor of `--load-mode`: use DirectIO if available"
  flag "--numa <TYPE>" help="attempt optimizations that help on some NUMA systems - distribute: spread execution evenly over all nodes - isolate: only spawn threads on CPUs on the node that execution started on - numactl: use the CPU map provided by numactl if run without this previously, it is recommended to drop the system page cache before using this see https://github.com/ggml-org/llama.cpp/issues/1437"
  flag "--list-devices" help="列出可用设备并退出"
  flag "--split-mode <NONE_LAYER_ROW_TENSOR>" help="多 GPU 模型分割方式（默认：layer）"
  flag "--fit-target <MIB0_MIB1_MIB2>" help="每个设备的目标余量（MiB），默认：1024"
  flag "--control-vector-scaled <FNAME_SCALE>" help="添加带缩放的控制向量（格式：FNAME:SCALE,...）"
  flag "--docker-repo <REPO_MODEL_QUANT>" help="Docker Hub model repository. repo is optional, default to ai/. quant is optional, default to :latest. example: gemma3 (default: unused)"
  flag "--hf-repo <USER_MODEL_QUANT>" help="Hugging Face model repository; quant is optional, case-insensitive, default to Q4_K_M, or falls back to the first file in the repo if Q4_K_M doesn't exist. mmproj is also downloaded automatically if available. to disable, add --no-mmproj example: ggml-org/GLM-4.7-Flash-GGUF:Q4_K_M (default: unused)"
  flag "--spec-draft-type-k --cache-type-k-draft <TYPE>" help="草稿模型 K 的 KV 缓存数据类型（默认：f16）"
  flag "--spec-draft-type-v --cache-type-v-draft <TYPE>" help="草稿模型 V 的 KV 缓存数据类型（默认：f16）"
  flag "--sampler-seq --sampling-seq <SEQUENCE>" help="采样器的简化序列（默认：edskypmxt）"
  flag "--spec-draft-hf --hf-repo-draft <USER_MODEL_QUANT>" help="与 --hf-repo 相同，但用于草稿模型（默认：未使用）"
  flag "--spec-draft-threads --threads-draft <N>" help="草稿模型生成时的线程数（默认：与 --threads 相同）"
  flag "--spec-draft-threads-batch --threads-batch-draft <N>" help="草稿模型批处理的线程数（默认：与 --threads-draft 相同）"
  flag "--spec-draft-cpu-mask --cpu-mask-draft <M>" help="草稿模型 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--spec-draft-cpu-range --cpu-range-draft <LO_HI>" help="草稿模型 CPU 亲和性范围"
  flag "--spec-draft-cpu-strict --cpu-strict-draft <N>" help="草稿模型严格 CPU 放置（默认：与 --cpu-strict 相同）"
  flag "--spec-draft-prio --prio-draft <N>" help="set draft process/thread priority : 0-normal, 1-medium, 2-high, 3-realtime (default: 0)"
  flag "--spec-draft-cpu-mask-batch --cpu-mask-batch-draft <M>" help="草稿模型 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--spec-draft-cpu-strict-batch --cpu-strict-batch-draft <N>" help="草稿模型严格 CPU 放置（默认：与 --cpu-strict-draft 相同）"
  flag "--spec-draft-prio-batch --prio-batch-draft <N>" help="草稿模型进程/线程优先级（默认：0）"
  flag "--spec-draft-poll-batch --poll-batch-draft <N>" help="草稿模型轮询等待（默认：与 --poll-draft 相同）"
  flag "--spec-draft-cpu-moe --cpu-moe-draft" help="将草稿模型的所有 MoE 权重保留在 CPU 中"
  flag "--spec-draft-n-cpu-moe --spec-draft-ncmoe --n-cpu-moe-draft <N>" help="将草稿模型前 N 层的 MoE 权重保留在 CPU 中"
  flag "--spec-draft-device --device-draft <DEV1_DEV2>" help="草稿模型卸载设备列表（默认：跟随 --device）"
  flag "--spec-draft-ngl --gpu-layers-draft --n-gpu-layers-draft <N>" help="草稿模型显存层数（默认：auto）"
  flag "--spec-draft-model --model-draft <FNAME>" help="投机解码草稿模型（默认：未使用）"
  flag "--lookup-cache-static <FNAME>" help="path to static lookup cache to use for lookup decoding (not updated by generation)"
  flag "--lookup-cache-dynamic <FNAME>" help="path to dynamic lookup cache to use for lookup decoding (updated by generation)"
  flag "--ctx-checkpoints --swa-checkpoints <N>" help="max number of context checkpoints to create per slot (default: 32)"
  flag "--kv-unified --no-kv-unified" help="使用跨所有序列共享的统一 KV 缓冲区"
  flag "--cache-idle-slots --no-cache-idle-slots" help="空闲槽位保存到提示词缓存（默认：启用）"
  flag "--context-shift --no-context-shift" help="whether to use context shift on infinite text generation (default: disabled)"
  flag "--spm-infill" help="use Suffix/Prefix/Middle pattern for infill (instead of Prefix/Suffix/Middle) as some models prefer this. (default: disabled)"
  flag "--pooling <NONE_MEAN_CLS_LAST_RANK>" help="嵌入池化类型（默认：使用模型默认）"
  flag "--cont-batching --no-cont-batching" help="是否启用连续批处理（默认：启用）"
  flag "--mmproj-auto --no-mmproj --no-mmproj-auto" help="是否使用多模态投影器文件（默认：启用）"
  flag "-a --alias <STRING>" help="设置模型名称别名，逗号分隔（供 API 使用）"
  flag "--tags <STRING>" help="设置模型标签，逗号分隔（仅信息，不用于路由）"
  flag "--embd-normalize <N>" help="嵌入归一化（默认：2）"
  flag "--cors-credentials --no-cors-credentials" help="是否允许 CORS 凭证（默认：启用）"
  flag "--ui-config --webui-config <JSON>" help="JSON that provides default UI settings (overrides UI defaults)"
  flag "--ui-config-file --webui-config-file <PATH>" help="JSON file that provides default UI settings (overrides UI defaults)"
  flag "--ui-mcp-proxy --webui-mcp-proxy --no-ui-mcp-proxy --no-webui-mcp-proxy" help="实验性：是否启用 MCP CORS 代理（默认：禁用）"
  flag "--reasoning-format <FORMAT>" help="controls whether thought tags are allowed and/or extracted from the response, and in which format they're returned; one of: - none: leaves thoughts unparsed in `message.content` - deepseek: puts thoughts in `message.reasoning_content` - deepseek-legacy: keeps `<think>` tags in `message.content` while also populating `message.reasoning_content` (default: auto)"
  flag "--chat-template <JINJA_TEMPLATE>" help="set custom jinja chat template (default: template taken from model's metadata) if suffix/prefix are specified, template will be disabled only commonly used templates are accepted (unless --jinja is set before this flag): list of built-in templates: bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
  flag "--chat-template-file <JINJA_TEMPLATE_FILE>" help="set custom jinja chat template file (default: template taken from model's metadata) if suffix/prefix are specified, template will be disabled only commonly used templates are accepted (unless --jinja is set before this flag): list of built-in templates: bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
  flag "--skip-chat-parsing --no-skip-chat-parsing" help="force a pure content parser, even if a Jinja template is specified; model will output everything in the content section, including any reasoning and/or tool calls (default: disabled)"
  flag "--prefill-assistant --no-prefill-assistant" help="是否预填充助手响应（默认：启用）"
  flag "--slot-prompt-similarity <SIMILARITY>" help="请求与槽位的匹配阈值（默认：0.10）"
}

cmd "cli" help="命令行交互界面" {
  flag "-h --help --usage" help="打印用法并退出"
  flag "--version" help="显示版本和构建信息"
  flag "--cache-list" help="列出缓存中的模型"
  flag "--completion-bash" help="输出可 source 的 bash 补全脚本"
  flag "-t --threads <N>" help="生成时使用的 CPU 线程数（默认：-1）"
  flag "-C --cpu-mask <M>" help="CPU 亲和性掩码：任意长度十六进制。与 cpu-range 互补（默认：\"\")"
  flag "--cpu-range <LO_HI>" help="CPU 亲和性范围。与 --cpu-mask 互补"
  flag "--cpu-strict <N>" help="使用严格的 CPU 放置（默认：0）"
  flag "--prio <N>" help="设置进程/线程优先级：low(-1), normal(0), medium(1), high(2), realtime(3)（默认：0）"
  flag "--poll <0_100>" help="使用轮询级别等待工作（0 - 不轮询，默认：50）"
  flag "--cpu-mask-batch <M>" help="批处理 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--cpu-strict-batch <N>" help="使用严格的 CPU 放置（默认：与 --cpu-strict 相同）"
  flag "--prio-batch <N>" help="设置进程/线程优先级：0-normal, 1-medium, 2-high, 3-realtime（默认：0）"
  flag "--poll-batch <N>" help="使用轮询等待工作（默认：与 --poll 相同）"
  flag "-c --ctx-size <N>" help="提示词上下文大小（默认：0，0 = 从模型加载）"
  flag "-n --predict --n-predict <N>" help="预测的 token 数量（默认：-1，-1 = 无限）"
  flag "-b --batch-size <N>" help="逻辑最大批处理大小（默认：2048）"
  flag "--ubatch-size <N>" help="物理最大批处理大小（默认：512）"
  flag "--keep <N>" help="从初始提示词中保留的 token 数（默认：0，-1 = 全部）"
  flag "--perf --no-perf" help="whether to enable internal libllama performance timings (default: false)"
  flag "-e --escape --no-escape" help="whether to process escapes sequences (\\n, \\r, \\t, \\', \\\", \\\\) (default: true)"
  flag "--parallel <N>" help="并行解码的序列数（默认：1）"
  flag "--override-tensor <TENSOR>" help="覆盖张量缓冲区类型"
  flag "--cpu-moe" help="将所有 MoE 权重保留在 CPU 中"
  flag "--n-cpu-moe <N>" help="将前 N 层的 MoE 权重保留在 CPU 中"
  flag "--n-cpu-ffn <N>" help="将前 N 层的密集 FFN 权重保留在 CPU 中"
  flag "--check-tensors" help="检查模型张量数据中的无效值（默认：false）"
  flag "--override-kv <KEY_TYPE_VALUE>" help="按键覆盖模型元数据的高级选项"
  flag "--op-offload --no-op-offload" help="是否将主机张量操作卸载到设备（默认：true）"
  flag "-m --model <FNAME>" help="要加载的模型路径"
  flag "--model-url <MODEL_URL>" help="模型下载 URL（默认：未使用）"
  flag "--hf-file <FILE>" help="Hugging Face model file. If specified, it will override the quant in --hf-repo (default: unused)"
  flag "--hf-token <TOKEN>" help="Hugging Face access token (default: value from HF_TOKEN environment variable)"
  flag "--spec-draft-override-tensor --override-tensor-draft <TENSOR>" help="覆盖草稿模型的张量缓冲区类型"
  flag "--gpt-oss-20b-default" help="使用 gpt-oss-20b（可能从网络下载权重）"
  flag "--gpt-oss-120b-default" help="使用 gpt-oss-120b（可能从网络下载权重）"
  flag "--vision-gemma-4b-default" help="使用 Gemma 3 4B QAT（可能从网络下载权重）"
  flag "--vision-gemma-12b-default" help="使用 Gemma 3 12B QAT（可能从网络下载权重）"
  flag "--spec-default" help="启用默认投机解码配置"
  flag "--rope-scaling <NONE_LINEAR_YARN>" help="RoPE 频率缩放方法（默认：linear）"
  flag "--rope-scale <N>" help="RoPE 上下文缩放因子"
  flag "--rope-freq-base <N>" help="RoPE 基础频率（默认：从模型加载）"
  flag "--rope-freq-scale <N>" help="RoPE 频率缩放因子"
  flag "--yarn-orig-ctx <N>" help="YaRN：模型原始上下文大小（默认：0 = 模型训练上下文大小）"
  flag "--yarn-ext-factor <N>" help="YaRN：外推混合因子（默认：-1.00）"
  flag "--yarn-attn-factor <N>" help="YaRN：缩放 sqrt(t) 或注意力幅度（默认：-1.00）"
  flag "--yarn-beta-slow <N>" help="YaRN：高修正维度或 alpha（默认：-1.00）"
  flag "--yarn-beta-fast <N>" help="YaRN：低修正维度或 beta（默认：-1.00）"
  flag "--repack --no-repack" help="是否启用权重重打包（默认：启用）"
  flag "--no-host" help="绕过主机缓冲区以允许使用额外缓冲区"
  flag "--cache-type-k <TYPE>" help="K 的 KV 缓存数据类型（默认：f16）"
  flag "--cache-type-v <TYPE>" help="V 的 KV 缓存数据类型（默认：f16）"
  flag "--defrag-thold <N>" help="KV 缓存碎片整理阈值（已弃用）"
  flag "--cache-ram <N>" help="set the maximum cache size in MiB (default: 8192, -1 - no limit, 0 - disable)"
  flag "--swa-full" help="use full-size SWA cache (default: false) info)](https://github.com/ggml-org/llama.cpp/pull/13194#issuecomment-2868343055)"
  flag "--rpc <SERVERS>" help="RPC 服务器列表，逗号分隔（host:port）"
  flag "--mlock" help="DEPRECATED in favor of `--load-mode`: force system to keep model in RAM rather than swapping or compressing"
  flag "--mmap --no-mmap" help="DEPRECATED in favor of `--load-mode`: whether to memory-map model. (if mmap disabled, slower load but may reduce pageouts if not using mlock)"
  flag "--load-mode <MODE>" help="模型加载模式（默认：auto）"
  flag "--lazy-mode <MODE>" help="按需读取特定张量（默认：auto）"
  flag "--device <DEV1_DEV2>" help="用于卸载的设备列表，逗号分隔（none = 不卸载）"
  flag "--gpu-layers --n-gpu-layers <N>" help="存储在显存中的最大层数，精确数字、'auto' 或 'all'（默认：auto）"
  flag "--tensor-split <N0_N1_N2>" help="各 GPU 卸载比例，逗号分隔，如 3,1"
  flag "--main-gpu <INDEX>" help="用于模型的 GPU（默认：0）"
  flag "--fit <ON_OFF>" help="是否自动调整参数以适应显存（默认：on）"
  flag "--fit-ctx <N>" help="可由 --fit 设置的最小上下文大小（默认：4096）"
  flag "--lora <FNAME>" help="LoRA 适配器路径（逗号分隔可加载多个）"
  flag "--lora-scaled <FNAME_SCALE>" help="带缩放系数的 LoRA 适配器路径（格式：FNAME:SCALE,...）"
  flag "--control-vector <FNAME>" help="添加控制向量（逗号分隔可添加多个）"
  flag "--control-vector-layer-range <START>" help="应用控制向量的层范围（含首尾）"
  flag "--spec-draft-poll --poll-draft <N>" help="草稿模型轮询等待（默认：与 --poll 相同）"
  flag "--spec-draft-n-max <N>" help="投机解码的草稿 token 数（默认：3）"
  flag "--spec-draft-n-min <N>" help="投机解码的最小草稿 token 数（默认：0）"
  flag "--spec-synth-len <L>" help="target mean synthetic acceptance length, including the target token (benchmarking only)"
  flag "--spec-synth-rates <P0_P1>" help="comma-separated unconditional per-position synthetic acceptance probabilities (benchmarking only)"
  flag "--spec-draft-p-split --draft-p-split <P>" help="投机解码分割概率（默认：0.10）"
  flag "--spec-draft-p-min --draft-p-min <P>" help="投机解码最小概率（贪心，默认：0.00）"
  flag "--spec-draft-backend-sampling --no-spec-draft-backend-sampling" help="将草稿采样卸载到后端（默认：启用）"
  flag "--spec-type <NONE_DRAFT_SIMPLE_DRAFT_EAGLE3_DRAFT_MTP_DRAFT_DFLASH_DRAFT_DSPARK_NGRAM_SIMPLE_NGRAM_MAP_K_NGRAM_MAP_K4V_NGRAM_MOD_NGRAM_CACHE>" help="投机解码类型列表，逗号分隔（默认：none）"
  flag "--spec-ngram-mod-n-min <N>" help="基于 n-gram 投机解码的最小 token 数（默认：48）"
  flag "--spec-ngram-mod-n-max <N>" help="基于 n-gram 投机解码的最大 token 数（默认：64）"
  flag "--spec-ngram-mod-n-match <N>" help="ngram-mod 查找长度（默认：24）"
  flag "--spec-ngram-simple-size-n <N>" help="ngram-simple 查找 n-gram 长度（默认：12）"
  flag "--spec-ngram-simple-size-m <N>" help="ngram-simple 草稿 m-gram 长度（默认：48）"
  flag "--spec-ngram-simple-min-hits <N>" help="ngram-simple 最小命中数（默认：1）"
  flag "--spec-ngram-map-k-size-n <N>" help="ngram-map-k 查找 n-gram 长度（默认：12）"
  flag "--spec-ngram-map-k-size-m <N>" help="ngram-map-k 草稿 m-gram 长度（默认：48）"
  flag "--spec-ngram-map-k-min-hits <N>" help="ngram-map-k 最小命中数（默认：1）"
  flag "--spec-ngram-map-k4v-size-n <N>" help="ngram-map-k4v 查找 n-gram 长度（默认：12）"
  flag "--spec-ngram-map-k4v-size-m <N>" help="ngram-map-k4v 草稿 m-gram 长度（默认：48）"
  flag "--spec-ngram-map-k4v-min-hits <N>" help="ngram-map-k4v 最小命中数（默认：1）"
  flag "--draft --draft-n --draft-max <N>" help="the argument has been removed. use --spec-draft-n-max or --spec-ngram-mod-n-max"
  flag "--draft-min --draft-n-min <N>" help="the argument has been removed. use --spec-draft-n-min or --spec-ngram-mod-n-min"
  flag "--samplers <SAMPLERS>" help="按顺序使用的采样器，用分号分隔"
  flag "-s --seed <SEED>" help="随机数种子（默认：-1，-1 为随机）"
  flag "--ignore-eos" help="忽略流结束 token 并继续生成"
  flag "--temp --temperature <N>" help="温度（默认：0.80）"
  flag "--top-k <N>" help="top-k 采样（默认：40，0 = 禁用）"
  flag "--top-p <N>" help="top-p 采样（默认：0.95，1.0 = 禁用）"
  flag "--min-p <N>" help="min-p 采样（默认：0.05，0.0 = 禁用）"
  flag "--top-nsigma --top-n-sigma <N>" help="top-n-sigma 采样（默认：-1.00，禁用）"
  flag "--xtc-probability <N>" help="XTC 概率（默认：0.00，禁用）"
  flag "--xtc-threshold <N>" help="XTC 阈值（默认：0.10，禁用）"
  flag "--typical --typical-p <N>" help="局部典型采样（默认：1.00，禁用）"
  flag "--repeat-last-n <N>" help="考虑惩罚的最近 token 数（默认：64，禁用）"
  flag "--repeat-penalty <N>" help="重复 token 惩罚（默认：1.00，禁用）"
  flag "--presence-penalty <N>" help="重复存在惩罚（默认：0.00，禁用）"
  flag "--frequency-penalty <N>" help="重复频率惩罚（默认：0.00，禁用）"
  flag "--dry-multiplier <N>" help="DRY 采样乘数（默认：0.00，禁用）"
  flag "--dry-base <N>" help="DRY 采样基础值（默认：1.75）"
  flag "--dry-allowed-length <N>" help="DRY 采样允许长度（默认：2）"
  flag "--dry-penalty-last-n <N>" help="最近 n 个 token 的 DRY 惩罚（默认：64，禁用）"
  flag "--dry-sequence-breaker <STRING>" help="添加 DRY 采样的序列中断器"
  flag "--adaptive-target <N>" help="adaptive-p: select tokens near this probability (valid range 0.0 to 1.0; negative = disabled) (default: -1.00)"
  flag "--adaptive-decay <N>" help="adaptive-p: decay rate for target adaptation over time. lower values are more reactive, higher values are more stable. (valid range 0.0 to 0.99) (default: 0.90)"
  flag "--dynatemp-range <N>" help="动态温度范围（默认：0.00，禁用）"
  flag "--dynatemp-exp <N>" help="动态温度指数（默认：1.00）"
  flag "--mirostat <N>" help="使用 Mirostat 采样（默认：0，禁用）"
  flag "--mirostat-lr <N>" help="Mirostat 学习率（默认：0.10）"
  flag "--mirostat-ent <N>" help="Mirostat 目标熵（默认：5.00）"
  flag "-l --logit-bias <TOKEN_ID_BIAS>" help="modifies the likelihood of token appearing in the completion, i.e. `--logit-bias 15043+1` to increase likelihood of token ' Hello', or `--logit-bias 15043-1` to decrease likelihood of token ' Hello'"
  flag "--grammar <GRAMMAR>" help="用于约束生成的 BNF 风格语法"
  flag "--grammar-file <FNAME>" help="语法文件路径"
  flag "-j --json-schema <SCHEMA>" help="用于约束生成的 JSON Schema"
  flag "--json-schema-file <FILE>" help="包含 JSON Schema 的文件"
  flag "--backend-sampling" help="启用后端采样（实验性，默认：禁用）"
  flag "--mmproj <FILE>" help="多模态投影器文件路径"
  flag "--mmproj-url <URL>" help="多模态投影器文件 URL"
  flag "--mmproj-offload --no-mmproj-offload" help="是否为多模态投影器启用 GPU 卸载（默认：启用）"
  flag "--mmproj-device <DEVICE>" help="多模态投影器使用的设备"
  flag "--image --audio --video <FILE>" help="图像、音频或视频文件路径（多模态模型使用）"
  flag "--image-min-tokens <N>" help="每张图像的最小 token 数（仅用于动态分辨率的视觉模型）"
  flag "--image-max-tokens <N>" help="每张图像的最大 token 数（仅用于动态分辨率的视觉模型）"
  flag "--video-fps <N>" help="目标视频帧率（默认：4.0）"
  flag "--video-timestamp-interval <N>" help="文本时间戳之间的间隔（毫秒，默认：5000）"
  flag "--video-ffmpeg-dir <DIR>" help="ffmpeg 和 ffprobe 所在目录路径（默认：在 PATH 中搜索）"
  flag "--reasoning <ON_OFF_AUTO>" help="在对话中使用推理/思考（默认：auto）"
  flag "--reasoning-effort <LEVEL>" help="推理努力级别（默认：default）"
  flag "--reasoning-budget <N>" help="思考的 token 预算（默认：-1，无限制）"
  flag "--reasoning-budget-message <MESSAGE>" help="推理预算耗尽时注入的消息（默认：无）"
  flag "--reasoning-preserve --no-reasoning-preserve" help="preserve reasoning trace in the full history, not just the last assistant message (default: enabled) compatible with certain templates having 'supports_preserve_reasoning' capability example: https://docs.z.ai/guides/capabilities/thinking-mode#preserved-thinking"
  flag "-p --prompt <PROMPT>" help="起始生成的提示词；系统消息请用 -sys"
  flag "-f --file <FNAME>" help="包含提示词的文件（默认：无）"
  flag "--binary-file <FNAME>" help="包含提示词的二进制文件（默认：无）"
  flag "--server-base <URL>" help="连接到此服务器而非启动新服务器"
  flag "--verbose-prompt" help="在生成前打印详细提示词（默认：false）"
  flag "--display-prompt --no-display-prompt" help="是否在生成时打印提示词（默认：true）"
  flag "--color <ON_OFF_AUTO>" help="Colorize output to distinguish prompt and user input from generations ('on', 'off', or 'auto', default: 'auto') 'auto' enables colors when output is to a terminal"
  flag "--system-prompt <PROMPT>" help="用于模型的系统提示词"
  flag "--show-timings --no-show-timings" help="是否在每次响应后显示计时信息（默认：true）"
  flag "-r --reverse-prompt <PROMPT>" help="在 PROMPT 处停止生成，交互模式下返回控制权"
  flag "--special" help="启用特殊 token 输出（默认：false）"
  flag "--single-turn" help="仅运行单轮对话（默认：false）"
  flag "--multiline-input" help="allows you to write or paste multiple lines without ending each in '\\'"
  flag "--warmup --no-warmup" help="是否用空运行进行预热（默认：启用）"
  flag "--chat-template-kwargs <STRING>" help="设置 JSON 模板解析器的额外参数"
  flag "--jinja --no-jinja" help="是否使用 Jinja 模板引擎（默认：启用）"
  flag "--log-disable" help="禁用日志"
  flag "--log-file <FNAME>" help="日志输出到文件"
  flag "--log-jsonl --no-log-jsonl" help="以 JSONL 格式记录日志（默认：禁用）"
  flag "--log-colors <ON_OFF_AUTO>" help="设置彩色日志（默认：auto）"
  flag "-v --verbose --log-verbose" help="设置最大详细级别（用于调试）"
  flag "--offline" help="离线模式：强制使用缓存，禁止网络访问"
  flag "--verbosity --log-verbosity <N>" help="详细级别阈值（默认：1，0=通用输出, 1=错误, 2=警告, 3=信息, 4=跟踪, 5=调试）"
  flag "--log-prefix --no-log-prefix" help="在日志消息中启用前缀"
  flag "--log-timestamps --no-log-timestamps" help="在日志消息中启用时间戳"
  flag "--log-prompts-dir <PATH>" help="将提示词记录到目录（仅用于调试，默认：禁用）"
  flag "--threads-batch <N>" help="批处理和提示词处理的线程数（默认：与 --threads 相同）"
  flag "--cpu-range-batch <LO_HI>" help="批处理 CPU 亲和性范围。与 --cpu-mask-batch 互补"
  flag "--flash-attn <ON_OFF_AUTO>" help="set Flash Attention use ('on', 'off', or 'auto', default: 'auto')"
  flag "--kv-offload --no-kv-offload" help="是否启用 KV 缓存卸载（默认：启用）"
  flag "--direct-io --no-direct-io" help="DEPRECATED in favor of `--load-mode`: use DirectIO if available"
  flag "--numa <TYPE>" help="attempt optimizations that help on some NUMA systems - distribute: spread execution evenly over all nodes - isolate: only spawn threads on CPUs on the node that execution started on - numactl: use the CPU map provided by numactl if run without this previously, it is recommended to drop the system page cache before using this see https://github.com/ggml-org/llama.cpp/issues/1437"
  flag "--list-devices" help="列出可用设备并退出"
  flag "--split-mode <NONE_LAYER_ROW_TENSOR>" help="多 GPU 模型分割方式（默认：layer）"
  flag "--fit-target <MIB0_MIB1_MIB2>" help="每个设备的目标余量（MiB），默认：1024"
  flag "--control-vector-scaled <FNAME_SCALE>" help="添加带缩放的控制向量（格式：FNAME:SCALE,...）"
  flag "--docker-repo <REPO_MODEL_QUANT>" help="Docker Hub model repository. repo is optional, default to ai/. quant is optional, default to :latest. example: gemma3 (default: unused)"
  flag "--hf-repo <USER_MODEL_QUANT>" help="Hugging Face model repository; quant is optional, case-insensitive, default to Q4_K_M, or falls back to the first file in the repo if Q4_K_M doesn't exist. mmproj is also downloaded automatically if available. to disable, add --no-mmproj example: ggml-org/GLM-4.7-Flash-GGUF:Q4_K_M (default: unused)"
  flag "--spec-draft-type-k --cache-type-k-draft <TYPE>" help="草稿模型 K 的 KV 缓存数据类型（默认：f16）"
  flag "--spec-draft-type-v --cache-type-v-draft <TYPE>" help="草稿模型 V 的 KV 缓存数据类型（默认：f16）"
  flag "--sampler-seq --sampling-seq <SEQUENCE>" help="采样器的简化序列（默认：edskypmxt）"
  flag "--spec-draft-hf --hf-repo-draft <USER_MODEL_QUANT>" help="与 --hf-repo 相同，但用于草稿模型（默认：未使用）"
  flag "--spec-draft-threads --threads-draft <N>" help="草稿模型生成时的线程数（默认：与 --threads 相同）"
  flag "--spec-draft-threads-batch --threads-batch-draft <N>" help="草稿模型批处理的线程数（默认：与 --threads-draft 相同）"
  flag "--spec-draft-cpu-mask --cpu-mask-draft <M>" help="草稿模型 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--spec-draft-cpu-range --cpu-range-draft <LO_HI>" help="草稿模型 CPU 亲和性范围"
  flag "--spec-draft-cpu-strict --cpu-strict-draft <N>" help="草稿模型严格 CPU 放置（默认：与 --cpu-strict 相同）"
  flag "--spec-draft-prio --prio-draft <N>" help="set draft process/thread priority : 0-normal, 1-medium, 2-high, 3-realtime (default: 0)"
  flag "--spec-draft-cpu-mask-batch --cpu-mask-batch-draft <M>" help="草稿模型 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--spec-draft-cpu-strict-batch --cpu-strict-batch-draft <N>" help="草稿模型严格 CPU 放置（默认：与 --cpu-strict-draft 相同）"
  flag "--spec-draft-prio-batch --prio-batch-draft <N>" help="草稿模型进程/线程优先级（默认：0）"
  flag "--spec-draft-poll-batch --poll-batch-draft <N>" help="草稿模型轮询等待（默认：与 --poll-draft 相同）"
  flag "--spec-draft-cpu-moe --cpu-moe-draft" help="将草稿模型的所有 MoE 权重保留在 CPU 中"
  flag "--spec-draft-n-cpu-moe --spec-draft-ncmoe --n-cpu-moe-draft <N>" help="将草稿模型前 N 层的 MoE 权重保留在 CPU 中"
  flag "--spec-draft-device --device-draft <DEV1_DEV2>" help="草稿模型卸载设备列表（默认：跟随 --device）"
  flag "--spec-draft-ngl --gpu-layers-draft --n-gpu-layers-draft <N>" help="草稿模型显存层数（默认：auto）"
  flag "--spec-draft-model --model-draft <FNAME>" help="投机解码草稿模型（默认：未使用）"
  flag "--ctx-checkpoints --swa-checkpoints <N>" help="max number of context checkpoints to create per slot (default: 32)"
  flag "--context-shift --no-context-shift" help="whether to use context shift on infinite text generation (default: disabled)"
  flag "--system-prompt-file <FNAME>" help="a file containing the system prompt (default: none)"
  flag "--mmproj-auto --no-mmproj --no-mmproj-auto" help="是否使用多模态投影器文件（默认：启用）"
  flag "-o --output --output-file <FNAME>" help="输出文件（默认：空）"
  flag "--reasoning-format <FORMAT>" help="controls whether thought tags are allowed and/or extracted from the response, and in which format they're returned; one of: - none: leaves thoughts unparsed in `message.content` - deepseek: puts thoughts in `message.reasoning_content` - deepseek-legacy: keeps `<think>` tags in `message.content` while also populating `message.reasoning_content` (default: auto)"
  flag "--chat-template <JINJA_TEMPLATE>" help="set custom jinja chat template (default: template taken from model's metadata) if suffix/prefix are specified, template will be disabled only commonly used templates are accepted (unless --jinja is set before this flag): list of built-in templates: bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
  flag "--chat-template-file <JINJA_TEMPLATE_FILE>" help="set custom jinja chat template file (default: template taken from model's metadata) if suffix/prefix are specified, template will be disabled only commonly used templates are accepted (unless --jinja is set before this flag): list of built-in templates: bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
  flag "--skip-chat-parsing --no-skip-chat-parsing" help="force a pure content parser, even if a Jinja template is specified; model will output everything in the content section, including any reasoning and/or tool calls (default: disabled)"
  flag "--simple-io" help="使用基本 I/O 以获得更好的兼容性"
}

cmd "download" help="下载模型" {
  flag "-h --help --usage" help="打印用法并退出"
  flag "-m --model <FNAME>" help="要加载的模型路径"
  flag "--model-url <MODEL_URL>" help="模型下载 URL（默认：未使用）"
  flag "--docker-repo <REPO>" help="Docker Hub 模型仓库（repo 可选，默认 ai/）"
  flag "--hf-repo <user/model:quant>" help="Hugging Face 模型仓库；quant 可选，默认 Q4_K_M"
  flag "--hf-file <FILE>" help="Hugging Face 模型文件（覆盖 --hf-repo 中的 quant）"
  flag "--hf-token <TOKEN>" help="Hugging Face 访问令牌（默认：HF_TOKEN 环境变量）"
  flag "--mtp" help="同时下载 MTP 头（如果可用）"
  flag "--dflash" help="同时下载 DFlash sidecar（如果可用）"
  flag "--eagle3" help="同时下载 Eagle3 sidecar（如果可用）"
  flag "--no-mmproj" help="禁用自动下载 mmproj"
  flag "--offline" help="离线模式：强制使用缓存，禁止网络访问"
}

cmd "update" help="更新 llama 到最新版本"

cmd "completion" help="文本补全" {
  flag "-h --help --usage" help="打印用法并退出"
  flag "--version" help="显示版本和构建信息"
  flag "--cache-list" help="列出缓存中的模型"
  flag "--completion-bash" help="输出可 source 的 bash 补全脚本"
  flag "-t --threads <N>" help="生成时使用的 CPU 线程数（默认：-1）"
  flag "-C --cpu-mask <M>" help="CPU 亲和性掩码：任意长度十六进制。与 cpu-range 互补（默认：\"\")"
  flag "--cpu-range <LO_HI>" help="CPU 亲和性范围。与 --cpu-mask 互补"
  flag "--cpu-strict <N>" help="使用严格的 CPU 放置（默认：0）"
  flag "--prio <N>" help="设置进程/线程优先级：low(-1), normal(0), medium(1), high(2), realtime(3)（默认：0）"
  flag "--poll <0_100>" help="使用轮询级别等待工作（0 - 不轮询，默认：50）"
  flag "--cpu-mask-batch <M>" help="批处理 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--cpu-strict-batch <N>" help="使用严格的 CPU 放置（默认：与 --cpu-strict 相同）"
  flag "--prio-batch <N>" help="设置进程/线程优先级：0-normal, 1-medium, 2-high, 3-realtime（默认：0）"
  flag "--poll-batch <N>" help="使用轮询等待工作（默认：与 --poll 相同）"
  flag "-c --ctx-size <N>" help="提示词上下文大小（默认：0，0 = 从模型加载）"
  flag "-n --predict --n-predict <N>" help="预测的 token 数量（默认：-1，-1 = 无限）"
  flag "-b --batch-size <N>" help="逻辑最大批处理大小（默认：2048）"
  flag "--ubatch-size <N>" help="物理最大批处理大小（默认：512）"
  flag "--keep <N>" help="从初始提示词中保留的 token 数（默认：0，-1 = 全部）"
  flag "--perf --no-perf" help="whether to enable internal libllama performance timings (default: false)"
  flag "-e --escape --no-escape" help="whether to process escapes sequences (\\n, \\r, \\t, \\', \\\", \\\\) (default: true)"
  flag "--parallel <N>" help="并行解码的序列数（默认：1）"
  flag "--override-tensor <TENSOR>" help="覆盖张量缓冲区类型"
  flag "--cpu-moe" help="将所有 MoE 权重保留在 CPU 中"
  flag "--n-cpu-moe <N>" help="将前 N 层的 MoE 权重保留在 CPU 中"
  flag "--n-cpu-ffn <N>" help="将前 N 层的密集 FFN 权重保留在 CPU 中"
  flag "--check-tensors" help="检查模型张量数据中的无效值（默认：false）"
  flag "--override-kv <KEY_TYPE_VALUE>" help="按键覆盖模型元数据的高级选项"
  flag "--op-offload --no-op-offload" help="是否将主机张量操作卸载到设备（默认：true）"
  flag "-m --model <FNAME>" help="要加载的模型路径"
  flag "--model-url <MODEL_URL>" help="模型下载 URL（默认：未使用）"
  flag "--hf-file <FILE>" help="Hugging Face model file. If specified, it will override the quant in --hf-repo (default: unused)"
  flag "--hf-token <TOKEN>" help="Hugging Face access token (default: value from HF_TOKEN environment variable)"
  flag "--spec-draft-override-tensor --override-tensor-draft <TENSOR>" help="覆盖草稿模型的张量缓冲区类型"
  flag "--gpt-oss-20b-default" help="使用 gpt-oss-20b（可能从网络下载权重）"
  flag "--gpt-oss-120b-default" help="使用 gpt-oss-120b（可能从网络下载权重）"
  flag "--vision-gemma-4b-default" help="使用 Gemma 3 4B QAT（可能从网络下载权重）"
  flag "--vision-gemma-12b-default" help="使用 Gemma 3 12B QAT（可能从网络下载权重）"
  flag "--spec-default" help="启用默认投机解码配置"
  flag "--rope-scaling <NONE_LINEAR_YARN>" help="RoPE 频率缩放方法（默认：linear）"
  flag "--rope-scale <N>" help="RoPE 上下文缩放因子"
  flag "--rope-freq-base <N>" help="RoPE 基础频率（默认：从模型加载）"
  flag "--rope-freq-scale <N>" help="RoPE 频率缩放因子"
  flag "--yarn-orig-ctx <N>" help="YaRN：模型原始上下文大小（默认：0 = 模型训练上下文大小）"
  flag "--yarn-ext-factor <N>" help="YaRN：外推混合因子（默认：-1.00）"
  flag "--yarn-attn-factor <N>" help="YaRN：缩放 sqrt(t) 或注意力幅度（默认：-1.00）"
  flag "--yarn-beta-slow <N>" help="YaRN：高修正维度或 alpha（默认：-1.00）"
  flag "--yarn-beta-fast <N>" help="YaRN：低修正维度或 beta（默认：-1.00）"
  flag "--repack --no-repack" help="是否启用权重重打包（默认：启用）"
  flag "--no-host" help="绕过主机缓冲区以允许使用额外缓冲区"
  flag "--cache-type-k <TYPE>" help="K 的 KV 缓存数据类型（默认：f16）"
  flag "--cache-type-v <TYPE>" help="V 的 KV 缓存数据类型（默认：f16）"
  flag "--defrag-thold <N>" help="KV 缓存碎片整理阈值（已弃用）"
  flag "--cache-ram <N>" help="set the maximum cache size in MiB (default: 8192, -1 - no limit, 0 - disable)"
  flag "--swa-full" help="use full-size SWA cache (default: false) info)](https://github.com/ggml-org/llama.cpp/pull/13194#issuecomment-2868343055)"
  flag "--rpc <SERVERS>" help="RPC 服务器列表，逗号分隔（host:port）"
  flag "--mlock" help="DEPRECATED in favor of `--load-mode`: force system to keep model in RAM rather than swapping or compressing"
  flag "--mmap --no-mmap" help="DEPRECATED in favor of `--load-mode`: whether to memory-map model. (if mmap disabled, slower load but may reduce pageouts if not using mlock)"
  flag "--load-mode <MODE>" help="模型加载模式（默认：auto）"
  flag "--lazy-mode <MODE>" help="按需读取特定张量（默认：auto）"
  flag "--device <DEV1_DEV2>" help="用于卸载的设备列表，逗号分隔（none = 不卸载）"
  flag "--gpu-layers --n-gpu-layers <N>" help="存储在显存中的最大层数，精确数字、'auto' 或 'all'（默认：auto）"
  flag "--tensor-split <N0_N1_N2>" help="各 GPU 卸载比例，逗号分隔，如 3,1"
  flag "--main-gpu <INDEX>" help="用于模型的 GPU（默认：0）"
  flag "--fit <ON_OFF>" help="是否自动调整参数以适应显存（默认：on）"
  flag "--fit-ctx <N>" help="可由 --fit 设置的最小上下文大小（默认：4096）"
  flag "--lora <FNAME>" help="LoRA 适配器路径（逗号分隔可加载多个）"
  flag "--lora-scaled <FNAME_SCALE>" help="带缩放系数的 LoRA 适配器路径（格式：FNAME:SCALE,...）"
  flag "--control-vector <FNAME>" help="添加控制向量（逗号分隔可添加多个）"
  flag "--control-vector-layer-range <START>" help="应用控制向量的层范围（含首尾）"
  flag "--spec-draft-poll --poll-draft <N>" help="草稿模型轮询等待（默认：与 --poll 相同）"
  flag "--spec-draft-n-max <N>" help="投机解码的草稿 token 数（默认：3）"
  flag "--spec-draft-n-min <N>" help="投机解码的最小草稿 token 数（默认：0）"
  flag "--spec-synth-len <L>" help="target mean synthetic acceptance length, including the target token (benchmarking only)"
  flag "--spec-synth-rates <P0_P1>" help="comma-separated unconditional per-position synthetic acceptance probabilities (benchmarking only)"
  flag "--spec-draft-p-split --draft-p-split <P>" help="投机解码分割概率（默认：0.10）"
  flag "--spec-draft-p-min --draft-p-min <P>" help="投机解码最小概率（贪心，默认：0.00）"
  flag "--spec-draft-backend-sampling --no-spec-draft-backend-sampling" help="将草稿采样卸载到后端（默认：启用）"
  flag "--spec-type <NONE_DRAFT_SIMPLE_DRAFT_EAGLE3_DRAFT_MTP_DRAFT_DFLASH_DRAFT_DSPARK_NGRAM_SIMPLE_NGRAM_MAP_K_NGRAM_MAP_K4V_NGRAM_MOD_NGRAM_CACHE>" help="投机解码类型列表，逗号分隔（默认：none）"
  flag "--spec-ngram-mod-n-min <N>" help="基于 n-gram 投机解码的最小 token 数（默认：48）"
  flag "--spec-ngram-mod-n-max <N>" help="基于 n-gram 投机解码的最大 token 数（默认：64）"
  flag "--spec-ngram-mod-n-match <N>" help="ngram-mod 查找长度（默认：24）"
  flag "--spec-ngram-simple-size-n <N>" help="ngram-simple 查找 n-gram 长度（默认：12）"
  flag "--spec-ngram-simple-size-m <N>" help="ngram-simple 草稿 m-gram 长度（默认：48）"
  flag "--spec-ngram-simple-min-hits <N>" help="ngram-simple 最小命中数（默认：1）"
  flag "--spec-ngram-map-k-size-n <N>" help="ngram-map-k 查找 n-gram 长度（默认：12）"
  flag "--spec-ngram-map-k-size-m <N>" help="ngram-map-k 草稿 m-gram 长度（默认：48）"
  flag "--spec-ngram-map-k-min-hits <N>" help="ngram-map-k 最小命中数（默认：1）"
  flag "--spec-ngram-map-k4v-size-n <N>" help="ngram-map-k4v 查找 n-gram 长度（默认：12）"
  flag "--spec-ngram-map-k4v-size-m <N>" help="ngram-map-k4v 草稿 m-gram 长度（默认：48）"
  flag "--spec-ngram-map-k4v-min-hits <N>" help="ngram-map-k4v 最小命中数（默认：1）"
  flag "--draft --draft-n --draft-max <N>" help="the argument has been removed. use --spec-draft-n-max or --spec-ngram-mod-n-max"
  flag "--draft-min --draft-n-min <N>" help="the argument has been removed. use --spec-draft-n-min or --spec-ngram-mod-n-min"
  flag "--samplers <SAMPLERS>" help="按顺序使用的采样器，用分号分隔"
  flag "-s --seed <SEED>" help="随机数种子（默认：-1，-1 为随机）"
  flag "--ignore-eos" help="忽略流结束 token 并继续生成"
  flag "--temp --temperature <N>" help="温度（默认：0.80）"
  flag "--top-k <N>" help="top-k 采样（默认：40，0 = 禁用）"
  flag "--top-p <N>" help="top-p 采样（默认：0.95，1.0 = 禁用）"
  flag "--min-p <N>" help="min-p 采样（默认：0.05，0.0 = 禁用）"
  flag "--top-nsigma --top-n-sigma <N>" help="top-n-sigma 采样（默认：-1.00，禁用）"
  flag "--xtc-probability <N>" help="XTC 概率（默认：0.00，禁用）"
  flag "--xtc-threshold <N>" help="XTC 阈值（默认：0.10，禁用）"
  flag "--typical --typical-p <N>" help="局部典型采样（默认：1.00，禁用）"
  flag "--repeat-last-n <N>" help="考虑惩罚的最近 token 数（默认：64，禁用）"
  flag "--repeat-penalty <N>" help="重复 token 惩罚（默认：1.00，禁用）"
  flag "--presence-penalty <N>" help="重复存在惩罚（默认：0.00，禁用）"
  flag "--frequency-penalty <N>" help="重复频率惩罚（默认：0.00，禁用）"
  flag "--dry-multiplier <N>" help="DRY 采样乘数（默认：0.00，禁用）"
  flag "--dry-base <N>" help="DRY 采样基础值（默认：1.75）"
  flag "--dry-allowed-length <N>" help="DRY 采样允许长度（默认：2）"
  flag "--dry-penalty-last-n <N>" help="最近 n 个 token 的 DRY 惩罚（默认：64，禁用）"
  flag "--dry-sequence-breaker <STRING>" help="添加 DRY 采样的序列中断器"
  flag "--adaptive-target <N>" help="adaptive-p: select tokens near this probability (valid range 0.0 to 1.0; negative = disabled) (default: -1.00)"
  flag "--adaptive-decay <N>" help="adaptive-p: decay rate for target adaptation over time. lower values are more reactive, higher values are more stable. (valid range 0.0 to 0.99) (default: 0.90)"
  flag "--dynatemp-range <N>" help="动态温度范围（默认：0.00，禁用）"
  flag "--dynatemp-exp <N>" help="动态温度指数（默认：1.00）"
  flag "--mirostat <N>" help="使用 Mirostat 采样（默认：0，禁用）"
  flag "--mirostat-lr <N>" help="Mirostat 学习率（默认：0.10）"
  flag "--mirostat-ent <N>" help="Mirostat 目标熵（默认：5.00）"
  flag "-l --logit-bias <TOKEN_ID_BIAS>" help="modifies the likelihood of token appearing in the completion, i.e. `--logit-bias 15043+1` to increase likelihood of token ' Hello', or `--logit-bias 15043-1` to decrease likelihood of token ' Hello'"
  flag "--grammar <GRAMMAR>" help="用于约束生成的 BNF 风格语法"
  flag "--grammar-file <FNAME>" help="语法文件路径"
  flag "-j --json-schema <SCHEMA>" help="用于约束生成的 JSON Schema"
  flag "--json-schema-file <FILE>" help="包含 JSON Schema 的文件"
  flag "--backend-sampling" help="启用后端采样（实验性，默认：禁用）"
  flag "--mmproj <FILE>" help="多模态投影器文件路径"
  flag "--mmproj-url <URL>" help="多模态投影器文件 URL"
  flag "--mmproj-offload --no-mmproj-offload" help="是否为多模态投影器启用 GPU 卸载（默认：启用）"
  flag "--mmproj-device <DEVICE>" help="多模态投影器使用的设备"
  flag "--image --audio --video <FILE>" help="图像、音频或视频文件路径（多模态模型使用）"
  flag "--image-min-tokens <N>" help="每张图像的最小 token 数（仅用于动态分辨率的视觉模型）"
  flag "--image-max-tokens <N>" help="每张图像的最大 token 数（仅用于动态分辨率的视觉模型）"
  flag "--video-fps <N>" help="目标视频帧率（默认：4.0）"
  flag "--video-timestamp-interval <N>" help="文本时间戳之间的间隔（毫秒，默认：5000）"
  flag "--video-ffmpeg-dir <DIR>" help="ffmpeg 和 ffprobe 所在目录路径（默认：在 PATH 中搜索）"
  flag "--reasoning <ON_OFF_AUTO>" help="在对话中使用推理/思考（默认：auto）"
  flag "--reasoning-effort <LEVEL>" help="推理努力级别（默认：default）"
  flag "--reasoning-budget <N>" help="思考的 token 预算（默认：-1，无限制）"
  flag "--reasoning-budget-message <MESSAGE>" help="推理预算耗尽时注入的消息（默认：无）"
  flag "--reasoning-preserve --no-reasoning-preserve" help="preserve reasoning trace in the full history, not just the last assistant message (default: enabled) compatible with certain templates having 'supports_preserve_reasoning' capability example: https://docs.z.ai/guides/capabilities/thinking-mode#preserved-thinking"
  flag "-p --prompt <PROMPT>" help="起始生成的提示词；系统消息请用 -sys"
  flag "-f --file <FNAME>" help="包含提示词的文件（默认：无）"
  flag "--binary-file <FNAME>" help="包含提示词的二进制文件（默认：无）"
  flag "--server-base <URL>" help="连接到此服务器而非启动新服务器"
  flag "--verbose-prompt" help="在生成前打印详细提示词（默认：false）"
  flag "--display-prompt --no-display-prompt" help="是否在生成时打印提示词（默认：true）"
  flag "--color <ON_OFF_AUTO>" help="Colorize output to distinguish prompt and user input from generations ('on', 'off', or 'auto', default: 'auto') 'auto' enables colors when output is to a terminal"
  flag "--system-prompt <PROMPT>" help="用于模型的系统提示词"
  flag "--show-timings --no-show-timings" help="是否在每次响应后显示计时信息（默认：true）"
  flag "-r --reverse-prompt <PROMPT>" help="在 PROMPT 处停止生成，交互模式下返回控制权"
  flag "--special" help="启用特殊 token 输出（默认：false）"
  flag "--single-turn" help="仅运行单轮对话（默认：false）"
  flag "--multiline-input" help="allows you to write or paste multiple lines without ending each in '\\'"
  flag "--warmup --no-warmup" help="是否用空运行进行预热（默认：启用）"
  flag "--chat-template-kwargs <STRING>" help="设置 JSON 模板解析器的额外参数"
  flag "--jinja --no-jinja" help="是否使用 Jinja 模板引擎（默认：启用）"
  flag "--log-disable" help="禁用日志"
  flag "--log-file <FNAME>" help="日志输出到文件"
  flag "--log-jsonl --no-log-jsonl" help="以 JSONL 格式记录日志（默认：禁用）"
  flag "--log-colors <ON_OFF_AUTO>" help="设置彩色日志（默认：auto）"
  flag "-v --verbose --log-verbose" help="设置最大详细级别（用于调试）"
  flag "--offline" help="离线模式：强制使用缓存，禁止网络访问"
  flag "--verbosity --log-verbosity <N>" help="详细级别阈值（默认：1，0=通用输出, 1=错误, 2=警告, 3=信息, 4=跟踪, 5=调试）"
  flag "--log-prefix --no-log-prefix" help="在日志消息中启用前缀"
  flag "--log-timestamps --no-log-timestamps" help="在日志消息中启用时间戳"
  flag "--log-prompts-dir <PATH>" help="将提示词记录到目录（仅用于调试，默认：禁用）"
  flag "--threads-batch <N>" help="批处理和提示词处理的线程数（默认：与 --threads 相同）"
  flag "--cpu-range-batch <LO_HI>" help="批处理 CPU 亲和性范围。与 --cpu-mask-batch 互补"
  flag "--flash-attn <ON_OFF_AUTO>" help="set Flash Attention use ('on', 'off', or 'auto', default: 'auto')"
  flag "--kv-offload --no-kv-offload" help="是否启用 KV 缓存卸载（默认：启用）"
  flag "--direct-io --no-direct-io" help="DEPRECATED in favor of `--load-mode`: use DirectIO if available"
  flag "--numa <TYPE>" help="attempt optimizations that help on some NUMA systems - distribute: spread execution evenly over all nodes - isolate: only spawn threads on CPUs on the node that execution started on - numactl: use the CPU map provided by numactl if run without this previously, it is recommended to drop the system page cache before using this see https://github.com/ggml-org/llama.cpp/issues/1437"
  flag "--list-devices" help="列出可用设备并退出"
  flag "--split-mode <NONE_LAYER_ROW_TENSOR>" help="多 GPU 模型分割方式（默认：layer）"
  flag "--fit-target <MIB0_MIB1_MIB2>" help="每个设备的目标余量（MiB），默认：1024"
  flag "--control-vector-scaled <FNAME_SCALE>" help="添加带缩放的控制向量（格式：FNAME:SCALE,...）"
  flag "--docker-repo <REPO_MODEL_QUANT>" help="Docker Hub model repository. repo is optional, default to ai/. quant is optional, default to :latest. example: gemma3 (default: unused)"
  flag "--hf-repo <USER_MODEL_QUANT>" help="Hugging Face model repository; quant is optional, case-insensitive, default to Q4_K_M, or falls back to the first file in the repo if Q4_K_M doesn't exist. mmproj is also downloaded automatically if available. to disable, add --no-mmproj example: ggml-org/GLM-4.7-Flash-GGUF:Q4_K_M (default: unused)"
  flag "--spec-draft-type-k --cache-type-k-draft <TYPE>" help="草稿模型 K 的 KV 缓存数据类型（默认：f16）"
  flag "--spec-draft-type-v --cache-type-v-draft <TYPE>" help="草稿模型 V 的 KV 缓存数据类型（默认：f16）"
  flag "--sampler-seq --sampling-seq <SEQUENCE>" help="采样器的简化序列（默认：edskypmxt）"
  flag "--spec-draft-hf --hf-repo-draft <USER_MODEL_QUANT>" help="与 --hf-repo 相同，但用于草稿模型（默认：未使用）"
  flag "--spec-draft-threads --threads-draft <N>" help="草稿模型生成时的线程数（默认：与 --threads 相同）"
  flag "--spec-draft-threads-batch --threads-batch-draft <N>" help="草稿模型批处理的线程数（默认：与 --threads-draft 相同）"
  flag "--spec-draft-cpu-mask --cpu-mask-draft <M>" help="草稿模型 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--spec-draft-cpu-range --cpu-range-draft <LO_HI>" help="草稿模型 CPU 亲和性范围"
  flag "--spec-draft-cpu-strict --cpu-strict-draft <N>" help="草稿模型严格 CPU 放置（默认：与 --cpu-strict 相同）"
  flag "--spec-draft-prio --prio-draft <N>" help="set draft process/thread priority : 0-normal, 1-medium, 2-high, 3-realtime (default: 0)"
  flag "--spec-draft-cpu-mask-batch --cpu-mask-batch-draft <M>" help="草稿模型 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--spec-draft-cpu-strict-batch --cpu-strict-batch-draft <N>" help="草稿模型严格 CPU 放置（默认：与 --cpu-strict-draft 相同）"
  flag "--spec-draft-prio-batch --prio-batch-draft <N>" help="草稿模型进程/线程优先级（默认：0）"
  flag "--spec-draft-poll-batch --poll-batch-draft <N>" help="草稿模型轮询等待（默认：与 --poll-draft 相同）"
  flag "--spec-draft-cpu-moe --cpu-moe-draft" help="将草稿模型的所有 MoE 权重保留在 CPU 中"
  flag "--spec-draft-n-cpu-moe --spec-draft-ncmoe --n-cpu-moe-draft <N>" help="将草稿模型前 N 层的 MoE 权重保留在 CPU 中"
  flag "--spec-draft-device --device-draft <DEV1_DEV2>" help="草稿模型卸载设备列表（默认：跟随 --device）"
  flag "--spec-draft-ngl --gpu-layers-draft --n-gpu-layers-draft <N>" help="草稿模型显存层数（默认：auto）"
  flag "--spec-draft-model --model-draft <FNAME>" help="投机解码草稿模型（默认：未使用）"
  flag "--ctx-checkpoints --swa-checkpoints <N>" help="max number of context checkpoints to create per slot (default: 32)"
  flag "--context-shift --no-context-shift" help="whether to use context shift on infinite text generation (default: disabled)"
  flag "--system-prompt-file <FNAME>" help="a file containing the system prompt (default: none)"
  flag "--mmproj-auto --no-mmproj --no-mmproj-auto" help="是否使用多模态投影器文件（默认：启用）"
  flag "-o --output --output-file <FNAME>" help="输出文件（默认：空）"
  flag "--reasoning-format <FORMAT>" help="controls whether thought tags are allowed and/or extracted from the response, and in which format they're returned; one of: - none: leaves thoughts unparsed in `message.content` - deepseek: puts thoughts in `message.reasoning_content` - deepseek-legacy: keeps `<think>` tags in `message.content` while also populating `message.reasoning_content` (default: auto)"
  flag "--chat-template <JINJA_TEMPLATE>" help="set custom jinja chat template (default: template taken from model's metadata) if suffix/prefix are specified, template will be disabled only commonly used templates are accepted (unless --jinja is set before this flag): list of built-in templates: bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
  flag "--chat-template-file <JINJA_TEMPLATE_FILE>" help="set custom jinja chat template file (default: template taken from model's metadata) if suffix/prefix are specified, template will be disabled only commonly used templates are accepted (unless --jinja is set before this flag): list of built-in templates: bailing, bailing-think, bailing2, chatglm3, chatglm4, chatml, command-r, deepseek, deepseek-ocr, deepseek2, deepseek3, exaone-moe, exaone3, exaone4, falcon3, gemma, gigachat, glmedge, gpt-oss, granite, granite-4.0, granite-4.1, grok-2, hunyuan-dense, hunyuan-moe, hunyuan-vl, kimi-k2, llama2, llama2-sys, llama2-sys-bos, llama2-sys-strip, llama3, llama4, megrez, minicpm, mistral-v1, mistral-v3, mistral-v3-tekken, mistral-v7, mistral-v7-tekken, monarch, openchat, orion, pangu-embedded, phi3, phi4, rwkv-world, seed_oss, smolvlm, solar-open, vicuna, vicuna-orca, yandex, zephyr"
  flag "--skip-chat-parsing --no-skip-chat-parsing" help="force a pure content parser, even if a Jinja template is specified; model will output everything in the content section, including any reasoning and/or tool calls (default: disabled)"
  flag "--simple-io" help="使用基本 I/O 以获得更好的兼容性"
}

cmd "bench" help="模型性能基准测试" {
  flag "--numa <TYPE>" help="NUMA 模式（默认：禁用）"
  flag "-r --repetitions <N>" help="每个测试的重复次数（默认：5）"
  flag "--prio <N>" help="进程/线程优先级（默认：0）"
  flag "--delay <0_N>" help="每次测试间的延迟（默认：0）"
  flag "--list-devices" help="列出可用设备并退出"
  flag "--hf-repo <USER_MODEL_QUANT>" help="Hugging Face model repository; quant is optional, case-insensitive default to Q4_K_M, or falls back to the first file in the repo if Q4_K_M doesn't exist. example: ggml-org/GLM-4.7-Flash-GGUF:Q4_K_M (default: unused)"
  flag "--hf-file <FILE>" help="Hugging Face model file. If specified, it will override the quant in --hf-repo (default: unused)"
  flag "--hf-token <TOKEN>" help="Hugging Face access token (default: value from HF_TOKEN environment variable)"
  flag "--rpc <RPC_SERVERS>" help="注册 RPC 设备（逗号分隔）"
  flag "-o --output <CSV_JSON_JSONL_MD_SQL>" help="stdout 输出格式（默认：md）"
  flag "--output-err <CSV_JSON_JSONL_MD_SQL>" help="stderr 输出格式（默认：无）"
  flag "-v --verbose" help="详细输出"
  flag "--progress" help="打印测试进度指示器"
  flag "--no-warmup" help="跳过基准测试前的预热运行"
  flag "--fit-target <MIB>" help="适配设备内存的余量（MiB，默认：关闭）"
  flag "--fit-ctx <N>" help="--fit-target 的最小上下文大小（默认：4096）"
  flag "--offline" help="离线模式：强制使用缓存，禁止网络访问（默认：禁用）"
  flag "-h --help" help=""
  flag "-m --model <FILENAME>" help="(default: models/7B/ggml-model-q4_0.gguf)"
  flag "-p --n-prompt <N>" help="(default: 512)"
  flag "-n --n-gen <N>" help="(default: 128)"
  flag "-d --n-depth <N>" help="(default: 0)"
  flag "-b --batch-size <N>" help="(default: 2048)"
  flag "--ubatch-size <N>" help="(default: 512)"
  flag "--cache-type-k <T>" help="(default: f16)"
  flag "--cache-type-v <T>" help="(default: f16)"
  flag "-t --threads <N>" help="(default: 10)"
  flag "-C --cpu-mask <HEX_HEX>" help="(default: 0x0)"
  flag "--cpu-strict <N>" help="(default: 0)"
  flag "--poll <0_100>" help="(default: 50)"
  flag "--n-gpu-layers <N>" help="(default: -1)"
  flag "--n-cpu-moe <N>" help="(default: 0)"
  flag "--split-mode <NONE_LAYER_ROW_TENSOR>" help="(default: layer)"
  flag "--main-gpu <I>" help="(default: 0)"
  flag "--no-kv-offload <N>" help="(default: 0)"
  flag "--flash-attn <ON_OFF_AUTO>" help="(default: auto)"
  flag "--device <DEV0_DEV1>" help="(default: auto)"
  flag "--load-mode <AUTO_NONE_MMAP_MLOCK_MMAP_MLOCK_DIO>" help=""
  flag "--lazy-mode <ON_AUTO_OFF>" help="(default: auto)"
  flag "--mmap <N>" help="(DEPRECATED IN FAVOUR OF --load-mode)"
  flag "--direct-io <N>" help="(DEPRECATED IN FAVOUR OF --load-mode)"
  flag "--embeddings <N>" help="(default: 0)"
  flag "--tensor-split <TS0_TS1>" help="(default: 0)"
  flag "--override-tensor <TENSOR>" help="(default: disabled)"
  flag "--no-op-offload <N>" help="(default: 0)"
  flag "--no-host <N>" help="(default: 0)"
}

cmd "batched-bench" help="批处理解码性能基准测试" {
  flag "-h --help --usage" help="打印用法并退出"
  flag "--version" help="显示版本和构建信息"
  flag "--cache-list" help="列出缓存中的模型"
  flag "--completion-bash" help="输出可 source 的 bash 补全脚本"
  flag "-t --threads <N>" help="(default: 10)"
  flag "--threads-batch <N>" help="批处理和提示词处理的线程数（默认：与 --threads 相同）"
  flag "-C --cpu-mask <M>" help="(default: 0x0)"
  flag "--cpu-range <LO-HI>" help="CPU 亲和性范围。与 --cpu-mask 互补"
  flag "--cpu-strict <0_1>" help="(default: 0)"
  flag "--prio <N>" help="进程/线程优先级（默认：0）"
  flag "--poll <0_100>" help="(default: 50)"
  flag "--cpu-mask-batch <M>" help="批处理 CPU 亲和性掩码（默认：与 --cpu-mask 相同）"
  flag "--cpu-range-batch <LO-HI>" help="批处理 CPU 亲和性范围。与 --cpu-mask-batch 互补"
