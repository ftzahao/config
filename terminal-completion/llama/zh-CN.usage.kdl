  flag "--n-cpu-moe <N>" help="(default: 0)"
  flag "--n-cpu-ffn <N>" help="将前 N 层的密集 FFN 权重保留在 CPU 中"
  flag "--gpu-layers --n-gpu-layers <N>" help="存储在显存中的最大层数，精确数字、'auto' 或 'all'（默认：auto）"
  flag "--split-mode <NONE_LAYER_ROW_TENSOR>" help="(default: layer)"
  flag "--tensor-split <N0_N1_N2_>" help="(default: 0)"
  flag "--main-gpu <INDEX>" help="(default: 0)"
