#compdef mlx_lm.cache_prompt
# @generated by usage-cli from mlx_lm.cache_prompt/usage.kdl
local curcontext="$curcontext"

_mlx_lm_cache_prompt() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.cache_prompt." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_cache_prompt.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX Cache Prompt"
bin mlx_lm.cache_prompt
version "0.31.3"
about "Cache the state of a prompt to be reused with mlx_lm.generate"
flag "-h --help" help="show this help message and exit"
flag --model help="The path to the local model directory or Hugging Face repo." {
    arg <MODEL>
}
flag --adapter-path help="Optional path for the trained adapter weights and config." {
    arg <ADAPTER_PATH>
}
flag --trust-remote-code help="Enable trusting remote code for tokenizer"
flag --eos-token help="End of sequence token for tokenizer" {
    arg <EOS_TOKEN>
}
flag --max-kv-size help="Set the maximum key-value cache size" {
    arg <MAX_KV_SIZE>
}
flag --prompt-cache-file help="The file to save the prompt cache in" {
    arg <PROMPT_CACHE_FILE>
}
flag --prompt help="Message to be processed by the model ('-' reads from stdin)" {
    arg <PROMPT>
}
flag --kv-bits help="Number of bits for KV cache quantization. Defaults to no quantization." {
    arg <KV_BITS>
}
flag --kv-group-size help="Group size for KV cache quantization." {
    arg <KV_GROUP_SIZE>
}
flag --quantized-kv-start help="When --kv-bits is set, start quantizing the KV cache from this step onwards." {
    arg <QUANTIZED_KV_START>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_cache_prompt" ]; then
    _mlx_lm_cache_prompt "$@"
else
    compdef _mlx_lm_cache_prompt mlx_lm.cache_prompt
fi

