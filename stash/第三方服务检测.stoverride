name: 第三方服务可用性检测
category: 规则集
desc: 第三方服务可用性检测
icon: https://raw.githubusercontent.com/ftzahao/config/main/assets/avatar.png

tiles:
  - name: IPPure-IP-Info
    title: IPPure IP Info
    icon: https://ippure.com/logo.png
    collapsed: true
    url: https://ippure.com

  - name: IPPure-IP-Fraud-Score
    title: IPPure IP Fraud Score
    icon: https://ippure.com/logo.png
    collapsed: true
    url: https://ippure.com

  - name: IPPure-IP-Native-Check
    title: IPPure IP Native Check
    icon: https://ippure.com/logo.png
    collapsed: true
    url: https://ippure.com

  - name: Check_DisneyPlus
    interval: 1800
    collapsed: true
    title: "Disney+"
    content: 检测中...
    icon: sparkles
    backgroundColor: "#113CCF"
    url: https://www.disneyplus.com
    timeout: 15

  - name: Check_Spotify
    interval: 1800
    collapsed: true
    title: "Spotify"
    content: 检测中...
    icon: music.note
    backgroundColor: "#1DB954"
    url: https://www.spotify.com
    timeout: 15

  - name: Check_X
    interval: 1800
    collapsed: true
    title: "X"
    content: 检测中...
    icon: message.fill
    backgroundColor: "#0F1419"
    url: https://x.com
    timeout: 15

  - name: Check_Instagram
    interval: 1800
    collapsed: true
    title: "Instagram"
    content: 检测中...
    icon: camera.fill
    backgroundColor: "#E1306C"
    url: https://www.instagram.com
    timeout: 15

  - name: Check_TikTok
    interval: 1800
    collapsed: true
    title: "TikTok"
    content: 检测中...
    icon: music.note
    backgroundColor: "#000000"
    url: https://www.tiktok.com
    timeout: 15

  - name: Check_Google
    interval: 1800
    collapsed: true
    title: "Google"
    content: 检测中...
    icon: magnifyingglass
    backgroundColor: "#4285F4"
    url: https://www.google.com
    timeout: 15

  - name: Check_Claude
    interval: 1800
    collapsed: true
    title: "Claude"
    content: 检测中...
    icon: text.bubble.fill
    backgroundColor: "#D97757"
    url: https://claude.ai
    timeout: 15

  - name: Check_Gemini
    interval: 1800
    collapsed: true
    title: "Gemini"
    content: 检测中...
    icon: sparkles
    backgroundColor: "#4285F4"
    url: https://gemini.google.com
    timeout: 15

  - name: Check_ChatGPT
    interval: 1800
    collapsed: true
    title: "ChatGPT"
    content: 检测中...
    icon: bubble.left.and.bubble.right.fill
    backgroundColor: "#10A37F"
    url: https://chatgpt.com
    timeout: 15

  - name: Check_YouTube
    interval: 1800
    collapsed: true
    title: "YouTube"
    content: 检测中...
    icon: play.rectangle.fill
    backgroundColor: "#FF0000"
    url: https://www.youtube.com
    timeout: 15

  - name: Check_Netflix
    interval: 1800
    collapsed: true
    title: "Netflix"
    content: 检测中...
    icon: play.tv.fill
    backgroundColor: "#E50914"
    url: https://www.netflix.com
    timeout: 15

script-providers:
  IPPure-IP-Info:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/ippure-ip-info.js
    path: ippure/ip-info.js
    interval: 86400
  IPPure-IP-Fraud-Score:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/ippure-ip-fraud-score.js
    path: ippure/ip-fraud-score.js
    interval: 86400
  IPPure-IP-Native-Check:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/ippure-ip-native-check.js
    path: ippure/ip-native-check.js
    interval: 86400
  Check_DisneyPlus:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/disney.js
    interval: 86400
  Check_Spotify:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/spotify.js
    interval: 86400
  Check_X:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/x.js
    interval: 86400
  Check_Instagram:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/instagram.js
    interval: 86400
  Check_TikTok:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/tiktok.js
    interval: 86400
  Check_Google:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/google.js
    interval: 86400
  Check_Claude:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/claude.js
    interval: 86400
  Check_Gemini:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/gemini.js
    interval: 86400
  Check_ChatGPT:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/chatgpt.js
    interval: 86400
  Check_YouTube:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/youtube.js
    interval: 86400
  Check_Netflix:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/tiles/netflix.js
    interval: 86400
