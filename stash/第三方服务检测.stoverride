    timeout: 15

  - name: Check_EpicStore
    interval: 1800
    collapsed: true
    title: "Epic Store (严格)"
    content: 检测中...
    icon: cart
    backgroundColor: "#2A2A2A"
    url: https://store.epicgames.com
    timeout: 15

