name: 第三方服务可用性检测
category: 规则集
desc: 第三方服务可用性检测
icon: https://raw.githubusercontent.com/ftzahao/config/main/assets/avatar.png

tiles:
  - name: IPPure-IP-Info
    title: IPPure IP Info
    icon: https://ippure.com/logo.png
    collapsed: true
    url: https://ippure.com

  - name: IPPure-IP-Fraud-Score
    title: IPPure IP Fraud Score
    icon: https://ippure.com/logo.png
    collapsed: true
    url: https://ippure.com

  - name: IPPure-IP-Native-Check
    title: IPPure IP Native Check
    icon: https://ippure.com/logo.png
    collapsed: true
    url: https://ippure.com

  - name: Check_DisneyPlus
    interval: 1800
    collapsed: true
    title: "Disney+"
    content: 检测中...
    icon: sparkles
    backgroundColor: "#113CCF"
    url: https://www.disneyplus.com
    timeout: 15

  - name: Check_Spotify
    interval: 1800
    collapsed: true
    title: "Spotify"
    content: 检测中...
    icon: music.note
    backgroundColor: "#1DB954"
    url: https://www.spotify.com
    timeout: 15

  - name: Check_X
    interval: 1800
    collapsed: true
    title: "X"
    content: 检测中...
    icon: message.fill
    backgroundColor: "#0F1419"
    url: https://x.com
    timeout: 15

  - name: Check_Instagram
    interval: 1800
    collapsed: true
    title: "Instagram"
    content: 检测中...
    icon: camera.fill
    backgroundColor: "#E1306C"
    url: https://www.instagram.com
    timeout: 15

  - name: Check_TikTok
    interval: 1800
    collapsed: true
    title: "TikTok"
    content: 检测中...
    icon: music.note
    backgroundColor: "#000000"
    url: https://www.tiktok.com
    timeout: 15

  - name: Check_Google
    interval: 1800
    collapsed: true
    title: "Google"
    content: 检测中...
    icon: magnifyingglass
    backgroundColor: "#4285F4"
    url: https://www.google.com
    timeout: 15

  - name: Check_Claude
    interval: 1800
    collapsed: true
    title: "Claude"
    content: 检测中...
    icon: text.bubble.fill
    backgroundColor: "#D97757"
    url: https://claude.ai
    timeout: 15

  - name: Check_Gemini
    interval: 1800
    collapsed: true
    title: "Gemini"
    content: 检测中...
    icon: sparkles
    backgroundColor: "#4285F4"
    url: https://gemini.google.com
    timeout: 15

  - name: Check_ChatGPT
    interval: 1800
    collapsed: true
    title: "ChatGPT"
    content: 检测中...
    icon: bubble.left.and.bubble.right.fill
    backgroundColor: "#10A37F"
    url: https://chatgpt.com
    timeout: 15

  - name: Check_YouTube
    interval: 1800
    collapsed: true
    title: "YouTube"
    content: 检测中...
    icon: play.rectangle.fill
    backgroundColor: "#FF0000"
    url: https://www.youtube.com
    timeout: 15

  - name: Check_Netflix
    interval: 1800
    collapsed: true
    title: "Netflix"
    content: 检测中...
    icon: play.tv.fill
    backgroundColor: "#E50914"
    url: https://www.netflix.com
    timeout: 15

  # ---------- 社交与直播 ----------
  - name: Check_Facebook
    interval: 1800
    collapsed: true
    title: "Facebook"
    content: 检测中...
    icon: person.2.fill
    backgroundColor: "#0866FF"
    url: https://www.facebook.com
    timeout: 15

  - name: Check_Threads
    interval: 1800
    collapsed: true
    title: "Threads"
    content: 检测中...
    icon: at
    backgroundColor: "#000000"
    url: https://www.threads.com
    timeout: 15

  - name: Check_Reddit
    interval: 1800
    collapsed: true
    title: "Reddit"
    content: 检测中...
    icon: text.bubble.fill
    backgroundColor: "#FF4500"
    url: https://www.reddit.com
    timeout: 15

  - name: Check_Twitch
    interval: 1800
    collapsed: true
    title: "Twitch"
    content: 检测中...
    icon: video.fill
    backgroundColor: "#9146FF"
    url: https://www.twitch.tv
    timeout: 15

  - name: Check_Discord
    interval: 1800
    collapsed: true
    title: "Discord"
    content: 检测中...
    icon: bubble.left.fill
    backgroundColor: "#5865F2"
    url: https://discord.com
    timeout: 15

  - name: Check_LinkedIn
    interval: 1800
    collapsed: true
    title: "LinkedIn"
    content: 检测中...
    icon: briefcase.fill
    backgroundColor: "#0A66C2"
    url: https://www.linkedin.com
    timeout: 15

  # ---------- AI 服务 ----------
  - name: Check_Grok
    interval: 1800
    collapsed: true
    title: "Grok"
    content: 检测中...
    icon: sparkle
    backgroundColor: "#1A1A1A"
    url: https://grok.com
    timeout: 15

  - name: Check_xAI
    interval: 1800
    collapsed: true
    title: "xAI"
    content: 检测中...
    icon: brain.head.profile
    backgroundColor: "#1A1A1A"
    url: https://x.ai
    timeout: 15

  - name: Check_Perplexity
    interval: 1800
    collapsed: true
    title: "Perplexity"
    content: 检测中...
    icon: questionmark.circle.fill
    backgroundColor: "#1FB8CD"
    url: https://www.perplexity.ai
    timeout: 15

  - name: Check_Copilot
    interval: 1800
    collapsed: true
    title: "GitHub Copilot"
    content: 检测中...
    icon: chevron.left.forwardslash.chevron.right
    backgroundColor: "#24292F"
    url: https://github.com/features/copilot
    timeout: 15

  - name: Check_HuggingFace
    interval: 1800
    collapsed: true
    title: "Hugging Face"
    content: 检测中...
    icon: face.smiling
    backgroundColor: "#FFD21E"
    url: https://huggingface.co
    timeout: 15

  - name: Check_Poe
    interval: 1800
    collapsed: true
    title: "Poe"
    content: 检测中...
    icon: text.alignleft
    backgroundColor: "#5D3FD3"
    url: https://poe.com
    timeout: 15

  # ---------- 流媒体与国内服务 ----------
  - name: Check_HBO
    interval: 1800
    collapsed: true
    title: "HBO Max"
    content: 检测中...
    icon: play.rectangle.fill
    backgroundColor: "#002BE7"
    url: https://www.max.com
    timeout: 15

  - name: Check_PrimeVideo
    interval: 1800
    collapsed: true
    title: "Prime Video"
    content: 检测中...
    icon: play.tv.fill
    backgroundColor: "#00A8E1"
    url: https://www.primevideo.com
    timeout: 15

  - name: Check_Hulu
    interval: 1800
    collapsed: true
    title: "Hulu"
    content: 检测中...
    icon: tv.fill
    backgroundColor: "#1CE783"
    url: https://www.hulu.com
    timeout: 15

  - name: Check_AppleMusic
    interval: 1800
    collapsed: true
    title: "Apple Music"
    content: 检测中...
