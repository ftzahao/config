  - name: Check_NPM
    interval: 1800
    collapsed: true
    title: "npm"
    content: 检测中...
    icon: shippingbox
    backgroundColor: "#CB3837"
    url: https://www.npmjs.com
    timeout: 15

  - name: Check_Wikipedia
    interval: 1800
    collapsed: true
    title: "Wikipedia"
    content: 检测中...
    icon: book.fill
    backgroundColor: "#000000"
    url: https://www.wikipedia.org
    timeout: 15

  - name: Check_SpotifyWeb
    interval: 1800
    collapsed: true
    title: "Spotify Web"
    content: 检测中...
    icon: music.note.house.fill
    backgroundColor: "#1DB954"
    url: https://open.spotify.com
