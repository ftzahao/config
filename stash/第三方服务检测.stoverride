  - name: Check_Bilibili
    interval: 1800
    collapsed: true
    title: "哔哩哔哩"
    content: 检测中...
    icon: play.tv
    backgroundColor: "#00A1D6"
    url: https://www.bilibili.com
    timeout: 15

  - name: Check_iQIYI
    interval: 1800
    collapsed: true
    title: "爱奇艺"
    content: 检测中...
    icon: play.tv.fill
    backgroundColor: "#00BE06"
    url: https://www.iqiyi.com
    timeout: 15

  - name: Check_WeChat
    interval: 1800
    collapsed: true
    title: "微信"
    content: 检测中...
    icon: message.fill
    backgroundColor: "#07C160"
    url: https://weixin.qq.com
    timeout: 15

  # ---------- 开发与游戏 ----------
  - name: Check_Steam
    interval: 1800
    collapsed: true
    title: "Steam"
    content: 检测中...
    icon: gamecontroller.fill
    backgroundColor: "#1B2838"
    url: https://store.steampowered.com
