name: 自用规则
category: 规则集
desc: 自用规则
mode: rule
dns:
  default-nameserver:
    - 119.29.29.29
    - 223.5.5.5
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fake-ip-filter:
    - "*"
    - "+.lan"
    - "+.local"
rule-providers:
  FtzahaoDirect:
    url: https://cdn.jsdelivr.net/gh/ftzahao/config@main/stash/Direct.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Apple:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Apple/Apple.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Apple_Domain.yaml:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Apple/Apple_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  Alibaba.yaml:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Alibaba/Alibaba.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Alibaba_Domain.yaml:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Alibaba/Alibaba_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  CloudCN:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Cloud/CloudCN/CloudCN.yaml
    behavior: classical
    format: yaml
    interval: 86400
  ChinaMax:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/ChinaMax/ChinaMax.yaml
    behavior: classical
    format: yaml
    interval: 86400
  ChinaMax_Domain:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/ChinaMax/ChinaMax_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  ChinaMax_IP:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/ChinaMax/ChinaMax_IP.yaml
    behavior: ipcidr
    format: yaml
    interval: 86400
  Developer:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Developer/Developer.yaml
    behavior: classical
    format: yaml
    interval: 86400
  CloudGlobal:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Cloud/CloudGlobal/CloudGlobal.yaml
    behavior: classical
    format: yaml
    interval: 86400
  CloudGlobal_IP:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Cloud/CloudGlobal/CloudGlobal_IP.yaml
    behavior: ipcidr
    format: yaml
    interval: 86400
  Global:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Global/Global.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Global_Domain:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Global/Global_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  Lan:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Lan/Lan.yaml
    behavior: classical
    format: yaml
    interval: 86400
rules:
  - RULE-SET,Developer,PROXY
  - RULE-SET,FtzahaoDirect,DIRECT
  - RULE-SET,Apple,DIRECT
  - RULE-SET,Apple_Domain,DIRECT
  - RULE-SET,Alibaba,DIRECT
  - RULE-SET,Alibaba_Domain,DIRECT
  - RULE-SET,CloudCN,DIRECT
  - RULE-SET,ChinaMax,DIRECT
  - RULE-SET,ChinaMax_Domain,DIRECT
  - RULE-SET,ChinaMax_IP,DIRECT
  - RULE-SET,CloudGlobal,PROXY
  - RULE-SET,CloudGlobal_IP,PROXY
  - RULE-SET,Global,PROXY
  - RULE-SET,Global_Domain,PROXY
  - RULE-SET,Lan,DIRECT
  - GEOIP,LAN,DIRECT
  - GEOIP,CN,DIRECT
  - MATCH,PROXY
