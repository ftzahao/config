name: 自用规则
category: 规则集
desc: 自用规则
mode: rule
icon: https://raw.githubusercontent.com/ftzahao/config/main/assets/avatar.png
dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://dns.cloudflare.com/dns-query
    - https://dns.google/dns-query
  nameserver-policy:
    "geosite:cn,private,apple":
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "localhost.ptlogin2.qq.com"
    - "+.msftconnecttest.com"
    - "time.*.com"
    - "ntp.*.com"

rule-providers:
  FtzahaoDirect:
    url: https://raw.githubusercontent.com/ftzahao/config/main/stash/Direct.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Apple:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Apple/Apple.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Apple_Domain:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Apple/Apple_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  Alibaba:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Alibaba/Alibaba.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Alibaba_Domain:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Alibaba/Alibaba_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  CloudCN:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Cloud/CloudCN/CloudCN.yaml
    behavior: classical
    format: yaml
    interval: 86400
  ChinaMax:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/ChinaMax/ChinaMax.yaml
    behavior: classical
    format: yaml
    interval: 86400
  ChinaMax_Domain:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/ChinaMax/ChinaMax_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  ChinaMax_IP:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/ChinaMax/ChinaMax_IP.yaml
    behavior: ipcidr
    format: yaml
    interval: 86400
  Lan:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Lan/Lan.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Telegram:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Telegram/Telegram.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Youtube:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/YouTube/YouTube.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Netflix:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Netflix/Netflix.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Netflix_IP:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Netflix/Netflix_IP.yaml
    behavior: ipcidr
    format: yaml
    interval: 86400
  Disney:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Disney/Disney.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Spotify:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Spotify/Spotify.yaml
    behavior: classical
    format: yaml
    interval: 86400
  x:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Twitter/Twitter.yaml
    behavior: classical
    format: yaml
    interval: 86400
  TikTok:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/TikTok/TikTok.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Steam:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Steam/Steam.yaml
    behavior: classical
    format: yaml
    interval: 86400
  OpenAI:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/OpenAI/OpenAI.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Anthropic:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Anthropic/Anthropic.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Claude:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Claude/Claude.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Instagram:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Instagram/Instagram.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Threads:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Threads/Threads.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Whatsapp:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Whatsapp/Whatsapp.yaml
    behavior: classical
    format: yaml
    interval: 86400

rules: #!replace
  - RULE-SET,FtzahaoDirect,DIRECT
  - RULE-SET,Apple,DIRECT
  - RULE-SET,Apple_Domain,DIRECT
  - RULE-SET,Alibaba,DIRECT
  - RULE-SET,Alibaba_Domain,DIRECT
  - RULE-SET,CloudCN,DIRECT
  - RULE-SET,ChinaMax,DIRECT
  - RULE-SET,ChinaMax_Domain,DIRECT
  - RULE-SET,ChinaMax_IP,DIRECT
  - RULE-SET,Telegram,Telegram
  - RULE-SET,Youtube,Youtube
  - RULE-SET,Netflix,Netflix
  - RULE-SET,Netflix_IP,Netflix
  - RULE-SET,Disney,Disney
  - RULE-SET,Spotify,Spotify
  - RULE-SET,x,x
  - RULE-SET,TikTok,TikTok
  - RULE-SET,Steam,Steam
  - RULE-SET,OpenAI,OpenAI
  - RULE-SET,Anthropic,Claude
  - RULE-SET,Claude,Claude
  - RULE-SET,Instagram,Instagram
  - RULE-SET,Threads,Threads
  - RULE-SET,Whatsapp,Whatsapp
  - RULE-SET,Lan,DIRECT
  - GEOIP,LAN,DIRECT
  - MATCH,默认

