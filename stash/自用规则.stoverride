name: 自用规则
category: 规则集
desc: 自用规则
mode: rule
icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/avatar.png
version: "1.0.0"
dns:
  default-nameserver:
    - 119.29.29.29
    - 223.5.5.5
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fake-ip-filter:
    - "*"
    - "+.lan"
    - "+.local"

rule-providers:
  FtzahaoDirect:
    url: https://cdn.jsdelivr.net/gh/ftzahao/config@main/stash/Direct.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Apple:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Apple/Apple.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Apple_Domain.yaml:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Apple/Apple_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  Alibaba.yaml:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Alibaba/Alibaba.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Alibaba_Domain.yaml:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Alibaba/Alibaba_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  CloudCN:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Cloud/CloudCN/CloudCN.yaml
    behavior: classical
    format: yaml
    interval: 86400
  ChinaMax:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/ChinaMax/ChinaMax.yaml
    behavior: classical
    format: yaml
    interval: 86400
  ChinaMax_Domain:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/ChinaMax/ChinaMax_Domain.yaml
    behavior: domain
    format: yaml
    interval: 86400
  ChinaMax_IP:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/ChinaMax/ChinaMax_IP.yaml
    behavior: ipcidr
    format: yaml
    interval: 86400
  Lan:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Lan/Lan.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Telegram:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Telegram/Telegram.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Youtube:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/YouTube/YouTube.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Netflix:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Netflix/Netflix.yaml
    behavior: classical
    format: yaml
    interval: 86400
  Netflix_IP:
    url: https://cdn.jsdelivr.net/gh/blackmatrix7/ios_rule_script@master/rule/Clash/Netflix/Netflix_IP.yaml
    behavior: ipcidr
    format: yaml
    interval: 86400

rules: #!replace
  - RULE-SET,FtzahaoDirect,DIRECT
  - RULE-SET,Apple,DIRECT
  - RULE-SET,Apple_Domain,DIRECT
  - RULE-SET,Alibaba,DIRECT
  - RULE-SET,Alibaba_Domain,DIRECT
  - RULE-SET,CloudCN,DIRECT
  - RULE-SET,ChinaMax,DIRECT
  - RULE-SET,ChinaMax_Domain,DIRECT
  - RULE-SET,ChinaMax_IP,DIRECT
  - RULE-SET,Telegram,Telegram
  - RULE-SET,Youtube,Youtube
  - RULE-SET,Netflix,Netflix
  - RULE-SET,Netflix_IP,Netflix
  - RULE-SET,Lan,DIRECT
  - GEOIP,LAN,DIRECT
  - MATCH,默认

proxy-groups: #!replace
  - name: 默认
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/StreamlineStickiesColorGlobe1Duo.png
    type: select
    proxies:
      - 自动选择
      - 手动选择
      - 美国
      - 日本
      - 新加坡
      - 英国
      - 台湾
      - 香港
      - 港澳台
      - 韩国
      - 马来西亚
  - name: Telegram
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/LogosTelegram.png
    type: select
    proxies:
      - 自动选择
      - 手动选择
      - 美国
      - 日本
      - 新加坡
      - 英国
      - 台湾
      - 香港
      - 港澳台
      - 韩国
      - 马来西亚
  - name: Youtube
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/SelfhstYoutube.png
    type: select
    proxies:
      - 自动选择
      - 手动选择
      - 美国
      - 日本
      - 新加坡
      - 英国
      - 台湾
      - 香港
      - 港澳台
      - 韩国
      - 马来西亚
  - name: Netflix
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/SelfhstNetflix.png
    type: select
    proxies:
      - 自动选择
      - 手动选择
      - 美国
      - 日本
      - 新加坡
      - 英国
      - 台湾
      - 香港
      - 港澳台
      - 韩国
      - 马来西亚
  - name: 美国
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/CircleFlagsUs.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: 美(?=国|利坚|联邦)|🇺🇲|US|USA|United States|America|america|美国|凤凰城|洛杉矶|西雅图|芝加哥|纽约|沪美
  - name: 日本
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/CircleFlagsJp.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: (?:日本|🇯🇵|东京|JP(?:\s*[^A-Za-z0-9]|$)|Japan|JAPAN|japan|JPN|日(?:本|系|产))(?!\s*[利亚亚])
  - name: 新加坡
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/CircleFlagsSg.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: 新加坡|坡|狮城|🇸🇬|SG|(?i)Singapore
  - name: 英国
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/CircleFlagsUk.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: 英(?=国)|🇬🇧|UK| United Kingdom
  - name: 台湾
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/CircleFlagsTw.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: (?i)(台|TW|Tai)
  - name: 香港
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/CircleFlagsHk.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: (?i)(港|HK|Hong)
  - name: 港澳台
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/CircleFlagsCn.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: (?i)(^|\s|\-|\[|\(|\|)(HK|TW|MO|香港|台湾|澳门|台北|台中|新北|彰化|Macau|Hong Kong|Taiwan|HKTW|港台|🇭🇰|🇹🇼|🇲🇴)(\s|\-|$|\]|\)|\|)
  - name: 韩国
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/CircleFlagsKr.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: 韩国|韓國|韩|韓|KR|KOR|Korea|South Korea|首尔|首爾|Seoul|서울|한국|🇰🇷
  - name: 马来西亚
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/CircleFlagsMy.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: (?i)(马来西亚|馬來西亞|马来(?:西亚)?|馬來(?:西亞)?|Malaysia|Kuala\s*Lumpur|吉隆坡|🇲🇾)
  - name: 自动选择
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/StreamlineStickiesColorCompass1Duo.png
    type: url-test
    include-all: true
    interval: 120
    tolerance: 50
    lazy: true
    filter: (?i)^(?!.*(剩余|官网|星云|有效期|剩余|到期|流量|订阅|网址|客服|邮箱|群组|机场|TG|Telegram)).*$
  - name: 手动选择
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/StreamlineStickiesColorCursorDuo.png
    type: select
    include-all: true
    filter: (?i)^(?!.*(剩余|官网|星云|有效期|剩余|到期|流量|订阅|网址|客服|邮箱|群组|机场|TG|Telegram)).*$
  - name: 其他信息
    icon: https://cdn.jsdelivr.net/gh/ftzahao/config@main/assets/StreamlineStickiesColorOnlineInformationDuo.png
    type: select
    include-all: true
    filter: 剩余|官网|星云|有效期|剩余|到期|流量|订阅|网址|客服|邮箱|群组|机场|TG|Telegram
