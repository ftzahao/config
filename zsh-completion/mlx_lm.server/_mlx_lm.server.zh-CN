#compdef mlx_lm.server
# @generated by usage-cli from ./mlx_lm.server/zh-CN.usage.kdl
local curcontext="$curcontext"

_mlx_lm_server() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.server." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_server.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX HTTP 服务器"
bin mlx_lm.server
version "0.31.3"
about "MLX HTTP 服务器。"
flag "-h --help" help=显示此帮助信息并退出
flag --model help="MLX 模型权重、分词器和配置的路径" {
    arg <MODEL>
}
flag --adapter-path help=已训练适配器权重和配置的可选路径。 {
    arg <ADAPTER_PATH>
}
flag --host help="HTTP 服务器的主机（默认：127.0.0.1）" default="127.0.0.1" {
    arg <HOST>
}
flag --port help="HTTP 服务器的端口（默认：8080）" default="8080" {
    arg <PORT>
}
flag --allowed-origins help=允许的来源（默认：*） default=* {
    arg <ALLOWED_ORIGINS>
}
flag --draft-model help=用于投机解码的模型。 {
    arg <DRAFT_MODEL>
}
flag --num-draft-tokens help="使用投机解码时要预生成的 token 数量。" default="3" {
    arg <NUM_DRAFT_TOKENS>
}
flag --trust-remote-code help=允许信任分词器的远程代码
flag --log-level help=设置日志级别（默认：INFO） default=INFO {
    arg <LOG_LEVEL> {
        choices DEBUG INFO WARNING ERROR CRITICAL
    }
}
flag --chat-template help=为分词器指定聊天模板 {
    arg <CHAT_TEMPLATE>
}
flag --use-default-chat-template help=使用默认聊天模板
flag --temp help=默认采样温度（默认：0.0） default="0.0" {
    arg <TEMP>
}
flag --top-p help="默认核采样 top-p（默认：1.0）" default="1.0" {
    arg <TOP_P>
}
flag --top-k help="默认 top-k 采样（默认：0，禁用 top-k）" default="0" {
    arg <TOP_K>
}
flag --min-p help="默认 min-p 采样（默认：0.0，禁用 min-p）" default="0.0" {
    arg <MIN_P>
}
flag --max-tokens help="默认生成的最大 token 数（默认：512）" default="512" {
    arg <MAX_TOKENS>
}
flag --chat-template-args help="分词器 apply_chat_template 的参数 JSON 字符串，例如 '{\"enable_thinking\":false}'" default="{}" {
    arg <CHAT_TEMPLATE_ARGS>
}
flag --decode-concurrency help=当请求可批处理时，并行解码的请求数量 default="32" {
    arg <DECODE_CONCURRENCY>
}
flag --prompt-concurrency help=当请求可批处理时，并行处理的提示词数量 default="8" {
    arg <PROMPT_CONCURRENCY>
}
flag --prefill-step-size help=预填充处理的步长（默认：2048） default="2048" {
    arg <PREFILL_STEP_SIZE>
}
flag --prompt-cache-size help="提示词缓存中可保存的不同 KV 缓存的最大数量" default="10" {
    arg <PROMPT_CACHE_SIZE>
}
flag --prompt-cache-bytes help="KV 缓存的最大字节数" {
    arg <PROMPT_CACHE_BYTES>
}
flag --pipeline help=使用流水线而非张量并行
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_server" ]; then
    _mlx_lm_server "$@"
else
    compdef _mlx_lm_server mlx_lm.server
fi

