#compdef mlx_lm.server
# @generated by usage-cli from mlx_lm.server/usage.kdl
local curcontext="$curcontext"

_mlx_lm_server() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.server." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_server.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX Http Server"
bin mlx_lm.server
version "0.31.3"
about "MLX Http Server."
flag "-h --help" help="show this help message and exit"
flag --model help="The path to the MLX model weights, tokenizer, and config" {
    arg <MODEL>
}
flag --adapter-path help="Optional path for the trained adapter weights and config." {
    arg <ADAPTER_PATH>
}
flag --host help="Host for the HTTP server (default: 127.0.0.1)" default="127.0.0.1" {
    arg <HOST>
}
flag --port help="Port for the HTTP server (default: 8080)" default="8080" {
    arg <PORT>
}
flag --allowed-origins help="Allowed origins (default: *)" default=* {
    arg <ALLOWED_ORIGINS>
}
flag --draft-model help="A model to be used for speculative decoding." {
    arg <DRAFT_MODEL>
}
flag --num-draft-tokens help="Number of tokens to draft when using speculative decoding." default="3" {
    arg <NUM_DRAFT_TOKENS>
}
flag --trust-remote-code help="Enable trusting remote code for tokenizer"
flag --log-level help="Set the logging level (default: INFO)" default=INFO {
    arg <LOG_LEVEL> {
        choices DEBUG INFO WARNING ERROR CRITICAL
    }
}
flag --chat-template help="Specify a chat template for the tokenizer" {
    arg <CHAT_TEMPLATE>
}
flag --use-default-chat-template help="Use the default chat template"
flag --temp help="Default sampling temperature (default: 0.0)" default="0.0" {
    arg <TEMP>
}
flag --top-p help="Default nucleus sampling top-p (default: 1.0)" default="1.0" {
    arg <TOP_P>
}
flag --top-k help="Default top-k sampling (default: 0, disables top-k)" default="0" {
    arg <TOP_K>
}
flag --min-p help="Default min-p sampling (default: 0.0, disables min-p)" default="0.0" {
    arg <MIN_P>
}
flag --max-tokens help="Default maximum number of tokens to generate (default: 512)" default="512" {
    arg <MAX_TOKENS>
}
flag --chat-template-args help="A JSON formatted string of arguments for the tokenizer's apply_chat_template, e.g. '{\"enable_thinking\":false}'" default="{}" {
    arg <CHAT_TEMPLATE_ARGS>
}
flag --decode-concurrency help="When a request is batchable then decode that many requests in parallel" default="32" {
    arg <DECODE_CONCURRENCY>
}
flag --prompt-concurrency help="When a request is batchable then process that many prompts in parallel" default="8" {
    arg <PROMPT_CONCURRENCY>
}
flag --prefill-step-size help="Step size for prefill processing (default: 2048)" default="2048" {
    arg <PREFILL_STEP_SIZE>
}
flag --prompt-cache-size help="Maximum number of distinct KV caches to hold in the prompt cache" default="10" {
    arg <PROMPT_CACHE_SIZE>
}
flag --prompt-cache-bytes help="Maximum size in bytes of the KV caches" {
    arg <PROMPT_CACHE_BYTES>
}
flag --pipeline help="Use pipelining instead of tensor parallelism"
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_server" ]; then
    _mlx_lm_server "$@"
else
    compdef _mlx_lm_server mlx_lm.server
fi

# vim: noet ci pi sts=0 sw=4 ts=4
