flag --tensor-split help="各 GPU 卸载比例，逗号分隔，如 3,1" {
    arg <N0_N1_N2>
}
flag --main-gpu help="用于模型的 GPU（默认：0）" {
    arg <INDEX>
}
flag --fit help=是否自动调整参数以适应显存（默认：on） {
    arg <ON_OFF>
}
flag --fit-ctx help="可由 --fit 设置的最小上下文大小（默认：4096）" {
    arg <N>
}
flag --lora help="LoRA 适配器路径（逗号分隔可加载多个）" {
    arg <FNAME>
}
flag --lora-scaled help="带缩放系数的 LoRA 适配器路径（格式：FNAME:SCALE,...）" {
    arg <FNAME_SCALE>
}
flag --control-vector help=添加控制向量（逗号分隔可添加多个） {
    arg <FNAME>
}
flag --control-vector-layer-range help=应用控制向量的层范围（含首尾） {
    arg <START>
