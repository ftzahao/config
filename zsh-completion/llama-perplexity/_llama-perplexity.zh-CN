flag --dynatemp-exp help=动态温度指数（默认：1.00） {
    arg <N>
}
flag --mirostat help="使用 Mirostat 采样（默认：0，禁用）" {
    arg <N>
}
flag --mirostat-lr help="Mirostat 学习率（默认：0.10）" {
    arg <N>
}
flag --mirostat-ent help="Mirostat 目标熵（默认：5.00）" {
    arg <N>
}
flag "-l --logit-bias" help="modifies the likelihood of token appearing in the completion, i.e. `--logit-bias 15043+1` to increase likelihood of token ' Hello', or `--logit-bias 15043-1` to decrease likelihood of token ' Hello'" {
    arg <TOKEN_ID_BIAS>
}
flag --grammar help="用于约束生成的 BNF 风格语法" {
    arg <GRAMMAR>
}
flag --grammar-file help=语法文件路径 {
    arg <FNAME>
}
flag "-j --json-schema" help="用于约束生成的 JSON Schema" {
    arg <SCHEMA>
}
flag --json-schema-file help="包含 JSON Schema 的文件" {
    arg <FILE>
}
flag --backend-sampling help=启用后端采样（实验性，默认：禁用）
flag "-p --prompt" help="起始生成的提示词；系统消息请用 -sys" {
    arg <PROMPT>
}
flag "-f --file" help=包含提示词的文件（默认：无） {
    arg <FNAME>
}
flag --binary-file help=包含提示词的二进制文件（默认：无） {
    arg <FNAME>
}
flag "--warmup --no-warmup" help=是否用空运行进行预热（默认：启用）
flag --chunks help=处理的最大块数（默认：-1，全部） {
    arg <N>
}
flag --hellaswag help="计算 HellaSwag 分数"
flag --hellaswag-tasks help="计算 HellaSwag 分数的任务数（默认：400）" {
