flag --device help="用于卸载的设备列表，逗号分隔（none = 不卸载）" {
    arg <DEV1_DEV2>
}
flag "--gpu-layers --n-gpu-layers" help="存储在显存中的最大层数，精确数字、'auto' 或 'all'（默认：auto）" {
    arg <N>
