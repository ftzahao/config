flag --dry-penalty-last-n help="最近 n 个 token 的 DRY 惩罚（默认：64，禁用）" {
    arg <N>
}
flag --dry-sequence-breaker help="添加 DRY 采样的序列中断器" {
    arg <STRING>
}
flag --adaptive-target help="adaptive-p: select tokens near this probability (valid range 0.0 to 1.0; negative = disabled) (default: -1.00)" {
    arg <N>
}
flag --adaptive-decay help="adaptive-p: decay rate for target adaptation over time. lower values are more reactive, higher values are more stable. (valid range 0.0 to 0.99) (default: 0.90)" {
    arg <N>
}
flag --dynatemp-range help=动态温度范围（默认：0.00，禁用） {
    arg <N>
