flag --samplers help=按顺序使用的采样器，用分号分隔 {
    arg <SAMPLERS>
}
flag "-s --seed" help="随机数种子（默认：-1，-1 为随机）" {
    arg <SEED>
}
flag --ignore-eos help="忽略流结束 token 并继续生成"
flag "--temp --temperature" help=温度（默认：0.80） {
    arg <N>
}
flag --top-k help="top-k 采样（默认：40，0 = 禁用）" {
    arg <N>
