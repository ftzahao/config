#compdef llama-perplexity
# @generated by usage-cli from llama-perplexity/zh-CN.usage.kdl
local curcontext="$curcontext"

_llama_perplexity() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in llama-perplexity." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_llama_perplexity.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "LLaMA Perplexity (中文)"
bin llama-perplexity
version "0.4.0-dev"
about 模型困惑度评估工具
flag "-h --help --usage" help=打印用法并退出
flag --version help=显示版本和构建信息
flag --cache-list help=列出缓存中的模型
flag --completion-bash help="输出可 source 的 bash 补全脚本"
flag "-t --threads" help="生成时使用的 CPU 线程数（默认：-1）" {
    arg <N>
}
flag "-C --cpu-mask" help="CPU 亲和性掩码：任意长度十六进制。与 cpu-range 互补（默认：\"\")" {
    arg <M>
}
flag --cpu-range help="CPU 亲和性范围。与 --cpu-mask 互补" {
    arg <LO_HI>
}
flag --cpu-strict help="使用严格的 CPU 放置（默认：0）" {
    arg <N>
}
flag --prio help="设置进程/线程优先级：low(-1), normal(0), medium(1), high(2), realtime(3)（默认：0）" {
    arg <N>
}
flag --poll help="使用轮询级别等待工作（0 - 不轮询，默认：50）" {
    arg <0_100>
}
flag --cpu-mask-batch help="批处理 CPU 亲和性掩码（默认：与 --cpu-mask 相同）" {
    arg <M>
}
flag --cpu-strict-batch help="使用严格的 CPU 放置（默认：与 --cpu-strict 相同）" {
    arg <N>
}
flag --prio-batch help="设置进程/线程优先级：0-normal, 1-medium, 2-high, 3-realtime（默认：0）" {
    arg <N>
}
flag --poll-batch help="使用轮询等待工作（默认：与 --poll 相同）" {
    arg <N>
}
flag "-c --ctx-size" help="提示词上下文大小（默认：512，0 = 从模型加载）" {
    arg <N>
}
flag "-n --predict --n-predict" help="预测的 token 数量（默认：-1，-1 = 无限）" {
    arg <N>
}
flag "-b --batch-size" help=逻辑最大批处理大小（默认：2048） {
    arg <N>
}
flag --ubatch-size help=物理最大批处理大小（默认：512） {
    arg <N>
}
flag --keep help="从初始提示词中保留的 token 数（默认：0，-1 = 全部）" {
    arg <N>
}
flag "--perf --no-perf" help="whether to enable internal libllama performance timings (default: false)"
flag "-e --escape --no-escape" help="whether to process escapes sequences (\\n, \\r, \\t, \\', \\\", \\\\) (default: false)"
flag --parallel help=并行解码的序列数（默认：1） {
    arg <N>
}
flag --override-tensor help=覆盖张量缓冲区类型 {
    arg <TENSOR>
}
flag --cpu-moe help="将所有 MoE 权重保留在 CPU 中"
flag --n-cpu-moe help="将前 N 层的 MoE 权重保留在 CPU 中" {
    arg <N>
