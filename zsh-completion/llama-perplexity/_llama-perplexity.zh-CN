flag --ppl-stride help=困惑度计算步幅（默认：0） {
    arg <N>
}
flag --ppl-output-type help=困惑度计算输出类型（默认：0） {
    arg <N>
}
flag --log-disable help=禁用日志
flag --log-file help=日志输出到文件 {
    arg <FNAME>
}
flag "--log-jsonl --no-log-jsonl" help="以 JSONL 格式记录日志（默认：禁用）"
flag --log-colors help=设置彩色日志（默认：auto） {
    arg <ON_OFF_AUTO>
}
flag "-v --verbose --log-verbose" help=设置最大详细级别（用于调试）
flag --offline help=离线模式：强制使用缓存，禁止网络访问
flag "--verbosity --log-verbosity" help="详细级别阈值（默认：3，0=通用输出, 1=错误, 2=警告, 3=信息, 4=跟踪, 5=调试）" {
    arg <N>
}
flag "--log-prefix --no-log-prefix" help=在日志消息中启用前缀
flag "--log-timestamps --no-log-timestamps" help=在日志消息中启用时间戳
flag --threads-batch help="批处理和提示词处理的线程数（默认：与 --threads 相同）" {
    arg <N>
}
flag --cpu-range-batch help="批处理 CPU 亲和性范围。与 --cpu-mask-batch 互补" {
    arg <LO_HI>
}
flag --flash-attn help="set Flash Attention use ('on', 'off', or 'auto', default: 'auto')" {
    arg <ON_OFF_AUTO>
}
flag "--kv-offload --no-kv-offload" help="是否启用 KV 缓存卸载（默认：启用）"
flag "--direct-io --no-direct-io" help="DEPRECATED in favor of `--load-mode`: use DirectIO if available"
flag --numa help="attempt optimizations that help on some NUMA systems - distribute: spread execution evenly over all nodes - isolate: only spawn threads on CPUs on the node that execution started on - numactl: use the CPU map provided by numactl if run without this previously, it is recommended to drop the system page cache before using this see https://github.com/ggml-org/llama.cpp/issues/1437" {
    arg <TYPE>
}
flag --list-devices help=列出可用设备并退出
