}
flag --control-vector-scaled help=添加带缩放的控制向量（格式：FNAME:SCALE,...） {
    arg <FNAME_SCALE>
}
flag --docker-repo help="Docker Hub model repository. repo is optional, default to ai/. quant is optional, default to :latest. example: gemma3 (default: unused)" {
    arg <REPO_MODEL_QUANT>
}
flag --hf-repo help="Hugging Face model repository; quant is optional, case-insensitive, default to Q4_K_M, or falls back to the first file in the repo if Q4_K_M doesn't exist. mmproj is also downloaded automatically if available. to disable, add --no-mmproj example: ggml-org/GLM-4.7-Flash-GGUF:Q4_K_M (default: unused)" {
    arg <USER_MODEL_QUANT>
}
flag "--spec-draft-type-k --cache-type-k-draft" help="草稿模型 K 的 KV 缓存数据类型（默认：f16）" {
    arg <TYPE>
}
flag "--spec-draft-type-v --cache-type-v-draft" help="草稿模型 V 的 KV 缓存数据类型（默认：f16）" {
    arg <TYPE>
}
flag "--sampler-seq --sampling-seq" help=采样器的简化序列（默认：edskypmxt） {
    arg <SEQUENCE>
}
flag "--kv-unified --no-kv-unified" help="使用跨所有序列共享的统一 KV 缓冲区"
flag "--context-shift --no-context-shift" help="whether to use context shift on infinite text generation (default: disabled)"
flag "--save-all-logits --kl-divergence-base" help="设置 logits 文件" {
    arg <FNAME>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_llama_perplexity" ]; then
    _llama_perplexity "$@"
else
    compdef _llama_perplexity llama-perplexity
fi

