#compdef mlx_lm.chat
# @generated by usage-cli from mlx_lm.chat/usage.kdl
local curcontext="$curcontext"

_mlx_lm_chat() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.chat." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_chat.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX Chat"
bin mlx_lm.chat
version "0.31.3"
about "Chat with an LLM"
flag "-h --help" help="show this help message and exit"
flag --model help="The path to the local model directory or Hugging Face repo." {
    arg <MODEL>
}
flag --trust-remote-code help="Enable trusting remote code for tokenizer"
flag --adapter-path help="Optional path for the trained adapter weights and config." {
    arg <ADAPTER_PATH>
}
flag --temp help="Sampling temperature" {
    arg <TEMP>
}
flag --top-p help="Sampling top-p" {
    arg <TOP_P>
}
flag --xtc-probability help="Probability of XTC sampling to happen each next token" {
    arg <XTC_PROBABILITY>
}
flag --xtc-threshold help="Thresold the probs of each next token candidate to be sampled by XTC" {
    arg <XTC_THRESHOLD>
}
flag --seed help="PRNG seed" {
    arg <SEED>
}
flag --max-kv-size help="Set the maximum key-value cache size" {
    arg <MAX_KV_SIZE>
}
flag "-m --max-tokens" help="Maximum number of tokens to generate" {
    arg <MAX_TOKENS>
}
flag --system-prompt help="System prompt to be used for the chat template" {
    arg <SYSTEM_PROMPT>
}
flag --pipeline help="Use pipelining instead of tensor parallelism"
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_chat" ]; then
    _mlx_lm_chat "$@"
else
    compdef _mlx_lm_chat mlx_lm.chat
fi

# vim: noet ci pi sts=0 sw=4 ts=4
