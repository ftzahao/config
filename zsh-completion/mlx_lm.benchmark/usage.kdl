name "MLX Benchmark"
bin "mlx_lm.benchmark"
about "LLM benchmarking script"
version "0.31.3"

flag "-h --help" help="show this help message and exit"

flag "--model <MODEL>" help="The path to the local model directory or Hugging Face repo. If no model is specified, then mlx-community/Llama-3.2-3B-Instruct-4bit is used."

flag "--prompt-tokens -p <PROMPT_TOKENS>" help="Length of prompt"

flag "--generation-tokens -g <GENERATION_TOKENS>" help="Length of completion"

flag "--batch-size -b <BATCH_SIZE>" help="Batch size"

flag "--num-trials -n <NUM_TRIALS>" help="Number of timing trials"

flag "--pipeline" help="Use pipelining instead of tensor parallelism"

flag "--quantize-activations" help="Quantize activations using the same quantization config as the corresponding layer."

flag "--prefill-step-size <PREFILL_STEP_SIZE>" help="Step size for prefill processing (default: 2048)"

flag "--delay <DELAY>" help="Delay between each test in seconds (default: 0)" default="0"
