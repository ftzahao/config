name "LLaMA GGUF Split (中文)"
bin "llama-gguf-split"
about "GGUF 文件拆分/合并工具"
version "0.4.0-dev"

flag "-h --help" help="显示帮助信息并退出"
flag "--version" help="显示版本和构建信息"
flag "--split" help="将 GGUF 拆分为多个 GGUF（默认启用）"
flag "--merge" help="将多个 GGUF 合并为单个 GGUF"
flag "--split-max-tensors" help="每个分片的最大张量数（默认：128）"
flag "--dry-run" help="仅打印拆分计划并退出，不写入任何新文件"
flag "--delete-splits" help="合并期间删除分片文件以释放磁盘空间（⚠️ 不安全选项）"
flag "--split-max-size <N_M_G>" help=""
flag "--no-tensor-first-split <DO>" help=""
