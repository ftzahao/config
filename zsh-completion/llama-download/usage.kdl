name "LLaMA Download"
bin "llama download"
about "llama.cpp model download tool"
version "0.4.0-dev"

flag "-h --help --usage" help="print usage and exit"
flag "-m --model <FNAME>" help="model path to load"
flag "--model-url <MODEL_URL>" help="model download url (default: unused)"
flag "--docker-repo <REPO>" help="Docker Hub model repository (repo is optional, default to ai/)"
flag "--hf-repo <user/model:quant>" help="Hugging Face model repository; quant is optional, default to Q4_K_M"
flag "--hf-file <FILE>" help="Hugging Face model file (overrides quant in --hf-repo)"
flag "--hf-token <TOKEN>" help="Hugging Face access token (default: HF_TOKEN env var)"
flag "--mtp" help="also download the MTP head, if available"
flag "--dflash" help="also download the DFlash sidecar, if available"
flag "--eagle3" help="also download the Eagle3 sidecar, if available"
flag "--no-mmproj" help="disable automatic mmproj download"
flag "--offline" help="Offline mode: forces use of cache, prevents network access"
