#compdef mlx_lm.dynamic_quant
# @generated by usage-cli from ./mlx_lm.dynamic_quant/zh-CN.usage.kdl
local curcontext="$curcontext"

_mlx_lm_dynamic_quant() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.dynamic_quant." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_dynamic_quant.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX 动态量化"
bin mlx_lm.dynamic_quant
version "0.31.3"
about ""
flag "-h --help" help=显示此帮助信息并退出
flag "-m --model" {
    arg <MODEL>
}
flag --mlx-path help=保存模型的路径 {
    arg <MLX_PATH>
}
flag --seed {
    arg <SEED>
}
flag --sensitivities help="预先计算的敏感性 JSON 文件的路径。" {
    arg <SENSITIVITIES>
}
flag --target-bpw help=每个权重的目标比特数。 {
    arg <TARGET_BPW>
}
flag --low-bits {
    arg <LOW_BITS>
}
flag --low-group-size {
    arg <LOW_GROUP_SIZE>
}
flag --high-bits {
    arg <HIGH_BITS>
}
flag --high-group-size {
    arg <HIGH_GROUP_SIZE>
}
flag --report-ppl help=计算基础模型和量化模型的困惑度。
flag --grad-checkpoint help=使用梯度检查点以减少内存使用。
flag --accumulation-dtype help=用于累积敏感性梯度的数据类型 {
    arg <ACCUMULATION_DTYPE> {
        choices float32 bfloat16
    }
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_dynamic_quant" ]; then
    _mlx_lm_dynamic_quant "$@"
else
    compdef _mlx_lm_dynamic_quant mlx_lm.dynamic_quant
fi

