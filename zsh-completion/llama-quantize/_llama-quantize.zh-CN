#compdef llama-quantize
# @generated by usage-cli from llama-quantize/zh-CN.usage.kdl
local curcontext="$curcontext"

_llama_quantize() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in llama-quantize." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_llama_quantize.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "LLaMA Quantize (中文)"
bin llama-quantize
version "0.4.0-dev"
about "GGUF 模型量化工具"
flag --allow-requantize help=""
flag --leave-output-tensor help=""
flag --pure help=""
flag --imatrix help="" {
    arg <FILE_NAME>
}
flag --include-weights help="" {
    arg <TENSOR_NAME>
}
flag --exclude-weights help="" {
    arg <TENSOR_NAME>
}
flag --output-tensor-type help="" {
    arg <GGML_TYPE>
}
flag --token-embedding-type help="" {
    arg <GGML_TYPE>
}
flag --tensor-type help="" {
    arg <TENSOR_NAME_GGML_TYPE>
}
flag --tensor-type-file help="" {
    arg <TENSOR_TYPES_TXT>
}
flag --prune-layers help="" {
    arg <L0_L1_L2>
}
flag --keep-split help=""
flag --override-kv help="" {
    arg <KEY_TYPE_VALUE>
}
flag --dry-run help=""
flag --max-buffer-size help="" {
    arg <MIB>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_llama_quantize" ]; then
    _llama_quantize "$@"
else
    compdef _llama_quantize llama-quantize
fi

