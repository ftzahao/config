#compdef mlx_lm.perplexity
# @generated by usage-cli from mlx_lm.perplexity/zh-CN.usage.kdl
local curcontext="$curcontext"

_mlx_lm_perplexity() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.perplexity." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_perplexity.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX 困惑度"
bin mlx_lm.perplexity
version "0.31.3"
about "评估 MLX 模型的困惑度"
flag "-h --help" help=显示此帮助信息并退出
flag --model help="模型路径或 Hugging Face 模型 ID" {
    arg <MODEL>
}
flag --trust-remote-code help="从 Hugging Face 加载分词器/模型时允许信任远程代码。"
flag --batch-size help=评估的批大小 {
    arg <BATCH_SIZE>
}
flag --sequence-length help=评估的序列长度 {
    arg <SEQUENCE_LENGTH>
}
flag --num-samples help="使用的样本数量（-1 表示全部可用样本）" {
    arg <NUM_SAMPLES>
}
flag --data-path help="兼容 mlx-lm 数据集格式的 Hugging Face 数据集。" {
    arg <DATA_PATH>
}
flag --seed help=数据采样的随机种子 {
    arg <SEED>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_perplexity" ]; then
    _mlx_lm_perplexity "$@"
else
    compdef _mlx_lm_perplexity mlx_lm.perplexity
fi

