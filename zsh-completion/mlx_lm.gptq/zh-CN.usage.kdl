name "MLX GPTQ 量化"
bin "mlx_lm.gptq"
version "0.31.3"

flag "-h --help" help="显示此帮助信息并退出"

flag "--model -m <MODEL>"

flag "--mlx-path <MLX_PATH>" help="保存模型的路径"

flag "--bits <BITS>" help="GPTQ 层的量化位数"

flag "--group-size <GROUP_SIZE>" help="GPTQ 层的量化组大小"

flag "--fallback-bits <FALLBACK_BITS>" help="非 GPTQ 层的量化位数"

flag "--fallback-group-size <FALLBACK_GROUP_SIZE>" help="非 GPTQ 层的量化组大小"

flag "--num-samples <NUM_SAMPLES>" help="校准数据集的样本数量，-1 表示全部。"

flag "--sequence-length <SEQUENCE_LENGTH>" help="校准数据的序列长度。"

flag "--seed <SEED>" help="随机种子"
