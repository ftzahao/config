#compdef mlx_lm.awq
# @generated by usage-cli from mlx_lm.awq/zh-CN.usage.kdl
local curcontext="$curcontext"

_mlx_lm_awq() {
  emulate -L zsh
  typeset -A opt_args
  local curcontext="$curcontext" cache_policy

  if ! type -p usage &> /dev/null; then
      echo >&2
      echo "Error: usage CLI not found. This is required for completions to work in mlx_lm.awq." >&2
      echo "See https://usage.jdx.dev for more information." >&2
      return 1
  fi

  local spec_dir="${XDG_CACHE_HOME:-$HOME/.cache}/usage"
  [[ -d "$spec_dir" ]] || mkdir -p -m 700 "$spec_dir"
  local spec_file="$spec_dir/usage__usage_spec_mlx_lm_awq.spec"
  cat >| "$spec_file" <<'__USAGE_EOF__'
name "MLX AWQ 量化"
bin mlx_lm.awq
version "0.31.3"
flag "-h --help" help=显示此帮助信息并退出
flag "-m --model" {
    arg <MODEL>
}
flag --mlx-path help=保存模型的路径 {
    arg <MLX_PATH>
}
flag --bits help=量化位数 {
    arg <BITS>
}
flag --group-size help=量化的组大小 {
    arg <GROUP_SIZE>
}
flag --embed-bits help=嵌入层的量化位数 {
    arg <EMBED_BITS>
}
flag --embed-group-size help=嵌入层的量化组大小 {
    arg <EMBED_GROUP_SIZE>
}
flag --num-samples help=校准样本数量 {
    arg <NUM_SAMPLES>
}
flag --sequence-length help=校准数据的序列长度 {
    arg <SEQUENCE_LENGTH>
}
flag --n-grid help=网格搜索数量 {
    arg <N_GRID>
}
flag --seed help=随机种子 {
    arg <SEED>
}
__USAGE_EOF__
  local -a values=() descs=() inserts=()
  local needs_menu=0 line
  while IFS= read -r line; do
    local -a parts=("${(@ps:\t:)line}")
    values+=("${parts[1]}")
    descs+=("${parts[2]}")
    inserts+=("${parts[3]}")
    [[ "${parts[3]}" == "'"* ]] && needs_menu=1
  done < <(command usage complete-word --shell zsh -f "$spec_file" --cword=$((CURRENT - 1)) -- "${(Q)words[@]}")
  (( needs_menu )) && compstate[insert]=menu
  if (( ${#inserts[@]} )); then
    local -a _usage_display=()
    local _usage_i _usage_max=0 _usage_v _usage_pad
    for _usage_v in "${values[@]}"; do
      (( ${#_usage_v} > _usage_max )) && _usage_max=${#_usage_v}
    done
    for ((_usage_i=1; _usage_i<=${#values[@]}; _usage_i++)); do
      if [[ -n "${descs[_usage_i]}" ]]; then
        _usage_pad=$(( _usage_max - ${#values[_usage_i]} ))
        _usage_display+=("${values[_usage_i]}${(l:_usage_pad:: :)}  -- ${descs[_usage_i]}")
      else
        _usage_display+=("${values[_usage_i]}")
      fi
    done
    compadd -l -d _usage_display -U -Q -S '' -a inserts
  fi
  return 0
}

if [ "$funcstack[1]" = "_mlx_lm_awq" ]; then
    _mlx_lm_awq "$@"
else
    compdef _mlx_lm_awq mlx_lm.awq
fi

