name "MLX 模型转换"
bin "mlx_lm.convert"
about "将 Hugging Face 模型转换为 MLX 格式"
version "0.31.3"

flag "-h --help" help="显示此帮助信息并退出"

flag "--hf-path --model <HF_PATH>" required help="模型路径。可以是本地路径或 Hugging Face Hub 模型标识符。"

flag "--mlx-path <MLX_PATH>" help="保存 MLX 模型的路径。"

flag "-q --quantize" help="生成量化模型。"

flag "--q-group-size <Q_GROUP_SIZE>" help="量化的组大小。"

flag "--q-bits <Q_BITS>" help="每个权重的量化位数。"

flag "--q-mode <Q_MODE>" help="量化模式。" {
    choices "affine" "mxfp4" "nvfp4" "mxfp8"
}

flag "--quant-predicate <QUANT_PREDICATE>" help="混合位宽量化策略。" {
    choices "mixed_2_6" "mixed_3_4" "mixed_3_6" "mixed_4_6"
}

flag "--dtype <DTYPE>" help="保存非量化参数的类型。默认取 config.json 的 `torch_dtype` 或当前模型权重类型。" {
    choices "float16" "bfloat16" "float32"
}

flag "--upload-repo <UPLOAD_REPO>" help="要上传模型到的 Hugging Face 仓库。"

flag "-d --dequantize" help="反量化一个已量化的模型。"

flag "--trust-remote-code" help="加载分词器时信任远程代码。"
